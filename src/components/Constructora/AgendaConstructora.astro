---
/** Agenda semanal de mantenimientos asignados para Constructora, con filtro por trabajador y alerta de cruces de horario. */
---
<section class="co-card" id="coAgendaRoot">
  <div class="co-card-head">
    <div class="co-card-titulo">
      <div class="co-card-ico co-card-ico--oro"><i class="bi bi-calendar3" aria-hidden="true"></i></div>
      <div>
        <h2>Agenda semanal de mantenimientos</h2>
        <small>Visualiza asignaciones por trabajador y detecta posibles cruces de horario.</small>
      </div>
    </div>
    <div class="co-ag-controles">
      <select id="coAgTrabFiltro" aria-label="Filtrar por trabajador">
        <option value="">Todos los trabajadores</option>
        <option value="__sin__">Sin trabajador asignado</option>
      </select>
      <div class="fn-acciones">
        <button class="fn-btn fn-btn--sec fn-btn--mini" id="coAgPrev" type="button" aria-label="Semana anterior"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
        <button class="fn-btn fn-btn--sec fn-btn--mini" id="coAgHoy" type="button">Hoy</button>
        <button class="fn-btn fn-btn--sec fn-btn--mini" id="coAgNext" type="button" aria-label="Semana siguiente"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
      </div>
    </div>
  </div>

  <div class="co-ag-meta">
    <div class="cal-leyenda" style="margin:0">
      <span><i class="cal-color" style="background:#c08a12"></i> Pendiente</span>
      <span><i class="cal-color" style="background:#1f5fa8"></i> En proceso</span>
      <span><i class="cal-color" style="background:#1b6e3c"></i> Finalizada</span>
      <span><i class="cal-color" style="background:#b3261e"></i> Cruce de horario</span>
    </div>
    <strong id="coAgTitulo" style="font-size:.92rem"></strong>
  </div>

  <div id="coAgAlertaCruce" class="co-ag-cruce" hidden>
    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
    <span id="coAgCruceTxt"></span>
  </div>

  <div class="co-ag-wrap">
    <div class="co-ag-grid" id="coAgGrid" role="grid" aria-label="Agenda semanal de constructora"></div>
  </div>
  <div id="coAgSinProg" class="co-ag-sinprog" hidden></div>
</section>

<style is:global>
  .co-ag-controles { display:flex; flex-wrap:wrap; gap:8px; align-items:center; }
  .co-ag-controles select {
    height:34px; border:1px solid var(--co-linea, #e2ddd0); border-radius:8px; padding:0 10px;
    font:inherit; font-size:.84rem; background:#fff; color:var(--co-ink, #253229);
  }
  .co-ag-meta { display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:10px; }
  .co-ag-cruce {
    display:flex; align-items:center; gap:8px; padding:10px 14px; border-radius:10px;
    background:#fbe9e7; color:#991b1b; border:1px solid #fecaca; font-size:.85rem; font-weight:600; margin-bottom:12px;
  }
  .co-ag-cruce[hidden] { display:none !important; }
  .co-ag-wrap { overflow-x:auto; }
  .co-ag-grid {
    display:grid; grid-template-columns:56px repeat(7,minmax(118px,1fr)); min-width:880px;
    border:1px solid var(--co-linea, #e2ddd0); border-radius:10px; overflow:hidden;
  }
  .co-ag-cab {
    background:#f8f6f0; padding:8px 6px; text-align:center; font-size:.8rem; font-weight:600;
    border-bottom:1px solid var(--co-linea, #e2ddd0); border-left:1px solid var(--co-linea, #e2ddd0);
  }
  .co-ag-cab:first-child { border-left:0; }
  .co-ag-cab--hoy { background:var(--co-ink, #253229); color:#f5f1e8; }
  .co-ag-hora { font-size:.72rem; color:var(--co-muted, #6b7268); text-align:right; padding:4px 6px; border-top:1px solid var(--co-linea, #e2ddd0); font-variant-numeric:tabular-nums; }
  .co-ag-celda { min-height:46px; border-top:1px solid var(--co-linea, #e2ddd0); border-left:1px solid var(--co-linea, #e2ddd0); padding:2px; display:grid; gap:2px; align-content:start; }
  .co-ag-ev {
    border:0; border-left:3px solid #c08a12; background:#fbf3df; border-radius:6px; padding:3px 6px;
    font-size:.73rem; line-height:1.25; color:#253229; text-align:left; width:100%;
  }
  .co-ag-ev--prog { border-left-color:#1f5fa8; background:#e3eefb; }
  .co-ag-ev--ok { border-left-color:#1b6e3c; background:#dcefe3; }
  .co-ag-ev--cruce { border-left-color:#b3261e; background:#fbe9e7; box-shadow:inset 0 0 0 1px #fca5a5; }
  .co-ag-ev b { display:block; }
  .co-ag-sinprog { margin-top:14px; padding-top:12px; border-top:1px solid var(--co-linea, #e2ddd0); display:grid; gap:8px; }
  .co-ag-sinprog[hidden] { display:none !important; }
  .co-ag-sinprog h3 { margin:0; font-size:.9rem; font-weight:700; color:var(--co-muted, #6b7268); }
  .co-ag-sinprog-lista { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:8px; }
</style>

<script>
  import { api, esc } from "../funciones/comun";

  const grid = document.getElementById("coAgGrid")!;
  const titulo = document.getElementById("coAgTitulo")!;
  const selTrab = document.getElementById("coAgTrabFiltro") as HTMLSelectElement;
  const alertaCruce = document.getElementById("coAgAlertaCruce")!;
  const cruceTxt = document.getElementById("coAgCruceTxt")!;

  const FINAL = [3, 6];
  let solicitudes: any[] = [];
  let lunes = inicioSemana(new Date());

  function inicioSemana(d: Date): Date {
    const r = new Date(d); r.setHours(0, 0, 0, 0);
    r.setDate(r.getDate() - ((r.getDay() + 6) % 7));
    return r;
  }
  function fechaDe(s: any): Date | null {
    const raw = s.fechaProgramada;
    if (!raw) return null;
    const d = new Date(raw);
    return Number.isNaN(d.getTime()) ? null : d;
  }
  function hora(d: Date): string {
    return d.toLocaleTimeString("es-CO", { hour: "2-digit", minute: "2-digit" });
  }

  function pintar() {
    const dias = Array.from({ length: 7 }, (_, i) => { const d = new Date(lunes); d.setDate(d.getDate() + i); return d; });
    const hoy = new Date(); hoy.setHours(0, 0, 0, 0);
    titulo.textContent = `${dias[0].toLocaleDateString("es-CO", { day: "numeric", month: "short" })} – ${dias[6].toLocaleDateString("es-CO", { day: "numeric", month: "short", year: "numeric" })}`;

    const filtro = selTrab.value;
    const filtradas = solicitudes.filter((s) => {
      if (!filtro) return true;
      const trabs: any[] = s.trabajadores ?? [];
      if (filtro === "__sin__") return trabs.length === 0;
      return trabs.some((t) => String(t.usuarioID) === filtro);
    });

    let horaMin = 7, horaMax = 19;
    for (const s of filtradas) {
      const f = fechaDe(s);
      if (f && dias.some((d) => f.toDateString() === d.toDateString())) {
        if (f.getHours() < horaMin) horaMin = f.getHours();
        if (f.getHours() > horaMax) horaMax = f.getHours();
      }
    }
    const horas = Array.from({ length: horaMax - horaMin + 1 }, (_, i) => i + horaMin);

    let totalCruces = 0;
    let html = `<div class="co-ag-cab"></div>` + dias.map((d) =>
      `<div class="co-ag-cab ${d.getTime() === hoy.getTime() ? "co-ag-cab--hoy" : ""}">${esc(d.toLocaleDateString("es-CO", { weekday: "short", day: "numeric" }))}</div>`
    ).join("");

    for (const h of horas) {
      html += `<div class="co-ag-hora">${String(h).padStart(2, "0")}:00</div>`;
      for (const d of dias) {
        const items = filtradas
          .map((s) => ({ s, f: fechaDe(s) }))
          .filter((x): x is { s: any; f: Date } =>
            x.f !== null && x.f.toDateString() === d.toDateString() && x.f.getHours() === h
          );

        // Detectar si algún trabajador activo tiene más de una cita en la misma celda
        const conteoTrab = new Map<number, number>();
        for (const { s } of items) {
          if (FINAL.includes(s.estadoReparacionID)) continue;
          for (const t of (s.trabajadores ?? [])) {
            conteoTrab.set(Number(t.usuarioID), (conteoTrab.get(Number(t.usuarioID)) ?? 0) + 1);
          }
        }
        const hayCruceCelda = [...conteoTrab.values()].some((c) => c > 1);
        if (hayCruceCelda) totalCruces++;

        html += `<div class="co-ag-celda" role="gridcell">` + items.map(({ s, f }) => {
          const fin = FINAL.includes(s.estadoReparacionID);
          const cruce = !fin && (s.trabajadores ?? []).some((t: any) => (conteoTrab.get(Number(t.usuarioID)) ?? 0) > 1);
          const cls = cruce ? "co-ag-ev--cruce" : fin ? "co-ag-ev--ok" : s.estadoReparacionID === 2 ? "co-ag-ev--prog" : "";
          const equipo = (s.trabajadores ?? []).length
            ? (s.trabajadores ?? []).map((t: any) => t.nombre).join(", ")
            : "Sin asignar";
          return `<div class="co-ag-ev ${cls}" title="${esc(s.servicio + " · " + equipo)}">
            <b>${esc(hora(f))} · ${esc(s.servicio)}</b>
            <span>${esc(equipo)}</span>
          </div>`;
        }).join("") + `</div>`;
      }
    }

    alertaCruce.hidden = totalCruces === 0;
    if (totalCruces > 0) {
      cruceTxt.textContent = `Se detectó cruce de horario en ${totalCruces} franja(s) de esta semana para un mismo trabajador.`;
    }
    grid.innerHTML = html;

    const sinProgCont = document.getElementById("coAgSinProg")!;
    const sinProg = filtradas.filter((s) => !fechaDe(s));
    sinProgCont.hidden = sinProg.length === 0;
    sinProgCont.innerHTML = sinProg.length
      ? `<h3>Sin programar (${sinProg.length})</h3><div class="co-ag-sinprog-lista">` + sinProg.map((s) => {
          const fin = FINAL.includes(s.estadoReparacionID);
          const cls = fin ? "co-ag-ev--ok" : s.estadoReparacionID === 2 ? "co-ag-ev--prog" : "";
          const equipo = (s.trabajadores ?? []).length
            ? (s.trabajadores ?? []).map((t: any) => t.nombre).join(", ")
            : "Sin asignar";
          return `<div class="co-ag-ev ${cls}"><b>${esc(s.servicio)}</b><span>${esc(equipo)} · ${esc(s.estado ?? "Pendiente")}</span></div>`;
        }).join("") + `</div>`
      : "";
  }

  async function cargar() {
    try {
      const [dMant, dTrab] = await Promise.all([
        api("/mantenimiento/constructora"),
        api("/organizacion/trabajadores").catch(() => ({ trabajadores: [] })),
      ]);
      solicitudes = dMant.solicitudes ?? [];
      const trabs = dTrab.trabajadores ?? [];
      selTrab.innerHTML = `<option value="">Todos los trabajadores</option><option value="__sin__">Sin trabajador asignado</option>` +
        trabs.map((t: any) => `<option value="${Number(t.usuarioID)}">${esc(t.nombre)} (${Number(t.tareasAbiertas ?? 0)} abiertas)</option>`).join("");
      pintar();
    } catch {
      pintar();
    }
  }

  selTrab.addEventListener("change", pintar);
  document.getElementById("coAgPrev")!.addEventListener("click", () => { lunes.setDate(lunes.getDate() - 7); pintar(); });
  document.getElementById("coAgNext")!.addEventListener("click", () => { lunes.setDate(lunes.getDate() + 7); pintar(); });
  document.getElementById("coAgHoy")!.addEventListener("click", () => { lunes = inicioSemana(new Date()); pintar(); });
  window.addEventListener("skyinit:mantenimiento-actualizado", () => cargar());

  cargar();
</script>
