---
import "../funciones/funciones.css";
import "./constructora.css";
import ResumenPanel from "../funciones/ResumenPanel.astro";
import NotifModalPanel from "../funciones/NotifModalPanel.astro";
---

<div class="co-page" id="dashConstRoot">
  <!-- Hero -->
  <header class="co-hero">
    <div class="co-hero-info">
      <div class="co-hero-tags">
        <span class="co-hero-tag"><i class="bi bi-building" aria-hidden="true"></i> <span id="dcEmpresaTag">Constructora</span></span>
        <span class="co-hero-tag"><i class="bi bi-calendar-event" aria-hidden="true"></i> <span id="dcFechaTag"></span></span>
      </div>
      <h1 id="dcSaludo">Panel de constructora</h1>
      <p>Resumen de tus proyectos, propiedades, equipo de trabajo y avisos recientes.</p>
    </div>
    <div class="co-hero-acc">
      <a href="/constructora/proyectos" class="co-hero-btn"><i class="bi bi-buildings-fill" aria-hidden="true"></i> Ver proyectos</a>
      <a href="/constructora/propiedades" class="co-hero-btn co-hero-btn--sec"><i class="bi bi-house-fill" aria-hidden="true"></i> Propiedades</a>
      <NotifModalPanel />
    </div>
  </header>

  <div id="dash-error" class="dash-alert d-none"></div>
  <div id="dash-loading" class="dash-loading">Cargando resumen…</div>

  <!-- Estadísticas unificadas -->
  <section id="dash-content" class="co-stack d-none">
    <div class="co-kpis" aria-label="Indicadores de la constructora">
      <div class="co-kpi co-kpi--destacado">
        <div class="co-kpi-top">
          <span class="co-kpi-lbl">Propiedades</span>
          <span class="co-kpi-ico"><i class="bi bi-house-fill" aria-hidden="true"></i></span>
        </div>
        <strong id="kpi-propiedades" class="co-kpi-val">0</strong>
      </div>
      <div class="co-kpi">
        <div class="co-kpi-top">
          <span class="co-kpi-lbl">Proyectos</span>
          <span class="co-kpi-ico"><i class="bi bi-buildings-fill" aria-hidden="true"></i></span>
        </div>
        <strong id="kpi-proyectos" class="co-kpi-val">0</strong>
      </div>
      <div class="co-kpi co-kpi--ok">
        <div class="co-kpi-top">
          <span class="co-kpi-lbl">Avance promedio</span>
          <span class="co-kpi-ico"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></span>
        </div>
        <strong id="kpi-avance" class="co-kpi-val">0%</strong>
      </div>
      <div class="co-kpi" id="kpi-notifs-card">
        <div class="co-kpi-top">
          <span class="co-kpi-lbl">Sin leer</span>
          <span class="co-kpi-ico"><i class="bi bi-bell-fill" aria-hidden="true"></i></span>
        </div>
        <strong id="kpi-notifs" class="co-kpi-val">0</strong>
      </div>
    </div>

    <ResumenPanel />

    <!-- Distribución 2 columnas: Estados + Acciones rápidas | Últimas 5 notificaciones -->
    <div class="co-split">
      <div class="co-stack">
        <div class="dc-estados-grid">
          <article class="co-card">
            <div class="co-card-head">
              <div class="co-card-titulo">
                <div class="co-card-ico"><i class="bi bi-house-door-fill" aria-hidden="true"></i></div>
                <div>
                  <h2>Propiedades por estado</h2>
                  <small>Distribución actual de tu catálogo.</small>
                </div>
              </div>
            </div>
            <ul id="lista-prop-estado" class="stat-list"></ul>
          </article>

          <article class="co-card">
            <div class="co-card-head">
              <div class="co-card-titulo">
                <div class="co-card-ico co-card-ico--oro"><i class="bi bi-kanban-fill" aria-hidden="true"></i></div>
                <div>
                  <h2>Proyectos por estado</h2>
                  <small>Seguimiento de obras activas.</small>
                </div>
              </div>
            </div>
            <ul id="lista-proy-estado" class="stat-list"></ul>
          </article>
        </div>

        <article class="co-card">
          <div class="co-card-head">
            <div class="co-card-titulo">
              <div class="co-card-ico"><i class="bi bi-lightning-charge-fill" aria-hidden="true"></i></div>
              <div>
                <h2>Acciones rápidas</h2>
                <small>Accesos directos a la gestión diaria de tu constructora.</small>
              </div>
            </div>
          </div>
          <div class="co-acciones-grid">
            <a class="co-accion co-accion--destacada" href="/constructora/proyectos">
              <span class="co-accion-ico"><i class="bi bi-buildings-fill" aria-hidden="true"></i></span>
              <span class="co-accion-txt"><strong>Proyectos</strong><small>Obras y avances</small></span>
              <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
            <a class="co-accion" href="/constructora/propiedades">
              <span class="co-accion-ico"><i class="bi bi-house-fill" aria-hidden="true"></i></span>
              <span class="co-accion-txt"><strong>Propiedades</strong><small>Catálogo y precios</small></span>
              <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
            <a class="co-accion" href="/constructora/trabajadores">
              <span class="co-accion-ico"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
              <span class="co-accion-txt"><strong>Trabajadores</strong><small>Cuentas del equipo</small></span>
              <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
            <a class="co-accion" href="/constructora/mantenimiento">
              <span class="co-accion-ico"><i class="bi bi-wrench-adjustable" aria-hidden="true"></i></span>
              <span class="co-accion-txt"><strong>Mantenimiento</strong><small>Asignar solicitudes</small></span>
              <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
            <a class="co-accion" href="/notificaciones">
              <span class="co-accion-ico"><i class="bi bi-bell-fill" aria-hidden="true"></i></span>
              <span class="co-accion-txt"><strong>Notificaciones</strong><small>Historial completo</small></span>
              <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
            <a class="co-accion" href="/constructora/perfil">
              <span class="co-accion-ico"><i class="bi bi-person-fill" aria-hidden="true"></i></span>
              <span class="co-accion-txt"><strong>Perfil</strong><small>Logo y datos</small></span>
              <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
          </div>
        </article>
      </div>

      <article class="co-card">
        <div class="co-card-head">
          <div class="co-card-titulo">
            <div class="co-card-ico co-card-ico--oro"><i class="bi bi-bell-fill" aria-hidden="true"></i></div>
            <div>
              <h2>Últimas 5 notificaciones</h2>
              <small id="dcNotifSub">Cargando…</small>
            </div>
          </div>
          <a class="fn-btn fn-btn--sec fn-btn--mini" href="/notificaciones">Ver todas</a>
        </div>
        <ul class="co-notif-lista" id="dcNotifLista" aria-live="polite">
          <li class="fn-muted">Cargando notificaciones…</li>
        </ul>
      </article>
    </div>
  </section>
</div>

<style>
  .dc-estados-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .stat-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stat-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0;
    border-bottom: 1px solid #f0ece1;
    font-size: 0.92rem;
    color: #3d4a42;
  }
  .stat-list li:last-child {
    border-bottom: none;
  }
  .stat-list strong {
    color: #253229;
    font-variant-numeric: tabular-nums;
  }
  .dash-loading {
    color: #6b7268;
    padding: 0.5rem 0;
  }
  .dash-alert {
    background: #fef2f2;
    color: #991b1b;
    padding: 0.85rem 1.1rem;
    border-radius: 12px;
    border: 1px solid #fecaca;
  }
  .d-none {
    display: none !important;
  }
</style>

<script>
  import { api, esc, fechaHora, aviso } from "../funciones/comun";

  const fechaTag = document.getElementById("dcFechaTag");
  if (fechaTag) {
    const f = new Date().toLocaleDateString("es-CO", { weekday: "long", day: "numeric", month: "long" });
    fechaTag.textContent = f.charAt(0).toUpperCase() + f.slice(1);
  }

  const notifLista = document.getElementById("dcNotifLista")!;
  const notifSub = document.getElementById("dcNotifSub")!;
  const kpiNotifs = document.getElementById("kpi-notifs")!;
  const kpiNotifsCard = document.getElementById("kpi-notifs-card")!;

  async function cargarNotificaciones() {
    try {
      const d = await api("/notificaciones");
      const todas: any[] = d.notificaciones ?? [];
      const noLeidas = Number(d.noLeidas ?? 0);
      kpiNotifs.textContent = String(noLeidas);
      kpiNotifsCard.classList.toggle("co-kpi--alerta", noLeidas > 0);
      notifSub.textContent = noLeidas ? `${noLeidas} sin leer` : "Estás al día";

      const ultimas = todas.slice(0, 5);
      if (!ultimas.length) {
        notifLista.innerHTML = `<li class="fn-vacio" style="padding:20px 12px"><i class="bi bi-bell" aria-hidden="true"></i>No tienes notificaciones recientes.</li>`;
        return;
      }
      notifLista.innerHTML = ultimas.map((n) => `
        <li class="co-notif-item ${n.leida ? "" : "co-notif-item--nueva"}">
          <div class="co-notif-cuerpo">
            <strong>${esc(n.titulo)}${n.leida ? "" : ' <span class="fn-chip fn-chip--pend">Nueva</span>'}</strong>
            <p>${esc(n.mensaje)}</p>
            <small><i class="bi bi-clock" aria-hidden="true"></i> ${esc(fechaHora(n.fechaCreacion))}</small>
          </div>
          ${n.leida ? "" : `<button class="fn-btn fn-btn--sec fn-btn--mini" type="button" data-leer="${Number(n.notificacionID)}">Leída</button>`}
        </li>
      `).join("");
    } catch {
      notifSub.textContent = "Sin conexión";
      notifLista.innerHTML = `<li class="fn-muted">No se pudieron cargar las notificaciones.</li>`;
    }
  }

  notifLista.addEventListener("click", async (ev) => {
    const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-leer]");
    if (!btn) return;
    btn.disabled = true;
    try {
      await api(`/notificaciones/${btn.dataset.leer}/leida`, "PATCH");
      aviso("Notificación marcada como leída");
      cargarNotificaciones();
    } catch (e) {
      aviso((e as Error).message, "error");
      btn.disabled = false;
    }
  });

  async function cargarPerfilCabecera() {
    try {
      const res = await fetch("/api/panel/constructora/perfil", { credentials: "same-origin" });
      if (!res.ok) return;
      const json = await res.json();
      const c = json.data ?? json;
      if (c?.nombre) {
        const tag = document.getElementById("dcEmpresaTag");
        const saludo = document.getElementById("dcSaludo");
        if (tag) tag.textContent = c.ciudad ? `${c.nombre} · ${c.ciudad}` : c.nombre;
        if (saludo) saludo.textContent = `Hola, ${c.nombre}`;
      }
    } catch { /* opcional */ }
  }

  async function cargarDashboard() {
    const loading = document.getElementById("dash-loading");
    const content = document.getElementById("dash-content");
    const errorEl = document.getElementById("dash-error");

    try {
      const res = await fetch("/api/panel/constructora/dashboard", { credentials: "same-origin" });
      const json = await res.json();

      if (!res.ok || !json.success) {
        throw new Error(json.message || json.error || "No se pudo cargar el dashboard");
      }

      const d = json.data;
      document.getElementById("kpi-propiedades")!.textContent = String(d.totalPropiedades ?? 0);
      document.getElementById("kpi-proyectos")!.textContent = String(d.totalProyectos ?? 0);
      const avance = Number(d.avancePromedioProyectos ?? 0);
      document.getElementById("kpi-avance")!.textContent = `${avance.toFixed(1)}%`;

      const ulProp = document.getElementById("lista-prop-estado")!;
      ulProp.innerHTML = "";
      const props = d.propiedadesPorEstado ?? [];
      if (props.length === 0) {
        ulProp.innerHTML = "<li><span>Sin datos</span><strong>0</strong></li>";
      } else {
        for (const row of props) {
          const li = document.createElement("li");
          li.innerHTML = `<span>${esc(row.estado ?? "—")}</span><strong>${esc(row.total)}</strong>`;
          ulProp.appendChild(li);
        }
      }

      const ulProy = document.getElementById("lista-proy-estado")!;
      ulProy.innerHTML = "";
      const proys = d.proyectosPorEstado ?? [];
      if (proys.length === 0) {
        ulProy.innerHTML = "<li><span>Sin datos</span><strong>0</strong></li>";
      } else {
        for (const row of proys) {
          const li = document.createElement("li");
          li.innerHTML = `<span>${esc(row.estado ?? "—")}</span><strong>${esc(row.total)}</strong>`;
          ulProy.appendChild(li);
        }
      }

      loading?.classList.add("d-none");
      content?.classList.remove("d-none");
    } catch (err: any) {
      loading?.classList.add("d-none");
      errorEl!.textContent = err.message || "Error al cargar";
      errorEl!.classList.remove("d-none");
    }
  }

  document.addEventListener("avisos:actualizados", () => cargarNotificaciones());
  cargarPerfilCabecera();
  cargarDashboard();
  cargarNotificaciones();
</script>
