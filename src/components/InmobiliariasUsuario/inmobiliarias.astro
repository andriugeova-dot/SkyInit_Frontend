---
interface InmobiliariaItem {
    inmobiliariaID: number;
    nombre: string;
    logo?: string | null;
    descripcion?: string | null;
    contacto?: string | null;
    telefono?: string | null;
    correo?: string | null;
    ciudad?: string | null;
}

const { lista = [] } = Astro.props as { lista: InmobiliariaItem[] };

const ciudadesUnicas: string[] = Array.from(
    new Set(
        lista
            .map((i) => i.ciudad?.trim())
            .filter((c): c is string => Boolean(c)),
    ),
).sort((a, b) => a.localeCompare(b, "es"));
---

<section class="search-container" aria-label="Buscar inmobiliarias">
    <form class="search-box" id="formBuscarInmobiliarias">
        <input
            type="text"
            id="busquedaInmobiliaria"
            placeholder="Buscar inmobiliaria por nombre, ciudad o descripción..."
            aria-label="Buscar inmobiliaria"
        />
        <select id="filtroCiudadInmobiliaria" aria-label="Filtrar por ciudad">
            <option value="">-- Todas las ciudades --</option>
            {ciudadesUnicas.map((ciu) => <option value={ciu}>{ciu}</option>)}
        </select>
        <button type="submit">Buscar</button>
    </form>
</section>

<section class="resultados-section contenedor">
    <div class="directorio-toolbar">
        <div>
            <span class="directorio-eyebrow">Red inmobiliaria</span>
            <h2 class="directorio-titulo">Inmobiliarias aliadas</h2>
        </div>
        <span id="contadorInmobiliarias" class="directorio-contador">
            {lista.length} {lista.length === 1 ? "inmobiliaria" : "inmobiliarias"}
        </span>
    </div>

    <script
        id="inmobiliarias-data"
        type="application/json"
        set:html={JSON.stringify(lista).replace(/</g, "\\u003c")}
    ></script>

    <div id="inmobiliarias-grid" class="properties"></div>
    <nav
        id="paginacion-inmobiliarias"
        class="paginacion-constructoras"
        aria-label="Paginación de inmobiliarias"
    ></nav>
</section>

<!-- Modal detalle inmobiliaria -->
<div id="modal-inmobiliaria" class="modal-overlay" aria-hidden="true">
    <div class="modal-box modal-entidad" role="dialog" aria-modal="true" aria-labelledby="modal-inmob-titulo">
        <div class="modal-banner-verde">
            <button class="modal-cerrar" id="modal-inmob-cerrar" aria-label="Cerrar">&times;</button>
            <div class="modal-header">
                <div id="modal-inmob-logo-wrap" class="modal-logo-wrap"></div>
                <div class="modal-header-info">
                    <span class="modal-tipo-badge">Inmobiliaria verificada</span>
                    <h2 id="modal-inmob-titulo" class="modal-nombre"></h2>
                    <p id="modal-inmob-ciudad" class="modal-ciudad"></p>
                </div>
            </div>
        </div>

        <div class="modal-body">
            <div class="modal-info-bloque">
                <h3 class="modal-subtitulo"><i class="bi bi-info-circle-fill" aria-hidden="true"></i> Acerca de la inmobiliaria</h3>
                <p id="modal-inmob-descripcion" class="modal-descripcion"></p>
            </div>

            <div class="modal-info-bloque" id="modal-inmob-contacto-bloque">
                <h3 class="modal-subtitulo"><i class="bi bi-telephone-fill" aria-hidden="true"></i> Información de contacto</h3>
                <div class="modal-contacto" id="modal-inmob-contacto"></div>
            </div>

            <div class="modal-entidad-footer">
                <a id="modal-inmob-link" href="/inmobiliarias" class="btn-ver-perfil-inmob">
                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Ver perfil completo y servicios
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    const BACKEND_INMOB = "/backend";
    function esc(v: unknown): string {
        return String(v ?? "").replace(/[&<>"']/g, (c) =>
            (({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }) as Record<string, string>)[c],
        );
    }

    const ITEMS_POR_PAG_I = 12;
    let paginaI = 1;

    interface InmobiliariaJS {
        inmobiliariaID: number;
        nombre: string;
        logo: string | null;
        descripcion: string | null;
        contacto: string | null;
        telefono: string | null;
        correo: string | null;
        ciudad: string | null;
    }

    function logoUrlInmob(logo: string | null | undefined): string | null {
        if (!logo) return null;
        if (logo.startsWith("http") || logo.startsWith("data:")) return logo;
        if (logo.startsWith("/")) return `${BACKEND_INMOB}${logo}`;
        return `${BACKEND_INMOB}/uploads/inmobiliarias/${encodeURIComponent(logo)}`;
    }

    const todasInmobiliarias: InmobiliariaJS[] = JSON.parse(
        (document.getElementById("inmobiliarias-data") as HTMLScriptElement).textContent ?? "[]",
    );
    let inmobFiltradas: InmobiliariaJS[] = [...todasInmobiliarias];

    function renderCardInmob(item: InmobiliariaJS) {
        const src = logoUrlInmob(item.logo);
        const imgHtml = src
            ? `<img src="${esc(src)}" alt="${esc(item.nombre)}" loading="lazy" referrerpolicy="no-referrer" />`
            : `<div class="card-img-placeholder"><span>${esc((item.nombre || "IN").slice(0, 2).toUpperCase())}</span></div>`;

        const badgeCiudad = item.ciudad
            ? `<span class="badge-inmob-count">${esc(item.ciudad)}</span>`
            : `<span class="badge-inmob-count">Activa</span>`;

        return `
            <article class="property-card inmobiliaria-clickable" data-id="${esc(item.inmobiliariaID)}" tabindex="0" role="button" aria-label="Ver detalle de ${esc(item.nombre)}">
                <div class="property-image constructora-img">
                    ${imgHtml}
                    ${badgeCiudad}
                </div>
                <div class="property-info">
                    <h2 class="constructora-nombre">${esc(item.nombre)}</h2>
                    ${item.ciudad ? `<p class="location"><i class="bi bi-geo-alt-fill" aria-hidden="true" style="margin-right:4px"></i>${esc(item.ciudad)}</p>` : ""}
                    ${item.descripcion ? `<p class="description">${esc(item.descripcion)}</p>` : `<p class="description">Inmobiliaria verificada y activa dentro de la plataforma SkyInit.</p>`}
                    <span class="btn-ver-mas">Ver información →</span>
                </div>
            </article>`;
    }

    function renderGridInmob(items: InmobiliariaJS[]) {
        const grid = document.getElementById("inmobiliarias-grid")!;
        if (!items.length) {
            grid.innerHTML = `<p class="sin-resultados">No encontramos inmobiliarias que coincidan con tu búsqueda.</p>`;
            return;
        }
        grid.innerHTML = items.map(renderCardInmob).join("");

        grid.querySelectorAll<HTMLElement>(".inmobiliaria-clickable").forEach((el) => {
            const open = () => {
                const id = Number(el.dataset.id);
                const found = todasInmobiliarias.find((x) => x.inmobiliariaID === id);
                if (found) abrirModalInmob(found);
            };
            el.addEventListener("click", open);
            el.addEventListener("keydown", (e) => {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    open();
                }
            });
        });
    }

    function abrirModalInmob(item: InmobiliariaJS) {
        const overlay = document.getElementById("modal-inmobiliaria")!;
        const src = logoUrlInmob(item.logo);

        const logoWrap = document.getElementById("modal-inmob-logo-wrap")!;
        logoWrap.innerHTML = src
            ? `<img src="${esc(src)}" alt="${esc(item.nombre)}" class="modal-logo-img" referrerpolicy="no-referrer" />`
            : `<div class="modal-logo-placeholder">${esc((item.nombre || "IN").slice(0, 2).toUpperCase())}</div>`;

        document.getElementById("modal-inmob-titulo")!.textContent = item.nombre;
        const ciudadEl = document.getElementById("modal-inmob-ciudad")!;
        ciudadEl.innerHTML = item.ciudad
            ? `<i class="bi bi-geo-alt-fill" aria-hidden="true" style="margin-right:5px"></i>${esc(item.ciudad)}`
            : "";

        document.getElementById("modal-inmob-descripcion")!.textContent =
            item.descripcion?.trim() || "Inmobiliaria verificada en SkyInit con oferta de propiedades, proyectos y servicios.";

        const contactoEl = document.getElementById("modal-inmob-contacto")!;
        const contactoBloque = document.getElementById("modal-inmob-contacto-bloque")!;
        const chips: string[] = [];
        if (item.contacto)
            chips.push(`<span class="contacto-chip"><i class="bi bi-person-badge-fill" aria-hidden="true"></i> ${esc(item.contacto)}</span>`);
        if (item.telefono)
            chips.push(`<a href="tel:${esc(item.telefono)}" class="contacto-chip"><i class="bi bi-telephone-fill" aria-hidden="true"></i> ${esc(item.telefono)}</a>`);
        if (item.correo)
            chips.push(`<a href="mailto:${esc(item.correo)}" class="contacto-chip"><i class="bi bi-envelope-fill" aria-hidden="true"></i> ${esc(item.correo)}</a>`);
        if (item.ciudad)
            chips.push(`<span class="contacto-chip"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> ${esc(item.ciudad)}</span>`);

        contactoBloque.style.display = chips.length ? "" : "none";
        contactoEl.innerHTML = chips.join("");

        const linkEl = document.getElementById("modal-inmob-link") as HTMLAnchorElement;
        linkEl.href = `/inmobiliarias/${item.inmobiliariaID}`;

        overlay.setAttribute("aria-hidden", "false");
        overlay.classList.add("modal-visible");
        document.body.style.overflow = "hidden";
    }

    function cerrarModalInmob() {
        const overlay = document.getElementById("modal-inmobiliaria")!;
        overlay.classList.remove("modal-visible");
        overlay.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
    }

    document.getElementById("modal-inmob-cerrar")!.addEventListener("click", cerrarModalInmob);
    document.getElementById("modal-inmobiliaria")!.addEventListener("click", (e) => {
        if (e.target === e.currentTarget) cerrarModalInmob();
    });
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") cerrarModalInmob();
    });

    function renderPaginacionInmob(total: number) {
        const nav = document.getElementById("paginacion-inmobiliarias")!;
        const totalPaginas = Math.ceil(total / ITEMS_POR_PAG_I);
        if (totalPaginas <= 1) {
            nav.innerHTML = "";
            return;
        }
        let html = `<div class="paginas">`;
        html += `<button class="pag-btn pag-prev" ${paginaI === 1 ? "disabled" : ""}>&#8592; Anterior</button>`;
        for (let n = 1; n <= totalPaginas; n++) {
            html += `<button class="pag-btn pag-num ${n === paginaI ? "pag-activa" : ""}" data-page="${n}">${n}</button>`;
        }
        html += `<button class="pag-btn pag-next" ${paginaI === totalPaginas ? "disabled" : ""}>Siguiente &#8594;</button>`;
        html += `<span class="pag-info">Página ${paginaI} de ${totalPaginas} · ${total} inmobiliarias</span>`;
        html += `</div>`;
        nav.innerHTML = html;

        nav.querySelectorAll(".pag-num").forEach((btn) => {
            btn.addEventListener("click", () => {
                paginaI = Number((btn as HTMLElement).dataset.page);
                irAPaginaInmob(true);
            });
        });
        nav.querySelector(".pag-prev")?.addEventListener("click", () => {
            if (paginaI > 1) {
                paginaI--;
                irAPaginaInmob(true);
            }
        });
        nav.querySelector(".pag-next")?.addEventListener("click", () => {
            if (paginaI < totalPaginas) {
                paginaI++;
                irAPaginaInmob(true);
            }
        });
    }

    function actualizarContadorInmob() {
        const el = document.getElementById("contadorInmobiliarias");
        if (!el) return;
        const n = inmobFiltradas.length;
        el.textContent = `${n} ${n === 1 ? "inmobiliaria" : "inmobiliarias"}`;
    }

    function aplicarFiltrosInmob() {
        const q = (document.getElementById("busquedaInmobiliaria") as HTMLInputElement)?.value.trim().toLowerCase() ?? "";
        const ciudad = (document.getElementById("filtroCiudadInmobiliaria") as HTMLSelectElement)?.value.trim().toLowerCase() ?? "";

        inmobFiltradas = todasInmobiliarias.filter((item) => {
            const matchQ =
                !q ||
                (item.nombre ?? "").toLowerCase().includes(q) ||
                (item.ciudad ?? "").toLowerCase().includes(q) ||
                (item.descripcion ?? "").toLowerCase().includes(q) ||
                (item.contacto ?? "").toLowerCase().includes(q);
            const matchCiudad = !ciudad || (item.ciudad ?? "").trim().toLowerCase() === ciudad;
            return matchQ && matchCiudad;
        });

        paginaI = 1;
        actualizarContadorInmob();
        irAPaginaInmob(false);
    }

    function irAPaginaInmob(scroll = true) {
        const inicio = (paginaI - 1) * ITEMS_POR_PAG_I;
        renderGridInmob(inmobFiltradas.slice(inicio, inicio + ITEMS_POR_PAG_I));
        renderPaginacionInmob(inmobFiltradas.length);
        if (scroll) window.scrollTo({ top: 0, behavior: "smooth" });
    }

    document.getElementById("formBuscarInmobiliarias")?.addEventListener("submit", (e) => {
        e.preventDefault();
        aplicarFiltrosInmob();
    });
    document.getElementById("busquedaInmobiliaria")?.addEventListener("input", aplicarFiltrosInmob);
    document.getElementById("filtroCiudadInmobiliaria")?.addEventListener("change", aplicarFiltrosInmob);

    actualizarContadorInmob();
    irAPaginaInmob(false);
</script>

<style is:global>
    :root {
        --verde: #2e8b57;
        --verde-dark: #1f5f3d;
    }

    .resultados-section {
        background: #f9fcf3;
        min-height: 70vh;
        padding-top: 40px;
        padding-bottom: 48px;
        max-width: 1200px;
        margin: 0 auto;
        padding-left: 30px;
        padding-right: 30px;
    }

    .properties {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 28px;
        padding-bottom: 16px;
    }

    .property-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
        position: relative;
        cursor: pointer;
        border: 1px solid rgba(46, 125, 50, 0.1);
    }

    .property-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 14px 30px rgba(20, 83, 45, 0.14);
    }

    .property-image.constructora-img {
        position: relative;
        width: 100%;
        height: 220px;
        overflow: hidden;
        background: #e8f0ea;
    }

    .property-image.constructora-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }

    .property-card:hover .property-image.constructora-img img {
        transform: scale(1.06);
    }

    .card-img-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
    }

    .card-img-placeholder span {
        font-size: 2.4rem;
        font-weight: 800;
        color: var(--verde-dark);
        letter-spacing: -1px;
    }

    .badge-inmob-count {
        position: absolute;
        top: 14px;
        left: 14px;
        background: rgba(27, 94, 32, 0.9);
        color: white;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 5px 12px;
        border-radius: 20px;
        z-index: 2;
        backdrop-filter: blur(4px);
    }

    .property-info {
        padding: 18px 20px 22px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        flex: 1;
    }

    .constructora-nombre {
        margin: 0;
        font-size: 1.12rem;
        font-weight: 700;
        color: #1a1a1a;
        line-height: 1.3;
    }

    .location {
        margin: 0;
        color: var(--verde);
        font-size: 0.88rem;
        font-weight: 600;
    }

    .description {
        margin: 2px 0 0;
        font-size: 0.88rem;
        color: #555;
        line-height: 1.45;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .btn-ver-mas {
        margin-top: auto;
        padding-top: 8px;
        display: inline-block;
        font-size: 0.84rem;
        font-weight: 700;
        color: var(--verde);
    }

    .sin-resultados {
        text-align: center;
        color: #666;
        padding: 40px;
        grid-column: 1 / -1;
    }

    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.55);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 20px;
        backdrop-filter: blur(4px);
    }

    .modal-overlay.modal-visible {
        display: flex;
    }

    .modal-box {
        background: #fff;
        border-radius: 20px;
        width: 100%;
        max-width: 620px;
        max-height: 88vh;
        overflow-y: auto;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.22);
        position: relative;
        animation: modalIn 0.22s ease;
    }

    @keyframes modalIn {
        from { transform: translateY(18px) scale(0.97); opacity: 0; }
        to { transform: none; opacity: 1; }
    }

    .modal-cerrar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: none;
        font-size: 1.3rem;
        line-height: 1;
        cursor: pointer;
        z-index: 10;
    }

    .modal-header {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .modal-logo-wrap { flex-shrink: 0; }

    .modal-logo-img {
        width: 78px;
        height: 78px;
        border-radius: 14px;
        object-fit: cover;
    }

    .modal-logo-placeholder {
        width: 78px;
        height: 78px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.7rem;
        font-weight: 800;
        color: var(--verde-dark);
    }

    .modal-header-info { flex: 1; min-width: 0; }
    .modal-nombre { margin: 0 0 4px; font-size: 1.4rem; font-weight: 800; line-height: 1.25; }
    .modal-ciudad { margin: 0; font-size: 0.9rem; font-weight: 600; display: flex; align-items: center; }

    .modal-body {
        display: flex;
        flex-direction: column;
    }

    .modal-descripcion {
        margin: 0;
        font-size: 0.93rem;
        color: #4b5563;
        line-height: 1.6;
    }

    .modal-contacto {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .contacto-chip {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 0.84rem;
        font-weight: 600;
        padding: 7px 14px;
        border-radius: 20px;
    }

    .paginacion-constructoras {
        display: flex;
        justify-content: center;
        padding: 28px 16px 24px;
    }

    .paginas {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .pag-btn {
        padding: 8px 14px;
        border: 1px solid #d4e8d4;
        border-radius: 8px;
        background: #fff;
        color: #2e7d32;
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
    }

    .pag-btn.pag-activa {
        background: #1b5e20;
        color: #fff;
        border-color: #1b5e20;
    }

    .pag-btn:disabled {
        opacity: 0.45;
        cursor: not-allowed;
    }

    .pag-info {
        font-size: 0.84rem;
        color: #4b5563;
        margin-left: 8px;
    }
</style>
