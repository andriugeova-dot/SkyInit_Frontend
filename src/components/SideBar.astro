---
import { BACKEND_URL } from "../utils/config";
import {
    getTokenSSR,
    obtenerRolDesdeToken,
    COOKIE_NAME,
} from "../utils/auth";
import "./SideBar.css";

const token = getTokenSSR(Astro.cookies);
const rol = obtenerRolDesdeToken(token) ?? "Usuario";
const rutaActual = Astro.url.pathname;

// ---------- helpers ----------
function obtenerIniciales(nombre: string): string {
    const p = nombre.trim().split(/\s+/).filter(Boolean);
    if (p.length === 0) return "??";
    if (p.length === 1) return p[0].slice(0, 2).toUpperCase();
    return (p[0][0] + p[1][0]).toUpperCase();
}

function urlImagen(path: string | null | undefined): string | null {
    if (!path) return null;
    if (path.startsWith("http")) return path;
    return `/backend${path.startsWith("/") ? path : "/" + path}`;
}

function estaActivo(ruta: string): boolean {
    if (rutaActual === ruta) return true;
    const segmentos = ruta.split("/").filter(Boolean).length;
    if (segmentos === 1) return false;
    return rutaActual.startsWith(ruta + "/");
}

// ---------- datos de usuario / empresa ----------
let nombreMostrar = rol;
let subtitulo = "Panel";
let foto: string | null = null;
let iniciales = "??";

async function cargarPerfil() {
    if (!token) return;
    const headers = { Cookie: `${COOKIE_NAME}=${token}` };

    // Perfil genérico (nombre + foto de usuario)
    try {
        const res = await fetch(`${BACKEND_URL}/auth/perfil`, { headers });
        if (res.ok) {
            const json = await res.json();
            const u = json.usuario ?? json.data ?? json;
            if (u?.nombre) {
                nombreMostrar = u.nombre;
                iniciales = obtenerIniciales(u.nombre);
            }
            foto = urlImagen(u?.fotoPerfil ?? u?.FotoPerfil);
            subtitulo = rol;
        }
    } catch {
        /* defaults */
    }

    // Constructora: nombre y logo de la empresa
    if (rol === "Constructora") {
        try {
            const res = await fetch(
                `${BACKEND_URL}/panel/constructora/perfil`,
                { headers },
            );
            if (res.ok) {
                const json = await res.json();
                const c = json.data ?? json;
                if (c?.nombre) {
                    nombreMostrar = c.nombre;
                    iniciales = obtenerIniciales(c.nombre);
                }
                if (c?.logo) foto = urlImagen(c.logo);
                subtitulo = c?.ciudad ? c.ciudad : "Constructora";
            }
        } catch {
            /* defaults */
        }
    }
}

await cargarPerfil();

// ---------- menú por rol ----------
const configuraciones: Record<
    string,
    {
        nombre: string;
        descripcion: string;
        iniciales: string;
        clase: string;
        rutas: {
            usuarios?: string;
            dashboard: string;
            propiedades?: string;
            favoritos?: string;
            solicitudes?: string;
            proyectos?: string;
            constructoras?:string;
            perfil: string;
            inmobiliarias? : string;
        };
        items: {
            href: string;
            icon: string;
            label: string;
        }[];
    }
> = {
    // ── USUARIO ──────────────────────────────────────
    Usuario: {
        nombre: nombreMostrar,
        descripcion: subtitulo,
        iniciales,
        clase: "usuario",
        rutas: {
            dashboard:    "/usuario",
            // propiedades:  "/usuario/propiedades",
            favoritos:    "/usuario/favoritos",
            solicitudes:  "/usuario/solicitudes",
            perfil:       "/usuario/perfil",
        },
        items: [
            { href: "/usuario",               icon: "bi-grid-1x2-fill",         label: "Inicio" },
            // { href: "/usuario/propiedades",   icon: "bi-house-door-fill",       label: "Propiedades" },
            { href: "/usuario/favoritos",     icon: "bi-heart-fill",            label: "Favoritos" },
            { href: "/usuario/solicitudes",   icon: "bi-file-earmark-text-fill",label: "Solicitudes" },
            { href: "/usuario/agenda",        icon: "bi-calendar-check-fill",   label: "Mis visitas" },
            { href: "/usuario/calendario",    icon: "bi-calendar3",             label: "Calendario" },
            { href: "/notificaciones", icon: "bi-bell-fill", label: "Notificaciones" },
            { href: "/usuario/perfil",        icon: "bi-person-fill",           label: "Mi Perfil" },
            { href: "/",                      icon: "bi-arrow-left-circle-fill", label: "Volver al menú" },
        ],
    },
    // ── CONSTRUCTORA ─────────────────────────────────
    Constructora: {
        nombre: nombreMostrar,
        descripcion: subtitulo,
        iniciales,
        clase: "constructora",
        rutas: {
            dashboard:   "/constructora",
            propiedades: "/constructora/propiedades",
            proyectos:   "/constructora/proyectos",
            perfil:      "/constructora/perfil",
        },
        items: [
            { href: "/constructora",             icon: "bi-grid-1x2-fill",   label: "Dashboard" },
            { href: "/constructora/proyectos",   icon: "bi-buildings-fill",  label: "Proyectos" },
            { href: "/constructora/propiedades", icon: "bi-house-fill",      label: "Propiedades" },
            { href: "/constructora/trabajadores", icon: "bi-people-fill",    label: "Trabajadores" },
            { href: "/constructora/mantenimiento", icon: "bi-wrench-adjustable", label: "Mantenimiento" },
            { href: "/notificaciones", icon: "bi-bell-fill", label: "Notificaciones" },
            { href: "/constructora/perfil",      icon: "bi-person-fill",     label: "Perfil" },
        ],
    },
    // ── ADMINISTRADOR ────────────────────────────────
    Administrador: {
        nombre: nombreMostrar,
        descripcion: subtitulo,
        iniciales,
        clase: "administrador",
        rutas: {
            dashboard:   "/admin",
            propiedades: "/admin/propiedades",
            proyectos:   "/admin/proyectos",
            solicitudes: "/admin/solicitudes",
            constructoras: "/admin/constructoras",
            perfil:      "/admin/perfil",
        },
        items: [
            { href: "/admin",              icon: "bi-grid-1x2-fill",  label: "Dashboard" },
            { href: "/admin/propiedades",    icon: "bi-buildings-fill", label: "Propiedades" },
            { href: "/admin/proyectos",  icon: "bi-house-fill",     label: "Proyectos" },
            { href: "/admin/constructoras",        icon: "bi-shop-window    ",  label: "Constructoras" },
            { href: "/admin/servicios",   icon: "bi-tools",          label: "Servicios" },
            { href: "/admin/solicitudes",   icon: "bi-envelope-fill",  label: "Solicitudes" },
            { href: "/admin/mantenimiento", icon: "bi-wrench-adjustable", label: "Mantenimiento" },
            { href: "/admin/agentes",       icon: "bi-person-badge-fill", label: "Agentes" },
            { href: "/admin/agenda",        icon: "bi-calendar-check-fill", label: "Agenda" },
            { href: "/notificaciones", icon: "bi-bell-fill", label: "Notificaciones" },
            { href: "/admin/perfil",       icon: "bi-person-fill",    label: "Perfil" },
        ],
    },
    // ── SUPERADMIN ───────────────────────────────────
    SuperAdmin: {
        nombre: nombreMostrar,
        descripcion: subtitulo,
        iniciales,
        clase: "superadmin",
        rutas: {
            dashboard:   "/superadmin",
            usuarios: "/superadmin/usuarios",
            constructoras: "/superadmin/constructoras",
            inmobiliarias:   "/superadmin/inmobiliarias",
            perfil:      "/superadmin/perfil",
        },
        items: [
            { href: "/superadmin",             icon: "bi-grid-1x2-fill",  label: "Dashboard" },
            { href: "/superadmin/usuarios",   icon: "bi bi-people", label: "Usuarios" },
            { href: "/superadmin/constructoras", icon: "bi-hammer",     label: "Constructoras" },
            { href: "/superadmin/inmobiliarias", icon: "bi-shop",     label: "Inmobiliarias" },
            { href: "/notificaciones", icon: "bi-bell-fill", label: "Notificaciones" },
            { href: "/superadmin/perfil",      icon: "bi-person-fill",    label: "Perfil" },
        ],
    },
    // ── AGENTE ──────────────────────────────────────
    Agente: {
        nombre: nombreMostrar,
        descripcion: subtitulo,
        iniciales,
        clase: "agente",
        rutas: {
            dashboard:   "/agente",
            propiedades: "/agente/propiedades",
            proyectos:   "/agente/proyectos",
            perfil:      "/agente/perfil",
        },
        items: [
            { href: "/agente",             icon: "bi-grid-1x2-fill",  label: "Dashboard" },
            { href: "/agente/proyectos",   icon: "bi-buildings-fill", label: "Proyectos" },
            { href: "/agente/propiedades", icon: "bi-house-fill",     label: "Propiedades" },
            { href: "/agente/agenda",      icon: "bi-calendar-check-fill", label: "Agenda" },
            { href: "/notificaciones", icon: "bi-bell-fill", label: "Notificaciones" },
            { href: "/agente/perfil",      icon: "bi-person-fill",    label: "Perfil" },
        ],
    },
    // ── TRABAJADOR ───────────────────────────────────
    Trabajador: {
        nombre: nombreMostrar,
        descripcion: subtitulo,
        iniciales,
        clase: "constructora",
        rutas: { dashboard: "/trabajador", perfil: "/trabajador/perfil" },
        items: [
            { href: "/trabajador",            icon: "bi-grid-1x2-fill", label: "Mi trabajo" },
            { href: "/trabajador/agenda",     icon: "bi-calendar3",     label: "Agenda" },
            { href: "/trabajador/grupo",      icon: "bi-people-fill",   label: "Grupo de trabajo" },
            { href: "/notificaciones",        icon: "bi-bell-fill",     label: "Notificaciones" },
            { href: "/trabajador/perfil",     icon: "bi-person-fill",   label: "Perfil" },
        ],
    },
};

const cfg = configuraciones[rol] ?? configuraciones["Usuario"];
---

<aside class={`sidebar ${cfg.clase}`} data-rol={rol}>
    <!-- LOGO -->
    <div class="logo">
        <div class="logo-marca">
            <span>SI</span>
        </div>
        <div class="logo-nombre">
            <span>SKYINIT</span>
            <strong>Inmobiliaria</strong>
        </div>
    </div>

    <!-- NAV -->
    <nav class="navegacion">
        {cfg.items.map(item => (
            <a
                href={item.href}
                class:list={{
                    "nav-item": true,
                    activo: estaActivo(item.href),
                }}
            >
                <i class={`bi ${item.icon}`}></i>
                <span>{item.label}</span>
                {item.href === "/notificaciones" && <b class="nav-badge" id="navNotifBadge" hidden></b>}
            </a>
        ))}
    </nav>

    <!-- USUARIO + LOGOUT -->
    <div class="sidebar-footer">
        <div class="usuario">
            <div class="avatar">
                {
                    foto ? (
                        <img src={foto} alt="" class="avatar-img" />
                    ) : (
                        <span>{cfg.iniciales}</span>
                    )
                }
            </div>
            <div class="usuario-info">
                <strong title={cfg.nombre}>{cfg.nombre}</strong>
                <span title={cfg.descripcion}>{cfg.descripcion}</span>
            </div>
        </div>

        <button type="button" class="btn-logout" id="btnLogout" title="Cerrar sesión">
            <i class="bi bi-box-arrow-right"></i>
            <span>Cerrar sesión</span>
        </button>
    </div>
</aside>

<script>
document.getElementById("btnLogout")?.addEventListener("click", async () => {
    try {
        await fetch("/api/logout", {
            method: "POST",
            credentials: "same-origin",
        });
    } catch {
        /* igual redirigimos */
    }
    window.location.href = "/login";
});

// Notificaciones en tiempo casi real (contador + ventanas emergentes)
import { iniciarAvisos } from "./funciones/avisos";
iniciarAvisos(document.querySelector<HTMLElement>(".sidebar")?.dataset.rol ?? "Usuario", ["navNotifBadge"]);
</script>

<style is:global>
/* Menu con muchos modulos: compacto y con desplazamiento propio para que nunca se corte */
.sidebar .navegacion { gap: 3px; overflow-y: auto; min-height: 0; padding-right: 4px; scrollbar-width: thin; scrollbar-color: rgba(255,255,255,.25) transparent; }
.sidebar .navegacion .nav-item { height: 44px; flex-shrink: 0; }
.sidebar .sidebar-footer { flex-shrink: 0; }
#avisosPila { position: fixed; top: 18px; right: 18px; z-index: 4000; display: grid; gap: 10px; width: min(360px, calc(100vw - 36px)); }
.aviso-emergente { display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: start; padding: 14px 14px 14px 16px; border-radius: 14px;
    background: #fff; color: #1f2937; text-decoration: none; border: 1px solid #e5e7eb; border-left: 4px solid #c8ad72;
    box-shadow: 0 14px 40px rgba(15, 23, 42, .22); animation: avisoEntra .25s ease-out; }
.aviso-emergente:hover { color: #1f2937; background: #fafafa; }
.aviso-emergente > i { font-size: 1.25rem; color: #2f5d46; margin-top: 2px; }
.aviso-emergente span { display: grid; gap: 2px; min-width: 0; }
.aviso-emergente small { color: #6b7280; overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.aviso-emergente button { border: 0; background: none; color: #9ca3af; cursor: pointer; padding: 2px; }
@keyframes avisoEntra { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: none; } }
@media (prefers-reduced-motion: reduce) { .aviso-emergente { animation: none; } }
.nav-badge {
    margin-left: auto;
    min-width: 20px;
    padding: 0 6px;
    border-radius: 10px;
    background: #dc3545;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    line-height: 20px;
    text-align: center;
}
</style>
