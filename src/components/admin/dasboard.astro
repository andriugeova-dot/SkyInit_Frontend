---
import ResumenPanel from "../funciones/ResumenPanel.astro";
import NotifModalPanel from "../funciones/NotifModalPanel.astro";
import UltimasNotifsCard from "../funciones/UltimasNotifsCard.astro";
import "../funciones/funciones.css";
import "../funciones/panelUnificado.css";
import { COOKIE_NAME, getTokenSSR } from "../../utils/auth";

const BACKEND = import.meta.env.BACKEND_URL ?? "http://localhost:8001";
const token = getTokenSSR(Astro.cookies);

type ResumenDashboard = {
  totales: {
    propiedades: number;
    proyectos: number;
    constructoras: number;
    servicios: number;
    serviciosActivos: number;
    solicitudesServicios: number;
  };
  propiedadesPorEstado: { estado: string; total: number }[];
  proyectosPorEstado: { estadoProyectoID: number; total: number }[];
  solicitudesServiciosPorEstado: { estadoReparacionID: number | null; estado: string; total: number }[];
};

let resumen: ResumenDashboard | null = null;
let errorCarga: string | null = null;

if (token) {
  try {
    const res = await fetch(`${BACKEND}/admin/dashboard`, {
      headers: {
        Cookie: `${COOKIE_NAME}=${token}`,
        Accept: "application/json",
      },
    });
    if (res.ok) {
      resumen = await res.json();
    } else {
      errorCarga = `No se pudieron cargar las estadisticas (${res.status})`;
    }
  } catch {
    errorCarga = "No se pudo conectar con el backend";
  }
} else {
  errorCarga = "Sesion no valida";
}

const nombreEstadoProy = (id: number) =>
  id === 3 ? "Finalizados" : id === 2 ? "En construccion" : "Planificados";

const iconoEstadoProp = (estado: string) => {
  if (estado === "Disponible") return "bi-house-check";
  if (estado === "Reservada") return "bi-hourglass-split";
  if (estado === "Mantenimiento") return "bi-cone-striped";
  return "bi-slash-circle";
};

const iconoEstadoProy = (id: number) => {
  if (id === 3) return "bi-flag-fill";
  if (id === 2) return "bi-hammer";
  return "bi-clipboard2-pulse";
};

const iconoEstadoSolicitud = (estado: string) => {
  const e = estado.toLowerCase();
  if (e.includes("final")) return "bi-check-circle";
  if (e.includes("proceso")) return "bi-gear";
  if (e.includes("aceptada") && !e.includes("no")) return "bi-hand-thumbs-up";
  return "bi-hourglass-split";
};
---

<div class="pl-page pl-theme-admin">
  <header class="pl-hero">
    <div class="pl-hero-info">
      <div class="pl-hero-tags">
        <span class="pl-hero-tag"><i class="bi bi-building" aria-hidden="true"></i> Inmobiliaria</span>
        <span class="pl-hero-tag"><i class="bi bi-calendar-event" aria-hidden="true"></i> <span id="adminFechaTag">Hoy</span></span>
      </div>
      <h1>Panel de administración</h1>
      <p>Resumen general de tu inmobiliaria, propiedades, proyectos y solicitudes.</p>
    </div>
    <div class="pl-hero-acc">
      <a class="pl-hero-btn" href="/admin/propiedades"><i class="bi bi-houses" aria-hidden="true"></i> Propiedades</a>
      <a class="pl-hero-btn pl-hero-btn--sec" href="/admin/agenda"><i class="bi bi-calendar-check" aria-hidden="true"></i> Agenda</a>
      <NotifModalPanel />
    </div>
  </header>

  {errorCarga && (
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-0" role="alert">
      <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
      {errorCarga}
    </div>
  )}

  {resumen && (
    <>
      <section class="pl-kpis" aria-label="Totales">
        <div class="pl-kpi pl-kpi--destacado">
          <div class="pl-kpi-top"><span class="pl-kpi-lbl">Propiedades</span><span class="pl-kpi-ico"><i class="bi bi-houses" aria-hidden="true"></i></span></div>
          <b class="pl-kpi-val">{resumen.totales.propiedades}</b>
        </div>
        <div class="pl-kpi">
          <div class="pl-kpi-top"><span class="pl-kpi-lbl">Proyectos</span><span class="pl-kpi-ico"><i class="bi bi-building-fill-up" aria-hidden="true"></i></span></div>
          <b class="pl-kpi-val">{resumen.totales.proyectos}</b>
        </div>
        <div class="pl-kpi">
          <div class="pl-kpi-top"><span class="pl-kpi-lbl">Constructoras</span><span class="pl-kpi-ico"><i class="bi bi-hammer" aria-hidden="true"></i></span></div>
          <b class="pl-kpi-val">{resumen.totales.constructoras}</b>
        </div>
        <div class="pl-kpi">
          <div class="pl-kpi-top"><span class="pl-kpi-lbl">Servicios</span><span class="pl-kpi-ico"><i class="bi bi-briefcase" aria-hidden="true"></i></span></div>
          <b class="pl-kpi-val">{resumen.totales.servicios}</b>
        </div>
        <div class="pl-kpi pl-kpi--prog">
          <div class="pl-kpi-top"><span class="pl-kpi-lbl">Solicitudes</span><span class="pl-kpi-ico"><i class="bi bi-inbox" aria-hidden="true"></i></span></div>
          <b class="pl-kpi-val">{resumen.totales.solicitudesServicios ?? 0}</b>
        </div>
        <div class="pl-kpi" id="plKpiSinLeerCard">
          <div class="pl-kpi-top"><span class="pl-kpi-lbl">Sin leer</span><span class="pl-kpi-ico"><i class="bi bi-bell-fill" aria-hidden="true"></i></span></div>
          <b class="pl-kpi-val" id="plKpiSinLeer">—</b>
        </div>
      </section>

      <ResumenPanel />

      <div class="pl-split">
        <div class="pl-stack">
          <div class="pl-estados-grid">
            <section class="pl-card">
              <div class="pl-card-head">
                <div class="pl-card-titulo">
                  <div class="pl-card-ico"><i class="bi bi-houses" aria-hidden="true"></i></div>
                  <div>
                    <h2>Propiedades por estado</h2>
                    <small>Distribución del catálogo.</small>
                  </div>
                </div>
              </div>
              <div class="pl-breakdown-list">
                {resumen.propiedadesPorEstado.map((p) => (
                  <div class="pl-breakdown-row">
                    <span class="pl-breakdown-dot"><i class={`bi ${iconoEstadoProp(p.estado)}`} aria-hidden="true"></i></span>
                    <span class="pl-breakdown-label">{p.estado}</span>
                    <span class="pl-breakdown-value">{p.total}</span>
                  </div>
                ))}
              </div>
            </section>

            <section class="pl-card">
              <div class="pl-card-head">
                <div class="pl-card-titulo">
                  <div class="pl-card-ico pl-card-ico--acc"><i class="bi bi-building-fill-up" aria-hidden="true"></i></div>
                  <div>
                    <h2>Proyectos por estado</h2>
                    <small>Avance de proyectos.</small>
                  </div>
                </div>
              </div>
              <div class="pl-breakdown-list">
                {resumen.proyectosPorEstado.map((p) => (
                  <div class="pl-breakdown-row">
                    <span class="pl-breakdown-dot"><i class={`bi ${iconoEstadoProy(p.estadoProyectoID)}`} aria-hidden="true"></i></span>
                    <span class="pl-breakdown-label">{nombreEstadoProy(p.estadoProyectoID)}</span>
                    <span class="pl-breakdown-value">{p.total}</span>
                  </div>
                ))}
              </div>
            </section>

            <section class="pl-card" style="grid-column: 1 / -1">
              <div class="pl-card-head">
                <div class="pl-card-titulo">
                  <div class="pl-card-ico"><i class="bi bi-inbox" aria-hidden="true"></i></div>
                  <div>
                    <h2>Solicitudes de servicios por estado</h2>
                    <small>Seguimiento de requerimientos recibidos.</small>
                  </div>
                </div>
              </div>
              <div class="pl-breakdown-list">
                {(resumen.solicitudesServiciosPorEstado ?? []).length === 0 ? (
                  <p class="fn-muted" style="margin:0">Aún no hay solicitudes.</p>
                ) : (
                  resumen.solicitudesServiciosPorEstado.map((s) => (
                    <div class="pl-breakdown-row">
                      <span class="pl-breakdown-dot"><i class={`bi ${iconoEstadoSolicitud(s.estado)}`} aria-hidden="true"></i></span>
                      <span class="pl-breakdown-label">{s.estado}</span>
                      <span class="pl-breakdown-value">{s.total}</span>
                    </div>
                  ))
                )}
              </div>
            </section>
          </div>

          <article class="pl-card">
            <div class="pl-card-head">
              <div class="pl-card-titulo">
                <div class="pl-card-ico"><i class="bi bi-lightning-charge-fill" aria-hidden="true"></i></div>
                <div>
                  <h2>Acciones rápidas</h2>
                  <small>Accesos directos a los módulos de administración.</small>
                </div>
              </div>
            </div>
            <div class="pl-acciones-grid">
              <a class="pl-accion pl-accion--destacada" href="/admin/propiedades">
                <span class="pl-accion-ico"><i class="bi bi-houses" aria-hidden="true"></i></span>
                <span class="pl-accion-txt"><strong>Propiedades</strong><small>Catálogo y precios</small></span>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
              </a>
              <a class="pl-accion" href="/admin/proyectos">
                <span class="pl-accion-ico"><i class="bi bi-building-fill-up" aria-hidden="true"></i></span>
                <span class="pl-accion-txt"><strong>Proyectos</strong><small>Obras y avances</small></span>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
              </a>
              <a class="pl-accion" href="/admin/constructoras">
                <span class="pl-accion-ico"><i class="bi bi-hammer" aria-hidden="true"></i></span>
                <span class="pl-accion-txt"><strong>Constructoras</strong><small>Empresas vinculadas</small></span>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
              </a>
              <a class="pl-accion" href="/admin/servicios">
                <span class="pl-accion-ico"><i class="bi bi-tools" aria-hidden="true"></i></span>
                <span class="pl-accion-txt"><strong>Servicios</strong><small>Catálogo técnico</small></span>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
              </a>
              <a class="pl-accion" href="/admin/solicitudes">
                <span class="pl-accion-ico"><i class="bi bi-envelope-fill" aria-hidden="true"></i></span>
                <span class="pl-accion-txt"><strong>Solicitudes</strong><small>Peticiones recibidas</small></span>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
              </a>
              <a class="pl-accion" href="/admin/mantenimiento">
                <span class="pl-accion-ico"><i class="bi bi-wrench-adjustable" aria-hidden="true"></i></span>
                <span class="pl-accion-txt"><strong>Mantenimiento</strong><small>Asignación y control</small></span>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
              </a>
              <a class="pl-accion" href="/admin/agentes">
                <span class="pl-accion-ico"><i class="bi bi-person-badge-fill" aria-hidden="true"></i></span>
                <span class="pl-accion-txt"><strong>Agentes</strong><small>Cuentas de equipo</small></span>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
              </a>
              <a class="pl-accion" href="/admin/agenda">
                <span class="pl-accion-ico"><i class="bi bi-calendar-check-fill" aria-hidden="true"></i></span>
                <span class="pl-accion-txt"><strong>Agenda</strong><small>Citas programadas</small></span>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
              </a>
            </div>
          </article>
        </div>

        <UltimasNotifsCard />
      </div>
    </>
  )}
</div>

<script>
  const tag = document.getElementById("adminFechaTag");
  if (tag) {
    const f = new Date().toLocaleDateString("es-CO", { weekday: "long", day: "numeric", month: "long" });
    tag.textContent = f.charAt(0).toUpperCase() + f.slice(1);
  }
</script>
