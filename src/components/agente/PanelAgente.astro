---
import "../funciones/funciones.css";
import "../funciones/panelUnificado.css";
import NotifModalPanel from "../funciones/NotifModalPanel.astro";

interface Stat {
  id: string;
  titulo: string;
  valor: string | number;
  variante?: "ok" | "warn" | "muted";
}

interface Props {
  titulo: string;
  subtitulo: string;
  tag?: string;
  textoAccion?: string;
  idAccion?: string;
  stats?: Stat[];
}

const {
  titulo,
  subtitulo,
  tag = "Gestión comercial",
  textoAccion,
  idAccion = "btnAccionPanel",
  stats = [],
} = Astro.props;

const claseKpi = (idx: number, variante?: Stat["variante"]) => {
  if (idx === 0) return "pl-kpi pl-kpi--destacado";
  if (variante === "ok") return "pl-kpi pl-kpi--ok";
  if (variante === "warn") return "pl-kpi pl-kpi--alerta";
  return "pl-kpi";
};

const iconoKpi = (idx: number, variante?: Stat["variante"]) => {
  if (idx === 0) return "bi-grid-1x2-fill";
  if (variante === "ok") return "bi-check-circle-fill";
  if (variante === "warn") return "bi-hourglass-split";
  return "bi-bar-chart-fill";
};
---

<div class="panel-agente pl-page pl-theme-agente">
  <header class="pl-hero">
    <div class="pl-hero-info">
      <div class="pl-hero-tags">
        <span class="pl-hero-tag"><i class="bi bi-briefcase-fill" aria-hidden="true"></i> {tag}</span>
      </div>
      <h1>{titulo}</h1>
      <p>{subtitulo}</p>
    </div>
    <div class="pl-hero-acc">
      {textoAccion && (
        <button class="pl-hero-btn" id={idAccion} type="button">
          <i class="bi bi-plus-lg" aria-hidden="true"></i>
          <span>{textoAccion}</span>
        </button>
      )}
      <a class="pl-hero-btn pl-hero-btn--sec" href="/agente"><i class="bi bi-arrow-left" aria-hidden="true"></i> Volver al panel</a>
      <NotifModalPanel />
    </div>
  </header>

  {stats.length > 0 && (
    <div class="pl-kpis">
      {stats.map((stat, idx) => (
        <div class={claseKpi(idx, stat.variante)}>
          <div class="pl-kpi-top">
            <span class="pl-kpi-lbl">{stat.titulo}</span>
            <span class="pl-kpi-ico"><i class={`bi ${iconoKpi(idx, stat.variante)}`} aria-hidden="true"></i></span>
          </div>
          <div class="pl-kpi-val" id={stat.id}>{stat.valor}</div>
        </div>
      ))}
    </div>
  )}

  <slot name="filtros" />
  <slot />
</div>

<style is:global>
  .filter-bar { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; padding: 1rem; }
</style>
