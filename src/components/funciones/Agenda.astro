---
import "./funciones.css";
interface Props { modo: "usuario" | "gestion"; mostrarCabecera?: boolean }
const { modo, mostrarCabecera = true } = Astro.props;
---
<section class="fn" id="agendaRoot" data-modo={modo} data-unificado={mostrarCabecera ? "0" : "1"} style={mostrarCabecera ? undefined : "max-width:none;margin-top:0"}>
  {mostrarCabecera && (
    <div class="fn-head">
      <div>
        <h1>{modo === "usuario" ? "Mis visitas" : "Agenda de visitas"}</h1>
        <p>{modo === "usuario" ? "Agenda una visita a una propiedad y sigue su estado." : "Confirma o cancela las visitas solicitadas a tus propiedades."}</p>
      </div>
      {modo === "usuario" && <button class="fn-btn" id="btnNuevaVisita" type="button"><i class="bi bi-calendar-plus"></i> Agendar visita</button>}
    </div>
  )}
  <div class={mostrarCabecera ? "fn-stats" : "pl-kpis"} id="agendaStats"></div>
  {mostrarCabecera ? (
    <div id="agendaLista"></div>
  ) : (
    <section class="pl-card">
      <div class="pl-card-head">
        <div class="pl-card-titulo">
          <div class="pl-card-ico"><i class="bi bi-calendar-check-fill" aria-hidden="true"></i></div>
          <div>
            <h2>Historial de visitas</h2>
            <small>Consulta la fecha, propiedad, estado y acciones de tus citas.</small>
          </div>
        </div>
      </div>
      <div id="agendaLista"></div>
    </section>
  )}

  <dialog class="fn-modal" id="dlgVisita">
    <form class="fn-modal-cuerpo fn-form" id="formVisita">
      <h2>Agendar visita</h2>
      <label>Propiedad
        <select id="visitaPropiedad" required></select>
      </label>
      <label>Fecha y hora
        <input type="datetime-local" id="visitaFecha" required />
      </label>
      <label>Notas (opcional)
        <textarea id="visitaNotas" rows="3" maxlength="300" placeholder="Ej.: prefiero en la tarde"></textarea>
      </label>
      <div class="fn-modal-pie">
        <button class="fn-btn fn-btn--sec" type="button" id="btnCerrarVisita">Cancelar</button>
        <button class="fn-btn" type="submit">Solicitar visita</button>
      </div>
    </form>
  </dialog>

  <dialog class="fn-modal" id="dlgReprogramar">
    <form class="fn-modal-cuerpo fn-form" id="formReprogramar">
      <h2>Reprogramar visita</h2>
      <p class="fn-muted" id="reprogPropiedad" style="margin:0"></p>
      <input type="hidden" id="reprogId" />
      <label>Nueva fecha y hora
        <input type="datetime-local" id="reprogFecha" required />
      </label>
      <label>Notas (opcional)
        <textarea id="reprogNotas" rows="2" maxlength="300"></textarea>
      </label>
      <div class="fn-modal-pie">
        <button class="fn-btn fn-btn--sec" type="button" id="btnCerrarReprog">Cancelar</button>
        <button class="fn-btn" type="submit">Guardar nueva fecha</button>
      </div>
    </form>
  </dialog>
</section>

<style is:global>
  .ag-prop-link {
    border: 0; background: none; padding: 0; font: inherit; font-weight: 700;
    color: var(--pl-ink, var(--fn-ink)); text-align: left; cursor: pointer;
    text-decoration: underline; text-decoration-color: rgba(20, 83, 45, 0.35); text-underline-offset: 2px;
  }
  .ag-prop-link:hover { color: var(--pl-acc-osc, var(--fn-acc)); }
  .ag-prop-ext { margin-left: 6px; color: var(--fn-muted); font-size: 0.78rem; }
  .ag-prop-ext:hover { color: var(--pl-acc-osc, var(--fn-acc)); }
</style>

<script>
  import { api, esc, fechaHora, aviso, claseEstado } from "./comun";
  const root = document.getElementById("agendaRoot")!;
  const modo = root.dataset.modo as "usuario" | "gestion";
  const lista = document.getElementById("agendaLista")!;
  const stats = document.getElementById("agendaStats")!;
  const dlg = document.getElementById("dlgVisita") as HTMLDialogElement;
  const dlgReprog = document.getElementById("dlgReprogramar") as HTMLDialogElement;

  const unificado = root.dataset.unificado === "1";
  let visitasCache: any[] = [];
  const MSG_HORARIO = "Las visitas solo se pueden agendar entre 7:00 a. m. y 7:00 p. m.";
  const fmtHoraCo = new Intl.DateTimeFormat("en-US", { timeZone: "America/Bogota", hour: "2-digit", minute: "2-digit", hourCycle: "h23" });
  function enHorarioAtencion(fecha: Date): boolean {
    if (Number.isNaN(fecha.getTime())) return false;
    const partes = fmtHoraCo.formatToParts(fecha);
    const h = Number(partes.find((p) => p.type === "hour")?.value);
    const m = Number(partes.find((p) => p.type === "minute")?.value);
    const mins = h * 60 + m;
    return mins >= 7 * 60 && mins <= 19 * 60;
  }

  async function cargar() {
    try {
      const { visitas } = await api(modo === "usuario" ? "/agenda/mias" : "/agenda/gestion");
      visitasCache = visitas ?? [];
      const cuenta = (e: string) => visitas.filter((v: any) => v.estado === e).length;
      if (unificado) {
        const pend = cuenta("Pendiente");
        const conf = cuenta("Confirmada");
        const fin  = cuenta("Finalizada");
        const canc = cuenta("Cancelada");
        stats.innerHTML = `
          <div class="pl-kpi ${pend ? "pl-kpi--alerta" : ""}"><div class="pl-kpi-top"><span class="pl-kpi-lbl">Pendientes</span><span class="pl-kpi-ico"><i class="bi bi-hourglass-split" aria-hidden="true"></i></span></div><b class="pl-kpi-val">${pend}</b></div>
          <div class="pl-kpi pl-kpi--prog"><div class="pl-kpi-top"><span class="pl-kpi-lbl">Confirmadas</span><span class="pl-kpi-ico"><i class="bi bi-calendar-check" aria-hidden="true"></i></span></div><b class="pl-kpi-val">${conf}</b></div>
          <div class="pl-kpi pl-kpi--ok"><div class="pl-kpi-top"><span class="pl-kpi-lbl">Finalizadas</span><span class="pl-kpi-ico"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span></div><b class="pl-kpi-val">${fin}</b></div>
          <div class="pl-kpi"><div class="pl-kpi-top"><span class="pl-kpi-lbl">Canceladas</span><span class="pl-kpi-ico"><i class="bi bi-x-circle" aria-hidden="true"></i></span></div><b class="pl-kpi-val">${canc}</b></div>`;
      } else {
        stats.innerHTML = ["Pendiente", "Confirmada", "Finalizada", "Cancelada"].map((e) =>
          `<div class="fn-stat"><b>${cuenta(e)}</b><span>${e}s</span></div>`).join("");
      }
      if (!visitas.length) {
        lista.innerHTML = `<div class="fn-vacio"><i class="bi bi-calendar-week"></i>${modo === "usuario"
          ? "Todavía no has agendado visitas. Usa “Agendar visita” para elegir una propiedad."
          : "No hay visitas solicitadas a tus propiedades."}</div>`;
        return;
      }
      lista.innerHTML = `<div class="fn-tabla-wrap"><table class="fn-tabla"><thead><tr>
        <th>Fecha</th><th>Propiedad</th>${modo === "gestion" ? "<th>Solicitante</th>" : ""}<th>Notas</th><th>Estado</th><th></th></tr></thead><tbody>` +
        visitas.map((v: any) => {
          const id = Number(v.agendaID);
          const acciones: string[] = [];
          if (v.estado !== "Cancelada" && v.estado !== "Finalizada") {
            if (modo === "gestion" && v.estado === "Pendiente") acciones.push(`<button class="fn-btn fn-btn--mini" data-estado="2" data-id="${id}" type="button">Confirmar</button>`);
            if (modo === "usuario" && v.estado === "Pendiente") acciones.push(`<button class="fn-btn fn-btn--sec fn-btn--mini" data-reprogramar="${id}" type="button"><i class="bi bi-calendar2-event" aria-hidden="true"></i> Reprogramar</button>`);
            acciones.push(`<button class="fn-btn fn-btn--mal fn-btn--mini" data-estado="3" data-id="${id}" type="button">Cancelar</button>`);
          }
          return `<tr><td>${esc(fechaHora(v.fechaVisita))}</td>
            <td>
              <button type="button" class="ag-prop-link" data-detalle="propiedad:${Number(v.propiedadID)}" title="Ver detalle de la propiedad">${esc(v.propiedad)}</button>
              <a class="ag-prop-ext" href="/propiedades?query=${encodeURIComponent(v.propiedad ?? "")}" title="Ver en catálogo"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
              <br><small class="fn-muted">${esc(v.direccion)}${v.ciudad ? ", " + esc(v.ciudad) : ""}</small>
            </td>
            ${modo === "gestion" ? `<td>${esc(v.solicitante)}<br><small class="fn-muted">${esc(v.telefono ?? v.correo)}</small></td>` : ""}
            <td>${esc(v.notas ?? "—")}</td>
            <td><span class="fn-chip ${claseEstado(v.estado)}">${esc(v.estado)}</span></td>
            <td><div class="fn-acciones">${acciones.join("")}</div></td></tr>`;
        }).join("") + "</tbody></table></div>";
    } catch (e) { lista.innerHTML = `<div class="fn-vacio">${esc((e as Error).message)}</div>`; }
  }

  lista.addEventListener("click", async (ev) => {
    const btnReprog = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-reprogramar]");
    if (btnReprog) {
      const id = Number(btnReprog.dataset.reprogramar);
      const v = visitasCache.find((x) => Number(x.agendaID) === id);
      if (!v) return;
      (document.getElementById("reprogId") as HTMLInputElement).value = String(id);
      document.getElementById("reprogPropiedad")!.textContent = v.propiedad ?? "";
      const min = new Date(Date.now() + 2 * 3600 * 1000); min.setMinutes(min.getMinutes() - min.getTimezoneOffset());
      const fechaIn = document.getElementById("reprogFecha") as HTMLInputElement;
      fechaIn.min = min.toISOString().slice(0, 16);
      const actual = new Date(v.fechaVisita);
      if (!Number.isNaN(actual.getTime())) {
        actual.setMinutes(actual.getMinutes() - actual.getTimezoneOffset());
        fechaIn.value = actual.toISOString().slice(0, 16);
      }
      (document.getElementById("reprogNotas") as HTMLTextAreaElement).value = v.notas ?? "";
      dlgReprog.showModal();
      return;
    }
    const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-estado]");
    if (!btn) return;
    btn.disabled = true;
    try {
      const r = await api(`/agenda/${btn.dataset.id}/estado`, "PATCH", { estadoAgendaID: Number(btn.dataset.estado) });
      aviso(r.mensaje); cargar();
    } catch (e) { aviso((e as Error).message, "error"); btn.disabled = false; }
  });

  document.getElementById("btnCerrarReprog")?.addEventListener("click", () => dlgReprog.close());
  document.getElementById("formReprogramar")?.addEventListener("submit", async (ev) => {
    ev.preventDefault();
    const id = (document.getElementById("reprogId") as HTMLInputElement).value;
    const fechaVal = (document.getElementById("reprogFecha") as HTMLInputElement).value;
    const fechaObj = new Date(fechaVal);
    if (!enHorarioAtencion(fechaObj)) { aviso(MSG_HORARIO, "error"); return; }
    const notasVal = (document.getElementById("reprogNotas") as HTMLTextAreaElement).value.trim();
    try {
      const r = await api(`/agenda/${id}/reprogramar`, "PATCH", {
        fechaVisita: fechaObj.toISOString(),
        notas: notasVal || null,
      });
      dlgReprog.close(); aviso(r.mensaje); cargar();
    } catch (e) { aviso((e as Error).message, "error"); }
  });

  if (modo === "usuario") {
    const sel = document.getElementById("visitaPropiedad") as HTMLSelectElement;
    const fecha = document.getElementById("visitaFecha") as HTMLInputElement;
    async function abrir(preseleccion?: string | null) {
      if (!sel.options.length) {
        const res = await fetch("/backend/api/propiedades");
        const props = res.ok ? await res.json() : [];
        sel.innerHTML = props.map((p: any) => `<option value="${Number(p.propiedadID)}">${esc(p.titulo)}${p.ciudad ? " · " + esc(p.ciudad) : ""}</option>`).join("");
      }
      if (preseleccion) sel.value = preseleccion;
      const min = new Date(Date.now() + 2 * 3600 * 1000); min.setMinutes(min.getMinutes() - min.getTimezoneOffset());
      fecha.min = min.toISOString().slice(0, 16);
      dlg.showModal();
    }
    document.getElementById("btnNuevaVisita")!.addEventListener("click", () => abrir());
    document.getElementById("btnCerrarVisita")!.addEventListener("click", () => dlg.close());
    document.getElementById("formVisita")!.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      const fechaObj = new Date(fecha.value);
      if (!enHorarioAtencion(fechaObj)) { aviso(MSG_HORARIO, "error"); return; }
      try {
        const r = await api("/agenda", "POST", {
          propiedadID: Number(sel.value),
          fechaVisita: fechaObj.toISOString(),
          notas: (document.getElementById("visitaNotas") as HTMLTextAreaElement).value.trim() || undefined,
        });
        dlg.close(); aviso(r.mensaje); cargar();
      } catch (e) { aviso((e as Error).message, "error"); }
    });
    const pre = new URLSearchParams(location.search).get("propiedad");
    if (pre) abrir(pre);
  }
  cargar();
</script>
