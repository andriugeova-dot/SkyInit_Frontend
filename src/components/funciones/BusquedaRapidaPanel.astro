---
/** Paleta de búsqueda rápida por teclado (Ctrl+K) para paneles con muchas secciones (Administrador y SuperAdmin). */
---
<button type="button" class="cmd-fab" id="cmdFab" hidden aria-label="Búsqueda rápida (Ctrl+K)" title="Búsqueda rápida (Ctrl+K)">
  <i class="bi bi-search" aria-hidden="true"></i>
  <span>Ir a…</span>
  <kbd>Ctrl K</kbd>
</button>

<dialog class="cmd-modal" id="cmdModal" aria-label="Búsqueda rápida de secciones">
  <div class="cmd-head">
    <i class="bi bi-search" aria-hidden="true"></i>
    <input type="search" id="cmdInput" placeholder="Buscar sección o acción rápida…" autocomplete="off" />
    <kbd>ESC</kbd>
  </div>
  <div class="cmd-list" id="cmdList" role="listbox"></div>
  <div class="cmd-foot">
    <span><kbd>↑</kbd><kbd>↓</kbd> Navegar</span>
    <span><kbd>Enter</kbd> Abrir</span>
    <span><kbd>Esc</kbd> Cerrar</span>
  </div>
</dialog>

<style is:global>
  .cmd-fab {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 1200;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border-radius: 99px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: var(--pl-ink, var(--fn-ink, #202d3b));
    color: #fff;
    font: inherit;
    font-size: 0.84rem;
    font-weight: 600;
    box-shadow: 0 10px 26px rgba(15, 23, 42, 0.24);
    cursor: pointer;
    transition: transform 0.16s, filter 0.16s;
  }
  .cmd-fab[hidden] { display: none !important; }
  .cmd-fab:hover { transform: translateY(-2px); filter: brightness(1.1); }
  .cmd-fab kbd {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    border-radius: 6px;
    padding: 2px 6px;
    font-size: 0.72rem;
    font-family: inherit;
  }

  .cmd-modal {
    position: fixed;
    top: 14vh;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    width: min(540px, calc(100vw - 24px));
    border: 1px solid var(--pl-linea, #e5e7eb);
    border-radius: 16px;
    padding: 0;
    background: #fff;
    color: var(--pl-ink, #202d3b);
    box-shadow: 0 24px 64px rgba(15, 23, 42, 0.3);
    overflow: hidden;
  }
  .cmd-modal::backdrop { background: rgba(15, 23, 42, 0.32); }
  .cmd-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--pl-linea, #e5e7eb);
  }
  .cmd-head i { color: var(--pl-acc-osc, var(--fn-acc, #202d3b)); font-size: 1.05rem; }
  .cmd-head input {
    flex: 1;
    border: 0;
    outline: 0;
    font: inherit;
    font-size: 0.96rem;
    color: var(--pl-ink, #202d3b);
    background: transparent;
  }
  .cmd-head kbd, .cmd-foot kbd {
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 5px;
    padding: 1px 6px;
    font-size: 0.7rem;
    color: #475569;
    font-family: inherit;
  }
  .cmd-list {
    max-height: 340px;
    overflow-y: auto;
    padding: 8px;
    display: grid;
    gap: 4px;
  }
  .cmd-item {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 10px 12px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--pl-ink, #202d3b);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    font: inherit;
  }
  .cmd-item:hover, .cmd-item.is-selected {
    background: var(--pl-acc-suave, #edf4fa);
    color: var(--pl-ink, #202d3b);
  }
  .cmd-item-ico {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: #f1f5f9;
    color: var(--pl-acc-osc, var(--fn-acc, #202d3b));
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .cmd-item.is-selected .cmd-item-ico {
    background: var(--pl-ink, #202d3b);
    color: var(--pl-acc, #fff);
  }
  .cmd-item-txt { flex: 1; min-width: 0; display: grid; gap: 1px; }
  .cmd-item-txt strong { font-size: 0.9rem; }
  .cmd-item-txt small { font-size: 0.76rem; color: var(--pl-muted, #6b7280); }
  .cmd-empty { padding: 24px 12px; text-align: center; color: var(--pl-muted, #6b7280); font-size: 0.88rem; }
  .cmd-foot {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 9px 16px;
    border-top: 1px solid var(--pl-linea, #e5e7eb);
    background: #f8fafc;
    font-size: 0.74rem;
    color: #64748b;
  }
</style>

<script>
  import { esc } from "./comun";

  const sidebar = document.querySelector<HTMLElement>(".sidebar");
  const rol = sidebar?.dataset.rol ?? "";
  const fab = document.getElementById("cmdFab") as HTMLButtonElement | null;
  const modal = document.getElementById("cmdModal") as HTMLDialogElement | null;
  const input = document.getElementById("cmdInput") as HTMLInputElement | null;
  const list = document.getElementById("cmdList") as HTMLElement | null;

  type CmdItem = { titulo: string; desc: string; href: string; icon: string; palabras: string };

  const RUTAS_POR_ROL: Record<string, CmdItem[]> = {
    Administrador: [
      { titulo: "Dashboard", desc: "Resumen general, alertas y métricas", href: "/admin", icon: "bi-grid-1x2-fill", palabras: "inicio resumen alertas" },
      { titulo: "Propiedades", desc: "Catálogo, fotos y asignación de agentes", href: "/admin/propiedades", icon: "bi-houses", palabras: "inmuebles casas apartamentos" },
      { titulo: "Proyectos", desc: "Obras y avances de constructoras", href: "/admin/proyectos", icon: "bi-building-fill-up", palabras: "obras desarrollos" },
      { titulo: "Constructoras", desc: "Empresas vinculadas a la inmobiliaria", href: "/admin/constructoras", icon: "bi-hammer", palabras: "empresas socias" },
      { titulo: "Servicios", desc: "Catálogo de servicios de mantenimiento", href: "/admin/servicios", icon: "bi-tools", palabras: "catalogo precios" },
      { titulo: "Solicitudes", desc: "Solicitudes recibidas y exportación CSV", href: "/admin/solicitudes", icon: "bi-envelope-fill", palabras: "peticiones clientes csv" },
      { titulo: "Mantenimiento", desc: "Reenviar solicitudes a constructoras", href: "/admin/mantenimiento", icon: "bi-wrench-adjustable", palabras: "reparaciones" },
      { titulo: "Agentes", desc: "Equipo comercial, citas vencidas y desempeño", href: "/admin/agentes", icon: "bi-person-badge-fill", palabras: "vendedores equipo" },
      { titulo: "Agenda", desc: "Calendario semanal y gestión de citas", href: "/admin/agenda", icon: "bi-calendar-check-fill", palabras: "citas visitas calendario" },
      { titulo: "Notificaciones", desc: "Bandeja de avisos del sistema", href: "/notificaciones", icon: "bi-bell-fill", palabras: "alertas avisos" },
      { titulo: "Mi perfil", desc: "Datos de cuenta y contraseña", href: "/admin/perfil", icon: "bi-person-fill", palabras: "cuenta clave password" },
    ],
    SuperAdmin: [
      { titulo: "Dashboard SuperAdmin", desc: "Resumen global, aprobaciones y actividad", href: "/superadmin", icon: "bi-grid-1x2-fill", palabras: "inicio global aprobaciones actividad" },
      { titulo: "Usuarios", desc: "Cuentas, roles, estados y CSV", href: "/superadmin/usuarios", icon: "bi-people-fill", palabras: "cuentas roles personas csv" },
      { titulo: "Inmobiliarias", desc: "Gestión de inmobiliarias y asignaciones", href: "/superadmin/inmobiliarias", icon: "bi-shop", palabras: "empresas agencias csv" },
      { titulo: "Constructoras", desc: "Constructoras registradas y accesos", href: "/superadmin/constructoras", icon: "bi-hammer", palabras: "empresas obras csv" },
      { titulo: "Notificaciones", desc: "Bandeja de avisos globales", href: "/notificaciones", icon: "bi-bell-fill", palabras: "alertas avisos" },
      { titulo: "Mi perfil", desc: "Datos de cuenta y contraseña", href: "/superadmin/perfil", icon: "bi-person-fill", palabras: "cuenta clave password" },
    ],
  };

  const items = RUTAS_POR_ROL[rol];
  if (items && fab && modal && input && list) {
    fab.hidden = false;
    let visibles = items;
    let indice = 0;

    function render() {
      const q = input!.value.trim().toLowerCase();
      visibles = q
        ? items.filter((it) => `${it.titulo} ${it.desc} ${it.palabras}`.toLowerCase().includes(q))
        : items;
      if (indice >= visibles.length) indice = Math.max(0, visibles.length - 1);

      if (!visibles.length) {
        list!.innerHTML = `<div class="cmd-empty">No se encontraron secciones para “${esc(input!.value)}”.</div>`;
        return;
      }

      list!.innerHTML = visibles.map((it, i) => `
        <a href="${esc(it.href)}" class="cmd-item ${i === indice ? "is-selected" : ""}" data-cmd-idx="${i}" role="option" aria-selected="${i === indice ? "true" : "false"}">
          <span class="cmd-item-ico"><i class="bi ${it.icon}" aria-hidden="true"></i></span>
          <span class="cmd-item-txt">
            <strong>${esc(it.titulo)}</strong>
            <small>${esc(it.desc)}</small>
          </span>
          <i class="bi bi-arrow-return-left" aria-hidden="true" style="opacity:.45;font-size:.82rem"></i>
        </a>
      `).join("");
    }

    function abrir() {
      input!.value = "";
      indice = 0;
      render();
      if (!modal!.open) modal!.showModal();
      setTimeout(() => input!.focus(), 20);
    }

    fab.addEventListener("click", abrir);
    modal.addEventListener("click", (ev) => { if (ev.target === modal) modal.close(); });
    input.addEventListener("input", () => { indice = 0; render(); });
    input.addEventListener("keydown", (ev) => {
      if (ev.key === "ArrowDown") {
        ev.preventDefault();
        if (visibles.length) { indice = (indice + 1) % visibles.length; render(); }
      } else if (ev.key === "ArrowUp") {
        ev.preventDefault();
        if (visibles.length) { indice = (indice - 1 + visibles.length) % visibles.length; render(); }
      } else if (ev.key === "Enter" && visibles[indice]) {
        ev.preventDefault();
        location.href = visibles[indice].href;
      }
    });

    document.addEventListener("keydown", (ev) => {
      if ((ev.ctrlKey || ev.metaKey) && ev.key.toLowerCase() === "k") {
        ev.preventDefault();
        if (modal.open) modal.close();
        else abrir();
      }
    });
  }
</script>
