---
/** Agenda semanal y listado de citas de mantenimiento asignadas al trabajador. */
import "./funciones.css";
interface Props { mostrarCabecera?: boolean }
const { mostrarCabecera = true } = Astro.props;
---
<section class="fn" id="calMantRoot" style="max-width:none;margin-top:0">
  {mostrarCabecera && (
    <div class="fn-head" style="margin-bottom:14px">
      <div>
        <h2 style="font-size:1.2rem;font-weight:700;margin:0">Agenda de citas</h2>
        <p>Visualiza las fechas, horas y detalles de los servicios programados que tienes asignados.</p>
      </div>
    </div>
  )}

  <div class="fn-stats" id="agStats"></div>

  <div class="fn-card" style="margin-bottom:18px">
    <div class="cal-barra">
      <div class="fn-acciones">
        <button class="fn-btn fn-btn--sec fn-btn--mini" id="calPrev" type="button" aria-label="Semana anterior">
          <i class="bi bi-chevron-left" aria-hidden="true"></i>
        </button>
        <button class="fn-btn fn-btn--sec fn-btn--mini" id="calHoy" type="button">Hoy</button>
        <button class="fn-btn fn-btn--sec fn-btn--mini" id="calNext" type="button" aria-label="Semana siguiente">
          <i class="bi bi-chevron-right" aria-hidden="true"></i>
        </button>
      </div>
      <strong id="calTitulo"></strong>
    </div>
    <div class="cal-leyenda" aria-label="Colores de la agenda">
      <span><i class="cal-color cal-color--pend"></i> Pendiente</span>
      <span><i class="cal-color cal-color--prog"></i> En proceso</span>
      <span><i class="cal-color cal-color--ok"></i> Finalizada</span>
    </div>
    <div class="cal-wrap">
      <div class="cal" id="cal" role="grid" aria-label="Agenda semanal"></div>
    </div>
  </div>

  <section class="tr-panel-section" aria-label="Todas las citas">
    <div class="tr-section-toolbar cal-lista-head" style="margin-bottom:0">
      <div class="tr-section-heading">
        <h2>Todas las citas</h2>
        <p>Filtra por estado, busca por cliente o exporta a CSV.</p>
      </div>
      <div class="cal-lista-filtros">
        <input type="search" id="calBuscar" placeholder="Buscar cliente, servicio o dirección…" aria-label="Buscar citas" />
        <select id="calFiltroEstado" aria-label="Filtrar por estado">
          <option value="">Todos los estados</option>
          <option value="pend">Pendiente</option>
          <option value="prog">En proceso</option>
          <option value="ok">Finalizada</option>
        </select>
        <button type="button" class="fn-btn fn-btn--sec fn-btn--mini" id="calExportCsv">
          <i class="bi bi-download" aria-hidden="true"></i> Exportar CSV
        </button>
      </div>
    </div>
    <div id="agLista"></div>
  </section>

  <dialog class="fn-modal" id="calDetalleModal" aria-labelledby="calModalTitulo">
    <div class="fn-modal-cuerpo">
      <div>
        <h2 id="calModalTitulo">Detalle de la cita</h2>
        <small id="calModalSub"></small>
      </div>
      <div id="calModalContenido"></div>
      <div class="fn-modal-pie">
        <button class="fn-btn fn-btn--sec" type="button" id="calModalCerrar">Cerrar</button>
      </div>
    </div>
  </dialog>
</section>

<style is:global>
  .cal-barra { display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:12px; }
  .cal-wrap { overflow-x:auto; }
  .cal { display:grid; grid-template-columns:56px repeat(7,minmax(118px,1fr)); min-width:880px; border:1px solid var(--fn-line); border-radius:10px; overflow:hidden; }
  .cal-cab { background:#f8fafc; padding:8px 6px; text-align:center; font-size:.8rem; font-weight:600; border-bottom:1px solid var(--fn-line); border-left:1px solid var(--fn-line); }
  .cal-cab:first-child { border-left:0; }
  .cal-cab--hoy { background:var(--tr-ink, var(--fn-acc)); color:#fff; }
  .cal-hora { font-size:.72rem; color:var(--fn-muted); text-align:right; padding:4px 6px; border-top:1px solid var(--fn-line); font-variant-numeric:tabular-nums; }
  .cal-celda { min-height:46px; border-top:1px solid var(--fn-line); border-left:1px solid var(--fn-line); padding:2px; display:grid; gap:2px; align-content:start; }
  .cal-celda:hover { background:#f8fafc; }
  .cal-cita { border:0; border-left:3px solid var(--fn-acc); background:#eef3f8; border-radius:6px; padding:3px 6px; font-size:.74rem; text-align:left; cursor:pointer; line-height:1.25; color:inherit; width:100%; }
  .cal-cita b { display:block; }
  .cal-cita--pend { border-left-color:#c08a12; background:#fbf3df; }
  .cal-cita--prog { border-left-color:#1f5fa8; background:#e3eefb; }
  .cal-cita--ok { border-left-color:#1b6e3c; background:#dcefe3; }
  .cal-leyenda { display:flex; flex-wrap:wrap; gap:6px 16px; font-size:.8rem; color:var(--fn-muted); margin-bottom:10px; }
  .cal-leyenda span { display:inline-flex; align-items:center; gap:6px; }
  .cal-color { width:12px; height:12px; border-radius:3px; display:inline-block; }
  .cal-color--pend { background:#c08a12; }
  .cal-color--prog { background:#1f5fa8; }
  .cal-color--ok { background:#1b6e3c; }

  .cal-lista-head {
    display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:12px;
  }
  .cal-lista-filtros { display:flex; flex-wrap:wrap; gap:8px; align-items:center; }
  .cal-lista-filtros input, .cal-lista-filtros select {
    height:34px; border:1px solid var(--fn-line); border-radius:8px; padding:0 10px; font:inherit; font-size:.84rem; background:#fff; color:var(--fn-ink);
  }
  .cal-lista-filtros input { min-width:220px; }

  .cal-modal-card { display:grid; gap:14px; }
  .cal-modal-top { display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; }
  .cal-cita-hora {
    display:inline-flex; align-items:center; gap:6px; font-size:.82rem; font-weight:700;
    padding:4px 10px; border-radius:99px; background:var(--tr-acento-suave, #f0fdfa); color:var(--tr-oro-osc, var(--fn-acc));
  }
  .cal-cita-meta { margin:0; padding:0; list-style:none; display:grid; gap:8px; font-size:.9rem; color:var(--tr-ink, var(--fn-ink)); }
  .cal-cita-meta li { display:flex; gap:9px; align-items:baseline; }
  .cal-cita-meta i { color:var(--tr-oro, var(--fn-acc)); flex-shrink:0; }
  .cal-avance-box {
    border-top:1px solid var(--fn-line); padding-top:12px; display:grid; gap:10px;
  }
  .cal-avance-box h3 { margin:0; font-size:.95rem; font-weight:700; }
</style>

<script>
  import { api, esc, fechaHora, aviso, exportarCsv, urlComoLlegar } from "./comun";

  const cal = document.getElementById("cal")!;
  const stats = document.getElementById("agStats")!;
  const lista = document.getElementById("agLista")!;
  const calTitulo = document.getElementById("calTitulo")!;
  const modal = document.getElementById("calDetalleModal") as HTMLDialogElement;
  const modalTitulo = document.getElementById("calModalTitulo")!;
  const modalSub = document.getElementById("calModalSub")!;
  const modalContenido = document.getElementById("calModalContenido")!;
  const inputBuscar = document.getElementById("calBuscar") as HTMLInputElement;
  const selEstado = document.getElementById("calFiltroEstado") as HTMLSelectElement;

  const FINAL = [3, 6];
  const HORAS = Array.from({ length: 13 }, (_, i) => i + 7);
  let trabajos: any[] = [];
  let visiblesActuales: { item: any; idx: number; fecha: Date | null }[] = [];
  let lunes = inicioSemana(new Date());

  function inicioSemana(d: Date): Date {
    const r = new Date(d);
    r.setHours(0, 0, 0, 0);
    r.setDate(r.getDate() - ((r.getDay() + 6) % 7));
    return r;
  }

  function fechaCitaDe(t: any): Date | null {
    const raw = t.fechaAsignacion ?? t.fechaReenvio ?? t.fechaSolicitud;
    if (!raw) return null;
    const d = new Date(raw);
    return Number.isNaN(d.getTime()) ? null : d;
  }

  function estadoDe(t: any): "pend" | "prog" | "ok" {
    if (FINAL.includes(t.estadoReparacionID)) return "ok";
    if (t.estadoReparacionID === 2) return "prog";
    return "pend";
  }

  function claseChip(t: any): string {
    const e = estadoDe(t);
    if (e === "ok") return "fn-chip--ok";
    if (e === "prog") return "fn-chip--prog";
    return "fn-chip--pend";
  }

  function hora(d: Date): string {
    return d.toLocaleTimeString("es-CO", { hour: "2-digit", minute: "2-digit" });
  }

  function pintarCalendario() {
    const dias = Array.from({ length: 7 }, (_, i) => {
      const d = new Date(lunes);
      d.setDate(d.getDate() + i);
      return d;
    });
    const hoy = new Date();
    hoy.setHours(0, 0, 0, 0);
    calTitulo.textContent = `${dias[0].toLocaleDateString("es-CO", { day: "numeric", month: "short" })} – ${dias[6].toLocaleDateString("es-CO", { day: "numeric", month: "short", year: "numeric" })}`;

    let html = `<div class="cal-cab"></div>` + dias.map((d) =>
      `<div class="cal-cab ${d.getTime() === hoy.getTime() ? "cal-cab--hoy" : ""}">${esc(d.toLocaleDateString("es-CO", { weekday: "short", day: "numeric" }))}</div>`
    ).join("");

    for (const h of HORAS) {
      html += `<div class="cal-hora">${String(h).padStart(2, "0")}:00</div>`;
      for (const d of dias) {
        const citas = trabajos
          .map((item, idx) => ({ item, idx, fecha: fechaCitaDe(item) }))
          .filter((x): x is { item: any; idx: number; fecha: Date } =>
            x.fecha !== null &&
            x.fecha.toDateString() === d.toDateString() &&
            (x.fecha.getHours() === h || (h === 7 && x.fecha.getHours() < 7) || (h === 19 && x.fecha.getHours() > 19))
          );

        html += `<div class="cal-celda" role="gridcell">` + citas.map(({ item, idx, fecha }) => {
          const est = estadoDe(item);
          const sub = item.propiedad || item.cliente || "";
          return `<button type="button" class="cal-cita cal-cita--${est}" title="${esc(item.estado ?? "Pendiente")}" data-cita="${idx}">
            <b>${esc(hora(fecha))} · ${esc(item.servicio)}</b>${sub ? esc(sub) + "<br>" : ""}<em style="font-style:normal;opacity:.8">${esc(item.estado ?? "Pendiente")}</em>
          </button>`;
        }).join("") + `</div>`;
      }
    }
    cal.innerHTML = html;
  }

  function pintarLista() {
    const ahora = new Date();
    const pendientes = trabajos.filter((t) => estadoDe(t) === "pend").length;
    const proceso = trabajos.filter((t) => estadoDe(t) === "prog").length;
    const finalizadas = trabajos.filter((t) => estadoDe(t) === "ok").length;
    const proximas = trabajos.filter((t) => {
      const f = fechaCitaDe(t);
      return estadoDe(t) !== "ok" && f !== null && f > ahora;
    }).length;

    stats.innerHTML = `
      <div class="fn-stat"><b>${proximas}</b><span>Próximas</span></div>
      <div class="fn-stat ${pendientes ? "fn-stat--alerta" : ""}"><b>${pendientes}</b><span>Pendientes</span></div>
      <div class="fn-stat"><b>${proceso}</b><span>En proceso</span></div>
      <div class="fn-stat"><b>${finalizadas}</b><span>Finalizadas</span></div>
    `;

    const q = inputBuscar.value.trim().toLowerCase();
    const estFiltro = selEstado.value;
    visiblesActuales = trabajos
      .map((item, idx) => ({ item, idx, fecha: fechaCitaDe(item) }))
      .filter(({ item }) => {
        if (estFiltro && estadoDe(item) !== estFiltro) return false;
        if (!q) return true;
        const texto = [item.servicio, item.cliente, item.propiedad, item.direccion, item.ciudad, item.constructora].filter(Boolean).join(" ").toLowerCase();
        return texto.includes(q);
      })
      .sort((a, b) => (b.fecha?.getTime() ?? 0) - (a.fecha?.getTime() ?? 0));

    if (!visiblesActuales.length) {
      lista.innerHTML = `<div class="fn-vacio"><i class="bi bi-calendar-week" aria-hidden="true"></i>${
        trabajos.length ? "No hay citas que coincidan con el filtro aplicado." : "Aún no tienes citas de mantenimiento asignadas."
      }</div>`;
      return;
    }

    lista.innerHTML = `<div class="fn-tabla-wrap"><table class="fn-tabla"><thead><tr>
      <th>Fecha</th><th>Servicio</th><th>Propiedad</th><th>Cliente</th><th>Estado</th><th></th></tr></thead><tbody>` +
      visiblesActuales.map(({ item, idx, fecha }) => {
        const ubicacion = [item.direccion, item.ciudad].filter(Boolean).join(", ");
        const mapsUrl = urlComoLlegar(item);
        return `<tr>
          <td>${fecha ? esc(fechaHora(fecha.toISOString())) : "—"}</td>
          <td><strong>${esc(item.servicio)}</strong>${item.constructora ? `<br><small class="fn-muted">${esc(item.constructora)}</small>` : ""}</td>
          <td><strong>${esc(item.propiedad ?? "—")}</strong>${ubicacion ? `<br><small class="fn-muted">${esc(ubicacion)}</small>` : ""}</td>
          <td>${esc(item.cliente ?? "—")}${item.clienteTelefono ? `<br><small class="fn-muted">${esc(item.clienteTelefono)}</small>` : ""}</td>
          <td><span class="fn-chip ${claseChip(item)}">${esc(item.estado ?? "Pendiente")}</span></td>
          <td><div class="fn-acciones">
            ${mapsUrl ? `<a class="fn-btn fn-btn--sec fn-btn--mini" href="${esc(mapsUrl)}" target="_blank" rel="noopener" title="Abrir en Google Maps"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> Cómo llegar</a>` : ""}
            <button class="fn-btn fn-btn--mini" data-cita="${idx}" type="button"><i class="bi bi-clipboard-check" aria-hidden="true"></i> ${FINAL.includes(item.estadoReparacionID) ? "Ver" : "Gestionar"}</button>
          </div></td>
        </tr>`;
      }).join("") + `</tbody></table></div>`;
  }

  function abrirDetalle(idx: number) {
    const item = trabajos[idx];
    if (!item) return;
    const fecha = fechaCitaDe(item);
    const fin = FINAL.includes(item.estadoReparacionID);
    const ubicacion = [item.propiedad, item.direccion, item.ciudad].filter(Boolean).join(", ");
    const mapsUrl = urlComoLlegar(item);
    const grupo = Array.isArray(item.trabajadores) && item.trabajadores.length
      ? item.trabajadores.map((t: any) => t.nombre).join(", ")
      : "";

    modalTitulo.textContent = item.servicio ?? "Detalle de la cita";
    modalSub.textContent = fecha
      ? fecha.toLocaleDateString("es-CO", { weekday: "long", day: "numeric", month: "long", year: "numeric" })
      : "";

    modalContenido.innerHTML = `
      <div class="cal-modal-card">
        <div class="cal-modal-top">
          <span class="cal-cita-hora"><i class="bi bi-clock" aria-hidden="true"></i> ${fecha ? esc(fechaHora(fecha.toISOString())) : "Sin fecha"}</span>
          <div class="fn-acciones">
            ${mapsUrl ? `<a class="fn-btn fn-btn--sec fn-btn--mini" href="${esc(mapsUrl)}" target="_blank" rel="noopener"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> Cómo llegar</a>` : ""}
            <span class="fn-chip ${claseChip(item)}">${esc(item.estado ?? "Pendiente")}</span>
          </div>
        </div>
        <ul class="cal-cita-meta">
          ${item.servicioDescripcion ? `<li><i class="bi bi-card-text" aria-hidden="true"></i><span>${esc(item.servicioDescripcion)}</span></li>` : ""}
          ${ubicacion ? `<li><i class="bi bi-geo-alt" aria-hidden="true"></i><span>${esc(ubicacion)}</span></li>` : ""}
          <li><i class="bi bi-person" aria-hidden="true"></i><span>${esc(item.cliente ?? "Sin cliente")}${item.clienteTelefono ? " · " + esc(item.clienteTelefono) : ""}</span></li>
          ${item.constructora ? `<li><i class="bi bi-hammer" aria-hidden="true"></i><span>${esc(item.constructora)}</span></li>` : ""}
          ${grupo ? `<li><i class="bi bi-people" aria-hidden="true"></i><span>Equipo: ${esc(grupo)}</span></li>` : ""}
          ${item.notas ? `<li><i class="bi bi-chat-left-text" aria-hidden="true"></i><span>${esc(item.notas)}</span></li>` : ""}
        </ul>
        ${fin ? `<p class="fn-muted" style="margin:0">Este trabajo ya se encuentra finalizado.</p>` : `
          <div class="cal-avance-box">
            <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap">
              <h3>Actualizar estado / registrar avance</h3>
              ${item.estadoReparacionID !== 2 ? `<button type="button" class="fn-btn fn-btn--sec fn-btn--mini" id="calPasarProceso" data-sol-id="${Number(item.solicitudID)}"><i class="bi bi-play-fill" aria-hidden="true"></i> Pasar a En proceso</button>` : ""}
            </div>
            <form class="fn-form" id="calAvanceForm" data-sol-id="${Number(item.solicitudID)}">
              <label>Nuevo estado
                <select id="calAvanceEstado">
                  <option value="2" ${item.estadoReparacionID === 2 ? "selected" : ""}>En proceso</option>
                  <option value="3">Finalizado</option>
                </select>
              </label>
              <label>Comentario del avance
                <textarea id="calAvanceComentario" rows="2" maxlength="2000" placeholder="Describe el trabajo realizado o novedades…" required></textarea>
              </label>
              <div><button class="fn-btn fn-btn--mini" type="submit"><i class="bi bi-check2-circle" aria-hidden="true"></i> Guardar avance</button></div>
            </form>
          </div>
        `}
      </div>
    `;
    modal.showModal();
  }

  async function cargarDatos() {
    try {
      const d = await api("/mantenimiento/trabajador");
      trabajos = d.trabajos ?? [];
      pintarCalendario();
      pintarLista();
    } catch (e) {
      lista.innerHTML = `<div class="fn-vacio">${esc((e as Error).message)}</div>`;
      pintarCalendario();
    }
  }

  modalContenido.addEventListener("click", async (ev) => {
    const btnProc = (ev.target as HTMLElement).closest<HTMLButtonElement>("#calPasarProceso");
    if (!btnProc) return;
    btnProc.disabled = true;
    try {
      const r = await api(`/mantenimiento/trabajador/${btnProc.dataset.solId}/avance`, "POST", {
        estadoReparacionID: 2,
        comentario: "Trabajo iniciado desde la agenda.",
      });
      aviso(r.mensaje ?? "Estado actualizado a En proceso");
      modal.close();
      await cargarDatos();
    } catch (e) {
      aviso((e as Error).message, "error");
      btnProc.disabled = false;
    }
  });

  modalContenido.addEventListener("submit", async (ev) => {
    const f = (ev.target as HTMLElement).closest<HTMLFormElement>("#calAvanceForm");
    if (!f) return;
    ev.preventDefault();
    const comentario = (document.getElementById("calAvanceComentario") as HTMLTextAreaElement).value.trim();
    const estadoReparacionID = Number((document.getElementById("calAvanceEstado") as HTMLSelectElement).value);
    try {
      const r = await api(`/mantenimiento/trabajador/${f.dataset.solId}/avance`, "POST", { comentario, estadoReparacionID });
      aviso(r.mensaje ?? "Avance guardado");
      modal.close();
      await cargarDatos();
    } catch (e) {
      aviso((e as Error).message, "error");
    }
  });

  document.addEventListener("click", (ev) => {
    const btn = (ev.target as HTMLElement).closest<HTMLElement>("[data-cita]");
    if (!btn?.dataset.cita) return;
    abrirDetalle(Number(btn.dataset.cita));
  });

  inputBuscar.addEventListener("input", pintarLista);
  selEstado.addEventListener("change", pintarLista);
  document.getElementById("calExportCsv")!.addEventListener("click", () => {
    exportarCsv(
      "agenda-trabajador.csv",
      ["Fecha", "Servicio", "Propiedad", "Dirección", "Ciudad", "Cliente", "Teléfono", "Estado"],
      visiblesActuales.map(({ item, fecha }) => [
        fecha ? fechaHora(fecha.toISOString()) : "",
        item.servicio, item.propiedad, item.direccion, item.ciudad, item.cliente, item.clienteTelefono, item.estado ?? "Pendiente",
      ]),
    );
  });

  document.getElementById("calModalCerrar")!.addEventListener("click", () => modal.close());
  document.getElementById("calPrev")!.addEventListener("click", () => { lunes.setDate(lunes.getDate() - 7); pintarCalendario(); });
  document.getElementById("calNext")!.addEventListener("click", () => { lunes.setDate(lunes.getDate() + 7); pintarCalendario(); });
  document.getElementById("calHoy")!.addEventListener("click", () => { lunes = inicioSemana(new Date()); pintarCalendario(); });

  cargarDatos();
</script>
