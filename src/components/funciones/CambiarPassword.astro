---
/** Tarjeta "Cambiar contraseña" para los perfiles que no la tenian. */
import "./funciones.css";
---
<section class="fn" style="max-width:720px;margin-top:24px">
  <form class="fn-card fn-form" id="formPassword" autocomplete="off">
    <div><h2 style="font-size:1.15rem;font-weight:700;margin:0">Cambiar contraseña</h2>
      <p class="fn-muted" style="margin:4px 0 0;font-size:.9rem">Usa una contraseña que no utilices en otros sitios.</p></div>
    <label>Contraseña actual <input type="password" id="pwActual" data-ojo autocomplete="current-password" required /></label>
    <div class="fn-fila">
      <label>Nueva contraseña <input type="password" id="pwNueva" data-ojo autocomplete="new-password" required /></label>
      <label>Repite la nueva contraseña <input type="password" id="pwConfirmar" data-ojo autocomplete="new-password" required /></label>
    </div>
    <small class="fn-muted">Mínimo 8 caracteres, con mayúscula, minúscula, número y símbolo.</small>
    <div id="pwError" class="fn-chip fn-chip--mal" role="alert" hidden style="white-space:normal;border-radius:10px;padding:8px 12px"></div>
    <div><button class="fn-btn" type="submit" id="pwGuardar"><i class="bi bi-key" aria-hidden="true"></i> Guardar nueva contraseña</button></div>
  </form>
</section>
<script>
  import { api, aviso } from "./comun";
  import { activarOjos } from "./ojo";
  activarOjos();
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const error = document.getElementById("pwError")!;
  document.getElementById("formPassword")?.addEventListener("submit", async (ev) => {
    ev.preventDefault();
    error.hidden = true;
    if ($("pwNueva").value !== $("pwConfirmar").value) { error.textContent = "La nueva contraseña y su confirmación no coinciden."; error.hidden = false; return; }
    const boton = document.getElementById("pwGuardar") as HTMLButtonElement;
    boton.disabled = true;
    try {
      const r = await api("/cuenta/password", "PUT", { actual: $("pwActual").value, nueva: $("pwNueva").value, confirmar: $("pwConfirmar").value });
      (ev.target as HTMLFormElement).reset();
      aviso(r.mensaje);
    } catch (e) { error.textContent = (e as Error).message; error.hidden = false; }
    finally { boton.disabled = false; }
  });
</script>
