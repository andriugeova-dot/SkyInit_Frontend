---
/**
 * Vista detallada de una propiedad, proyecto o servicio, sin salir de la pagina:
 * carrusel de fotos, informacion, "Ver en mapa", calificaciones y comentarios.
 * Se abre con cualquier elemento que tenga data-detalle="propiedad:12" (o proyecto:/servicio:),
 * y tambien con los enlaces de las tarjetas existentes del catalogo.
 */
import "bootstrap-icons/font/bootstrap-icons.min.css";
import "./funciones.css";
---
<dialog class="fn-modal det" id="dlgDetalle" aria-labelledby="detTitulo">
  <button class="det-cerrar" id="detCerrar" type="button" aria-label="Cerrar"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
  <div class="det-cuerpo" id="detCuerpo"></div>
</dialog>

<style is:global>
  .det { width:min(980px,calc(100vw - 24px)); }
  .det-cuerpo { display:grid; gap:18px; padding:20px; }
  .det-cerrar { position:sticky; top:10px; margin:10px 10px -46px auto; display:grid; place-items:center; z-index:5; width:36px; height:36px;
                border-radius:50%; border:0; background:rgba(20,28,22,.7); color:#fff; cursor:pointer; float:right; }
  .det-top { display:grid; gap:18px; grid-template-columns:minmax(0,1.15fr) minmax(0,1fr); align-items:start; }
  .det-car { position:relative; border-radius:12px; overflow:hidden; background:#e9e6dc; aspect-ratio:4/3; }
  .det-car img { width:100%; height:100%; object-fit:cover; display:block; }
  .det-car-vacio { display:grid; place-items:center; height:100%; color:#8a8f86; font-size:2.6rem; }
  .det-flecha { position:absolute; top:50%; transform:translateY(-50%); width:38px; height:38px; border-radius:50%; border:0;
                background:rgba(255,255,255,.88); color:#222; cursor:pointer; display:grid; place-items:center; }
  .det-flecha:hover { background:#fff; }
  .det-flecha--izq { left:10px; } .det-flecha--der { right:10px; }
  .det-puntos { position:absolute; left:0; right:0; bottom:10px; display:flex; justify-content:center; gap:6px; }
  .det-punto { width:9px; height:9px; border-radius:50%; border:0; padding:0; background:rgba(255,255,255,.55); cursor:pointer; }
  .det-punto[aria-current="true"] { background:#fff; transform:scale(1.25); }
  .det-contador { position:absolute; top:10px; left:10px; background:rgba(0,0,0,.6); color:#fff; font-size:.75rem; padding:2px 8px; border-radius:99px; }
  .det-info { display:grid; gap:10px; min-width:0; }
  .det-info > .fn-chip { justify-self:start; }
  .det-info h2 { font-size:1.4rem; font-weight:700; margin:0; overflow-wrap:anywhere; }
  .det-precio { font-size:1.35rem; font-weight:700; color:var(--fn-acc); }
  .det-datos { display:grid; gap:6px; margin:0; padding:0; list-style:none; font-size:.92rem; }
  .det-datos li { display:flex; gap:8px; align-items:baseline; }
  .det-datos i { color:var(--fn-acc); }
  .det-desc { margin:0; white-space:pre-line; overflow-wrap:anywhere; }
  .det-seccion { border-top:1px solid var(--fn-line); padding-top:16px; display:grid; gap:10px; }
  .det-seccion h3 { font-size:1.05rem; font-weight:700; margin:0; }
  #detMapa { height:300px; border-radius:12px; border:1px solid var(--fn-line); z-index:0; }
  .det-estrellas { display:inline-flex; gap:2px; color:#d9a520; font-size:1.05rem; vertical-align:middle; }
  .det-votar { display:inline-flex; gap:4px; }
  .det-votar button { border:0; background:none; padding:2px; font-size:1.5rem; color:#d9a520; cursor:pointer; line-height:1; }
  .det-votar button:focus-visible { outline:2px solid var(--fn-acc); border-radius:4px; }
  .det-coment { display:grid; gap:10px; margin:0; padding:0; list-style:none; }
  .det-coment li { background:#faf9f5; border:1px solid var(--fn-line); border-radius:10px; padding:10px 12px; }
  .det-coment small { color:var(--fn-muted); }
  .det-coment p { margin:4px 0 0; white-space:pre-line; overflow-wrap:anywhere; }
  .det-pin { width:26px; height:26px; border-radius:50% 50% 50% 0; transform:rotate(-45deg); border:2px solid #fff; background:var(--fn-acc); box-shadow:0 2px 6px rgba(0,0,0,.4); }
  [data-detalle] { cursor:pointer; }
  @media (max-width:760px){ .det-top { grid-template-columns:1fr; } }
</style>

<script>
  import { api, esc, urlArchivo, fechaHora, fechaCorta, aviso } from "./comun";

  const dlg = document.getElementById("dlgDetalle") as HTMLDialogElement;
  const cuerpo = document.getElementById("detCuerpo")!;
  type Tipo = "propiedad" | "proyecto" | "servicio";
  let actual: { tipo: Tipo; id: number } | null = null;
  let datos: any = null;
  let foto = 0;
  let mapa: any = null;

  const pesos = (v: unknown) => new Intl.NumberFormat("es-CO", { style: "currency", currency: "COP", maximumFractionDigits: 0 }).format(Number(v) || 0);
  const estrellas = (n: number | null) => {
    const v = Math.round(n ?? 0);
    return `<span class="det-estrellas" aria-hidden="true">${[1, 2, 3, 4, 5].map((i) => `<i class="bi ${i <= v ? "bi-star-fill" : "bi-star"}"></i>`).join("")}</span>`;
  };
  const dato = (icono: string, texto: unknown) => texto ? `<li><i class="bi ${icono}" aria-hidden="true"></i><span>${esc(texto)}</span></li>` : "";

  function carrusel(): string {
    const imgs: string[] = datos.imagenes ?? [];
    if (!imgs.length) return `<div class="det-car"><div class="det-car-vacio"><i class="bi bi-image" aria-hidden="true"></i></div></div>`;
    return `<div class="det-car" id="detCar" role="group" aria-roledescription="carrusel" aria-label="Fotos">
      <img id="detFoto" src="${esc(urlArchivo(imgs[0]))}" alt="Foto 1 de ${imgs.length}: ${esc(datos.titulo)}" />
      ${imgs.length > 1 ? `
        <span class="det-contador" id="detContador">1 / ${imgs.length}</span>
        <button class="det-flecha det-flecha--izq" data-mover="-1" type="button" aria-label="Foto anterior"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
        <button class="det-flecha det-flecha--der" data-mover="1" type="button" aria-label="Foto siguiente"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
        <div class="det-puntos">${imgs.map((_, i) => `<button class="det-punto" data-ir="${i}" type="button" aria-label="Ir a la foto ${i + 1}" aria-current="${i === 0}"></button>`).join("")}</div>` : ""}
    </div>`;
  }
  function irA(i: number) {
    const imgs: string[] = datos.imagenes ?? [];
    if (!imgs.length) return;
    foto = (i + imgs.length) % imgs.length;
    const img = document.getElementById("detFoto") as HTMLImageElement;
    img.src = urlArchivo(imgs[foto]); img.alt = `Foto ${foto + 1} de ${imgs.length}: ${datos.titulo}`;
    const c = document.getElementById("detContador"); if (c) c.textContent = `${foto + 1} / ${imgs.length}`;
    cuerpo.querySelectorAll<HTMLElement>(".det-punto").forEach((p, n) => p.setAttribute("aria-current", String(n === foto)));
  }

  function bloqueInfo(): string {
    const d = datos;
    if (d.tipo === "propiedad") return `
      <span class="fn-chip fn-chip--prog">${esc(d.tipoOperacion ?? "Propiedad")}</span>
      <h2 id="detTitulo">${esc(d.titulo)}</h2>
      <div class="det-precio">${esc(pesos(d.precio))}</div>
      <div>${estrellas(d.calificacion.promedio)} <small class="fn-muted">${d.calificacion.total ? `${d.calificacion.promedio} de 5 · ${d.calificacion.total} calificación(es)` : "Sin calificaciones"}</small></div>
      <ul class="det-datos">
        ${dato("bi-geo-alt-fill", [d.direccion, d.ciudad].filter(Boolean).join(", "))}
        ${dato("bi-door-closed", d.habitaciones != null ? `${d.habitaciones} habitaciones` : "")}
        ${dato("bi-building", d.inmobiliaria)}
        ${dato("bi-hammer", d.constructora)}
        ${dato("bi-person-badge", d.agente ? `Agente: ${d.agente}${d.agenteTelefono ? " · " + d.agenteTelefono : ""}` : "")}
        ${dato("bi-calendar3", d.fechaPublicacion ? `Publicada el ${fechaCorta(d.fechaPublicacion)}` : "")}
      </ul>`;
    if (d.tipo === "proyecto") return `
      <span class="fn-chip fn-chip--prog">${esc(d.estado ?? "Proyecto")}</span>
      <h2 id="detTitulo">${esc(d.titulo)}</h2>
      <div><div style="display:flex;justify-content:space-between;font-size:.9rem"><span>Avance de obra</span><strong>${Number(d.avance).toFixed(0)} %</strong></div>
        <div class="fn-barra"><span style="width:${Math.min(100, Number(d.avance) || 0)}%"></span></div></div>
      <ul class="det-datos">
        ${dato("bi-geo-alt-fill", d.ubicacion)}
        ${dato("bi-hammer", d.constructora)}
        ${dato("bi-building", d.inmobiliaria)}
        ${dato("bi-calendar-event", d.fechaInicio ? `Inicio: ${fechaCorta(d.fechaInicio)}` : "")}
        ${dato("bi-flag-fill", d.fechaFin ? `Entrega estimada: ${fechaCorta(d.fechaFin)}` : "")}
      </ul>`;
    return `
      <span class="fn-chip fn-chip--ok">Servicio</span>
      <h2 id="detTitulo">${esc(d.titulo)}</h2>
      <div class="det-precio">Desde ${esc(pesos(d.precio))}</div>
      <div>${estrellas(d.calificacion.promedio)} <small class="fn-muted">${d.calificacion.total ? `${d.calificacion.promedio} de 5 · ${d.calificacion.total} calificación(es)` : "Sin calificaciones"}</small></div>
      <ul class="det-datos">${dato("bi-building", d.inmobiliaria)}</ul>`;
  }

  function bloqueOpiniones(): string {
    const d = datos;
    if (d.tipo === "proyecto") {
      return d.avances?.length ? `<section class="det-seccion"><h3>Avances registrados</h3><ul class="fn-linea">${d.avances.map((a: any) =>
        `<li><strong>${Number(a.porcentaje).toFixed(0)} %</strong> ${esc(a.nota ?? "")}<small>${esc(fechaHora(a.fecha))}</small></li>`).join("")}</ul></section>` : "";
    }
    const login = `/login?redirect=${encodeURIComponent(location.pathname + location.search)}`;
    return `
      <section class="det-seccion">
        <h3>Tu calificación</h3>
        ${d.autenticado ? `<div class="det-votar" role="radiogroup" aria-label="Calificar de 1 a 5 estrellas">${[1, 2, 3, 4, 5].map((i) =>
            `<button type="button" data-voto="${i}" role="radio" aria-checked="${d.calificacion.mia === i}" aria-label="${i} estrella${i > 1 ? "s" : ""}"><i class="bi ${i <= (d.calificacion.mia ?? 0) ? "bi-star-fill" : "bi-star"}" aria-hidden="true"></i></button>`).join("")}</div>
          <small class="fn-muted">${d.calificacion.mia ? `Calificaste con ${d.calificacion.mia} de 5. Puedes cambiarla.` : "Elige de 1 a 5 estrellas."}</small>`
          : `<p class="fn-muted" style="margin:0"><a href="${esc(login)}">Inicia sesión</a> para calificar y comentar.</p>`}
      </section>
      <section class="det-seccion">
        <h3>Comentarios (${d.comentarios.length})</h3>
        ${d.autenticado ? `<form class="fn-form" id="detFormComentario">
            <label>Escribe tu comentario<textarea id="detComentario" rows="2" maxlength="1000" required minlength="3"></textarea></label>
            <div><button class="fn-btn" type="submit"><i class="bi bi-send" aria-hidden="true"></i> Publicar</button></div></form>` : ""}
        ${d.comentarios.length ? `<ul class="det-coment">${d.comentarios.map((c: any) => `
            <li><strong>${esc(c.autor)}</strong> <small>· ${esc(fechaHora(c.fecha))}</small>
              ${c.mio ? `<button class="fn-btn fn-btn--mal fn-btn--mini" data-borrar-comentario="${Number(c.comentarioID)}" type="button" style="float:right" aria-label="Eliminar mi comentario"><i class="bi bi-trash" aria-hidden="true"></i></button>` : ""}
              <p>${esc(c.contenido)}</p></li>`).join("")}</ul>`
          : `<p class="fn-muted" style="margin:0">Todavía no hay comentarios.</p>`}
      </section>`;
  }

  function pintar() {
    const d = datos;
    const tieneMapa = d.latitud != null && d.longitud != null;
    const mapaAbierto = !!document.getElementById("detMapa");
    cuerpo.innerHTML = `
      <div class="det-top">${carrusel()}<div class="det-info">${bloqueInfo()}
        <div class="fn-acciones">
          ${d.tipo !== "servicio" ? `<button class="fn-btn fn-btn--sec" id="detVerMapa" type="button" ${tieneMapa ? "" : "disabled title=\"Aún no tiene ubicación registrada\""}><i class="bi bi-geo-alt" aria-hidden="true"></i> ${tieneMapa ? "Ver en mapa" : "Sin ubicación"}</button>` : ""}
          ${d.tipo === "propiedad" ? `<a class="fn-btn" href="/usuario/agenda?propiedad=${Number(d.id)}"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Agendar visita</a>` : ""}
          ${d.tipo === "servicio" && d.inmobiliariaID ? `<a class="fn-btn" href="/inmobiliarias/${Number(d.inmobiliariaID)}"><i class="bi bi-tools" aria-hidden="true"></i> Solicitar servicio</a>` : ""}
        </div></div></div>
      ${d.descripcion ? `<section class="det-seccion"><h3>Descripción</h3><p class="det-desc">${esc(d.descripcion)}</p></section>` : ""}
      <section class="det-seccion" id="detSeccionMapa" hidden><h3>Ubicación</h3><div id="detMapa"></div></section>
      ${bloqueOpiniones()}`;
    mapa = null; foto = 0;
    if (mapaAbierto) mostrarMapa(false);
  }

  async function mostrarMapa(registrar = true) {
    const d = datos;
    if (d.latitud == null || d.longitud == null) return;
    const seccion = document.getElementById("detSeccionMapa")!;
    seccion.hidden = false;
    if (!mapa) {
      const L = (await import("leaflet")).default;
      await import("leaflet/dist/leaflet.css");
      mapa = L.map("detMapa").setView([d.latitud, d.longitud], 16);
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 19, attribution: "&copy; OpenStreetMap" }).addTo(mapa);
      L.marker([d.latitud, d.longitud], { icon: L.divIcon({ className: "", html: `<div class="det-pin"></div>`, iconSize: [26, 26], iconAnchor: [13, 26] }) }).addTo(mapa);
    }
    setTimeout(() => mapa.invalidateSize(), 60);
    seccion.scrollIntoView({ behavior: "smooth", block: "nearest" });
    if (registrar && d.tipo === "propiedad") {
      fetch("/backend/api/interes", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ propiedadID: d.id, tipo: "mapa" }) }).catch(() => {});
    }
  }

  async function abrir(tipo: Tipo, id: number) {
    actual = { tipo, id };
    cuerpo.innerHTML = `<p class="fn-muted" style="padding:30px;text-align:center">Cargando…</p>`;
    if (!dlg.open) dlg.showModal();
    try {
      const res = await fetch(`/backend/api/detalle/${tipo}/${id}`, { credentials: "same-origin" });
      const json = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(json.error ?? "No se pudo cargar el detalle");
      datos = json; pintar();
    } catch (e) {
      cuerpo.innerHTML = `<div class="fn-vacio" style="margin:30px"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i>${esc((e as Error).message)}</div>`;
    }
  }
  (window as any).abrirDetalle = abrir;

  document.getElementById("detCerrar")!.addEventListener("click", () => dlg.close());
  dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener("keydown", (e) => {
    if (e.target instanceof HTMLTextAreaElement) return;
    if (e.key === "ArrowLeft") irA(foto - 1);
    if (e.key === "ArrowRight") irA(foto + 1);
  });

  cuerpo.addEventListener("click", async (ev) => {
    const t = ev.target as HTMLElement;
    const mover = t.closest<HTMLElement>("[data-mover]"); if (mover) return irA(foto + Number(mover.dataset.mover));
    const ir = t.closest<HTMLElement>("[data-ir]"); if (ir) return irA(Number(ir.dataset.ir));
    if (t.closest("#detVerMapa")) return mostrarMapa();
    const voto = t.closest<HTMLElement>("[data-voto]");
    if (voto && actual) {
      try {
        const r = await api("/calificaciones", "POST", { tipo: actual.tipo, id: actual.id, puntaje: Number(voto.dataset.voto) });
        datos.calificacion = r.calificacion; aviso(r.mensaje); pintar();
      } catch (e) { aviso((e as Error).message, "error"); }
      return;
    }
    const borrar = t.closest<HTMLElement>("[data-borrar-comentario]");
    if (borrar && actual) {
      try { await api(`/comentarios/${borrar.dataset.borrarComentario}`, "DELETE"); aviso("Comentario eliminado"); abrir(actual.tipo, actual.id); }
      catch (e) { aviso((e as Error).message, "error"); }
    }
  });
  cuerpo.addEventListener("submit", async (ev) => {
    if ((ev.target as HTMLElement).id !== "detFormComentario" || !actual) return;
    ev.preventDefault();
    const campo = document.getElementById("detComentario") as HTMLTextAreaElement;
    try {
      const r = await api("/comentarios", "POST", { tipo: actual.tipo, id: actual.id, contenido: campo.value.trim() });
      datos.comentarios = r.comentarios; aviso(r.mensaje); pintar();
    } catch (e) { aviso((e as Error).message, "error"); }
  });

  // Apertura: data-detalle="tipo:id" o los enlaces de las tarjetas del catalogo (en fase de captura,
  // para abrir esta vista en lugar del modal antiguo).
  document.addEventListener("click", (ev) => {
    const t = ev.target as HTMLElement;
    if (!t.closest) return;
    let ref: { tipo: Tipo; id: number } | null = null;
    const el = t.closest<HTMLElement>("[data-detalle]");
    if (el) { const [tipo, id] = (el.dataset.detalle ?? "").split(":"); ref = { tipo: tipo as Tipo, id: Number(id) }; }
    const prop = !ref && t.closest<HTMLElement>("a.link-detalle-propiedad[data-id]");
    if (prop) ref = { tipo: "propiedad", id: Number(prop.dataset.id) };
    const proy = !ref && t.closest<HTMLElement>("a.link-detalle-proyecto[data-id], .mini-proyecto-item[data-id]");
    if (proy) ref = { tipo: "proyecto", id: Number(proy.dataset.id) };
    if (!ref || !["propiedad", "proyecto", "servicio"].includes(ref.tipo) || !Number.isInteger(ref.id)) return;
    ev.preventDefault(); ev.stopPropagation();
    abrir(ref.tipo, ref.id);
  }, true);

  // Enlace directo: /propiedades?detalle=propiedad:12
  const directo = new URLSearchParams(location.search).get("detalle");
  if (directo) { const [tipo, id] = directo.split(":"); if (["propiedad", "proyecto", "servicio"].includes(tipo) && Number(id)) abrir(tipo as Tipo, Number(id)); }
</script>
