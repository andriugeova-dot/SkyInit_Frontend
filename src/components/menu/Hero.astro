---
interface Props {
  eyebrow?: string;
  title?: string; // puede traer HTML, ej: 'Encuentra tu <em>hogar ideal</em>'
  subtitle?: string;
  showSearch?: boolean;
  images?: string[];
}

const DEFAULT_IMAGES = [
  "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2000&q=80",
  "https://images.unsplash.com/photo-1568605114967-8130f3a36994?auto=format&fit=crop&w=2000&q=80",
  "https://images.unsplash.com/photo-1570129477492-45c003edd2be?auto=format&fit=crop&w=2000&q=80",
];

const {
  eyebrow = "Especialistas en bienes raíces.",
  title = "Encuentra tu <em>hogar ideal</em> con SkyInit",
  subtitle = "Compra, vende o arrienda con el respaldo de nuestros expertos.",
  showSearch = false,
  images = DEFAULT_IMAGES,
} = Astro.props;
---

<div class="hero-inner" data-hero-images={JSON.stringify(images)}>
  <div class="hero-eyebrow">{eyebrow}</div>
  <h1 set:html={title} />
  <p class="hero-sub">{subtitle}</p>

  {
    showSearch && (
      <>
        <form action="/propiedades" method="get" class="hero-search-bar" role="search" aria-label="Búsqueda rápida de propiedades">
          <div class="hero-search-field">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input
              type="text"
              name="query"
              placeholder="Ciudad, barrio o palabra clave..."
              aria-label="Buscar por ciudad, barrio o palabra clave"
            />
          </div>

          <div class="hero-search-field">
            <i class="bi bi-house-door" aria-hidden="true"></i>
            <select name="tipoOperacion" aria-label="Tipo de operación">
              <option value="">Comprar o arrendar</option>
              <option value="1">En Venta</option>
              <option value="2">En Arriendo</option>
            </select>
          </div>

          <div class="hero-search-field">
            <i class="bi bi-door-open" aria-hidden="true"></i>
            <select name="habitaciones" aria-label="Habitaciones">
              <option value="">Habitaciones</option>
              <option value="1">1 hab.</option>
              <option value="2">2 hab.</option>
              <option value="3">3+ hab.</option>
            </select>
          </div>

          <button type="submit" class="hero-search-btn">
            <i class="bi bi-sliders2" aria-hidden="true"></i>
            Buscar
          </button>
        </form>

        <div class="hero-quick-links">
          <a href="/propiedades" class="hero-quick-pill">
            <i class="bi bi-buildings" aria-hidden="true"></i> Explorar propiedades
          </a>
          <a href="/proyectos" class="hero-quick-pill">
            <i class="bi bi-compass" aria-hidden="true"></i> Proyectos nuevos
          </a>
          <a href="/mapa" class="hero-quick-pill">
            <i class="bi bi-geo-alt" aria-hidden="true"></i> Ver en el mapa
          </a>
        </div>

        <div class="hero-trust-strip" aria-label="Respaldo de SkyInit">
          <div class="hero-trust-item">
            <strong>+12 años</strong>
            <span>Experiencia en bienes raíces</span>
          </div>
          <div class="hero-trust-item">
            <strong>100% Verificadas</strong>
            <span>Inmobiliarias y constructoras aliadas</span>
          </div>
          <div class="hero-trust-item">
            <strong>Gestión 360°</strong>
            <span>Visitas, proyectos y mantenimiento</span>
          </div>
        </div>
      </>
    )
  }
</div>

<script>
  const defaultImages = [
    "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2000&q=80",
    "https://images.unsplash.com/photo-1568605114967-8130f3a36994?auto=format&fit=crop&w=2000&q=80",
    "https://images.unsplash.com/photo-1570129477492-45c003edd2be?auto=format&fit=crop&w=2000&q=80",
  ];
  const heroInner = document.querySelector<HTMLElement>(".hero-inner[data-hero-images]");
  let images = defaultImages;
  if (heroInner?.dataset.heroImages) {
    try {
      const parsed = JSON.parse(heroInner.dataset.heroImages);
      if (Array.isArray(parsed) && parsed.length) images = parsed;
    } catch { /* fallback */ }
  }
  let index = 0;
  const header = document.getElementById("header") as HTMLElement;

  function changeBackground() {
    if (!header) return;
    header.style.backgroundImage = `url(${images[index]})`;
    index = (index + 1) % images.length;
  }
  changeBackground();
  setInterval(changeBackground, 5000);
</script>