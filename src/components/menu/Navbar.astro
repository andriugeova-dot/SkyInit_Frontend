---
import { BACKEND_URL } from "../../utils/config";
import { isAuthenticatedSSR, getTokenSSR, COOKIE_NAME, obtenerRolDesdeToken } from "../../utils/auth";
import "bootstrap-icons/font/bootstrap-icons.min.css";
import "./menu.css";

interface Props {
  /** Si es true, renderiza su propio <header> sólido sin hero.
   *  Si es false (por defecto), se inserta dentro del <header id="header"> de la página. */
  soloNav?: boolean;
}

const { soloNav = false } = Astro.props;

const autenticado = isAuthenticatedSSR(Astro.cookies);
const token = getTokenSSR(Astro.cookies);
const rol = obtenerRolDesdeToken(token) ?? "Usuario";
// Pestaña activa: se resalta la seccion en la que esta el usuario
const ruta = Astro.url.pathname;
const activa = (href: string) => (href === "/" ? ruta === "/" : ruta === href || ruta.startsWith(href + "/")) ? "nav-activo" : undefined;
const panelPorRol: Record<string, string> = { Administrador: "/admin", SuperAdmin: "/superadmin", Agente: "/agente", Constructora: "/constructora", Trabajador: "/trabajador", Usuario: "/usuario" };
const miPanel = panelPorRol[rol] ?? "/usuario";

let nombre = "Usuario";
let foto: string | null = null;

if (token) {
  try {
    const res = await fetch(`${BACKEND_URL}/auth/perfil`, {
      headers: { Cookie: `${COOKIE_NAME}=${token}` },
    });
    if (res.ok) {
      const json = await res.json();
      const u = json.usuario ?? json;
      nombre = u.nombre ?? "Usuario";
      if (u.fotoPerfil) {
        foto = u.fotoPerfil.startsWith("http")
          ? u.fotoPerfil
          : `/backend${u.fotoPerfil.startsWith("/") ? u.fotoPerfil : "/" + u.fotoPerfil}`;
      }
    }
  } catch { /* defaults */ }
}

const iniciales = nombre
  .split(/\s+/)
  .map((p: string) => p[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

{
  soloNav ? (
    <header id="header" class="header--solo-nav" data-rol={rol}>

<div class="topbar">
  <span class="logo">SkyInit</span>

  <button type="button" class="menu-toggle" id="menuToggle" aria-label="Abrir menú"><i class="bi bi-list" aria-hidden="true"></i></button>

  <nav id="menu">
    <a href="/" class={activa("/")} aria-current={activa("/") ? "page" : undefined}>Inicio</a>
    <a href="/propiedades" class={activa("/propiedades")} aria-current={activa("/propiedades") ? "page" : undefined}>Propiedades</a>
    <a href="/proyectos" class={activa("/proyectos")} aria-current={activa("/proyectos") ? "page" : undefined}>Proyectos</a>
    <a href="/servicios" class={activa("/servicios")} aria-current={activa("/servicios") ? "page" : undefined}>Servicios</a>
    <a href="/constructoras" class={activa("/constructoras")} aria-current={activa("/constructoras") ? "page" : undefined}>Constructoras</a>
    <a href="/mapa" class={activa("/mapa")} aria-current={activa("/mapa") ? "page" : undefined}>Mapa</a>

    {autenticado ? (
      <a href="/notificaciones" class="nav-campana" aria-label="Notificaciones"><i class="bi bi-bell-fill" aria-hidden="true"></i><b class="nav-campana-n" data-contador-notif hidden></b></a>
      <div class="user-profile" id="navUserProfile">
        {foto ? (
          <img src={foto} alt="Perfil" class="profile-pic" id="btnUserMenu" referrerpolicy="no-referrer" />
        ) : (
          <button type="button" class="profile-pic profile-iniciales" id="btnUserMenu">
            {iniciales}
          </button>
        )}
        <div id="user-menu" class="user-menu">
          <div class="user-menu-name">{nombre}</div>
          <a href={miPanel}><i class="bi bi-grid-1x2-fill" aria-hidden="true"></i> Mi panel</a>
          <a href="/notificaciones"><i class="bi bi-bell-fill" aria-hidden="true"></i> Notificaciones</a>
          <button type="button" id="btnLogout"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Cerrar sesión</button>
        </div>
      </div>
    ) : (
      <a href="/login" class="btn-registrar">Iniciar Sesión</a>
    )}
  </nav>
</div>
    </header>
  ) : (

<div class="topbar">
  <span class="logo">SkyInit</span>

  <button type="button" class="menu-toggle" id="menuToggle" aria-label="Abrir menú"><i class="bi bi-list" aria-hidden="true"></i></button>

  <nav id="menu">
    <a href="/" class={activa("/")} aria-current={activa("/") ? "page" : undefined}>Inicio</a>
    <a href="/propiedades" class={activa("/propiedades")} aria-current={activa("/propiedades") ? "page" : undefined}>Propiedades</a>
    <a href="/proyectos" class={activa("/proyectos")} aria-current={activa("/proyectos") ? "page" : undefined}>Proyectos</a>
    <a href="/servicios" class={activa("/servicios")} aria-current={activa("/servicios") ? "page" : undefined}>Servicios</a>
    <a href="/constructoras" class={activa("/constructoras")} aria-current={activa("/constructoras") ? "page" : undefined}>Constructoras</a>
    <a href="/mapa" class={activa("/mapa")} aria-current={activa("/mapa") ? "page" : undefined}>Mapa</a>

    {autenticado ? (
      <a href="/notificaciones" class="nav-campana" aria-label="Notificaciones"><i class="bi bi-bell-fill" aria-hidden="true"></i><b class="nav-campana-n" data-contador-notif hidden></b></a>
      <div class="user-profile" id="navUserProfile">
        {foto ? (
          <img src={foto} alt="Perfil" class="profile-pic" id="btnUserMenu" referrerpolicy="no-referrer" />
        ) : (
          <button type="button" class="profile-pic profile-iniciales" id="btnUserMenu">
            {iniciales}
          </button>
        )}
        <div id="user-menu" class="user-menu">
          <div class="user-menu-name">{nombre}</div>
          <a href={miPanel}><i class="bi bi-grid-1x2-fill" aria-hidden="true"></i> Mi panel</a>
          <a href="/notificaciones"><i class="bi bi-bell-fill" aria-hidden="true"></i> Notificaciones</a>
          <button type="button" id="btnLogout"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Cerrar sesión</button>
        </div>
      </div>
    ) : (
      <a href="/login" class="btn-registrar">Iniciar Sesión</a>
    )}
  </nav>
</div>
  )
}

<script>
  import { logoutRequest } from "../../utils/api";
  import { iniciarAvisos } from "../funciones/avisos";

  // Contador y avisos emergentes de notificaciones (solo con sesion iniciada)
  const campanas = [...document.querySelectorAll<HTMLElement>("[data-contador-notif]")];
  if (campanas.length) {
    campanas.forEach((c, i) => { c.id = "navCampana" + i; });
    iniciarAvisos(document.getElementById("header")?.dataset.rol ?? "Usuario", campanas.map((c) => c.id));
  }

  // Toggle menú móvil
  document.getElementById("menuToggle")?.addEventListener("click", () => {
    document.getElementById("menu")?.classList.toggle("active");
  });

  // Toggle menú usuario
  document.getElementById("btnUserMenu")?.addEventListener("click", (e) => {
    e.stopPropagation();
    document.getElementById("user-menu")?.classList.toggle("active");
  });

  document.addEventListener("click", () => {
    document.getElementById("user-menu")?.classList.remove("active");
  });

  // Logout
  document.getElementById("btnLogout")?.addEventListener("click", async () => {
    try { await logoutRequest(); } finally { window.location.href = "/"; }
  });

  // Fallback client-side: si la imagen SSR falla (ej. foto Google bloqueada por error),
  // cargar perfil desde el API del lado cliente y reemplazar por iniciales
  const profileImg = document.querySelector<HTMLImageElement>(".profile-pic[src]");
  if (profileImg) {
    profileImg.addEventListener("error", async () => {
      // Intentar cargar foto nuevamente via API cliente
      try {
        const res = await fetch("/api/perfil", { credentials: "same-origin" });
        if (res.ok) {
          const data = await res.json();
          const u = data.usuario ?? data;
          const nuevaFoto: string | null = u.fotoPerfil
            ? (u.fotoPerfil.startsWith("http") ? u.fotoPerfil : `/backend${u.fotoPerfil.startsWith("/") ? u.fotoPerfil : "/" + u.fotoPerfil}`)
            : null;
          if (nuevaFoto && nuevaFoto !== profileImg.src) {
            profileImg.src = nuevaFoto;
          } else {
            // Mostrar iniciales como fallback
            const nombre: string = u.nombre ?? "U";
            const ini = nombre.split(/\s+/).map((p: string) => p[0]).join("").slice(0, 2).toUpperCase();
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "profile-pic profile-iniciales";
            btn.id = "btnUserMenu";
            btn.textContent = ini;
            btn.addEventListener("click", (e) => {
              e.stopPropagation();
              document.getElementById("user-menu")?.classList.toggle("active");
            });
            profileImg.replaceWith(btn);
          }
        }
      } catch { /* mantener imagen rota */ }
    });
  }
</script>
