---
/** Botón de campana y modal de notificaciones para las vistas del trabajador (excepto notificaciones y perfil). */
---
<button
  type="button"
  class="tr-notif-btn"
  id="trNotifBtn"
  aria-label="Abrir notificaciones"
  aria-haspopup="dialog"
  title="Notificaciones"
>
  <i class="bi bi-bell" aria-hidden="true"></i>
  <span class="tr-notif-badge" id="trNotifBadge" hidden>0</span>
</button>

<dialog class="tr-notif-modal" id="trNotifModal" aria-labelledby="trNotifModalTitulo">
  <div class="tr-notif-head">
    <h2 id="trNotifModalTitulo">Notificaciones</h2>
    <div class="tr-notif-head-acc">
      <button type="button" class="tr-notif-markall" id="trNotifMarkAll">Marcar todas como leídas</button>
      <button type="button" class="tr-notif-close" id="trNotifClose" aria-label="Cerrar notificaciones">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </button>
    </div>
  </div>

  <div class="tr-notif-tabs" role="tablist" aria-label="Filtrar notificaciones">
    <button type="button" class="tr-notif-tab is-active" role="tab" aria-selected="true" data-tab="todas">
      Todas
    </button>
    <button type="button" class="tr-notif-tab" role="tab" aria-selected="false" data-tab="noleidas">
      Sin leer <span id="trNotifTabCount">(0)</span>
    </button>
  </div>

  <div class="tr-notif-list" id="trNotifList">
    <div class="tr-notif-empty">Cargando notificaciones…</div>
  </div>

  <div class="tr-notif-foot">
    <a href="/notificaciones">Ver todas las notificaciones</a>
  </div>
</dialog>

<style is:global>
  .tr-notif-btn {
    position: relative;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.1);
    color: #f8fafc;
    display: inline-grid;
    place-items: center;
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 0.18s, border-color 0.18s, transform 0.18s;
    flex-shrink: 0;
  }
  .tr-notif-btn:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.35);
    transform: translateY(-1px);
  }
  .tr-notif-badge {
    position: absolute;
    top: -5px;
    right: -5px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 99px;
    background: var(--tr-oro, #0d9488);
    color: #fff;
    border: 2px solid var(--tr-ink, #0f172a);
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 14px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  /* Modal estilo tarjeta moderna */
  .tr-notif-modal {
    position: fixed;
    top: 76px;
    right: 28px;
    left: auto;
    bottom: auto;
    margin: 0;
    width: min(440px, calc(100vw - 24px));
    max-height: min(600px, calc(100vh - 100px));
    border: 1px solid var(--tr-linea, #e2e8f0);
    border-radius: 16px;
    padding: 0;
    background: #fff;
    color: var(--tr-ink, #0f172a);
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.22), 0 4px 16px rgba(15, 23, 42, 0.08);
    overflow: hidden;
    display: none;
    flex-direction: column;
  }
  .tr-notif-modal[open] {
    display: flex;
    animation: trNotifIn 0.18s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .tr-notif-modal::backdrop {
    background: transparent;
  }
  @keyframes trNotifIn {
    from { opacity: 0; transform: translateY(-8px) scale(0.98); }
    to { opacity: 1; transform: none; }
  }

  .tr-notif-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 20px 12px;
  }
  .tr-notif-head h2 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--tr-ink, #0f172a);
  }
  .tr-notif-head-acc {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .tr-notif-markall {
    border: 0;
    background: none;
    padding: 4px 6px;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--tr-oro-osc, #0f766e);
    cursor: pointer;
    border-radius: 6px;
  }
  .tr-notif-markall:hover {
    background: var(--tr-acento-suave, #f0fdfa);
    text-decoration: underline;
  }
  .tr-notif-markall:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .tr-notif-close {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    border: 0;
    background: transparent;
    color: var(--tr-muted, #64748b);
    display: grid;
    place-items: center;
    cursor: pointer;
    font-size: 0.9rem;
  }
  .tr-notif-close:hover {
    background: #f1f5f9;
    color: var(--tr-ink, #0f172a);
  }

  .tr-notif-tabs {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 0 20px;
    border-bottom: 1px solid var(--tr-linea, #e2e8f0);
  }
  .tr-notif-tab {
    border: 0;
    background: none;
    padding: 10px 2px;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--tr-muted, #64748b);
    cursor: pointer;
    position: relative;
    transition: color 0.15s;
  }
  .tr-notif-tab:hover {
    color: var(--tr-ink, #0f172a);
  }
  .tr-notif-tab.is-active {
    color: var(--tr-ink, #0f172a);
  }
  .tr-notif-tab.is-active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--tr-ink, #0f172a);
    border-radius: 2px;
  }

  .tr-notif-list {
    overflow-y: auto;
    flex: 1;
    min-height: 160px;
  }
  .tr-notif-item {
    width: 100%;
    border: 0;
    border-bottom: 1px solid #f1f5f9;
    background: #fff;
    padding: 13px 20px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    text-align: left;
    cursor: pointer;
    font: inherit;
    color: inherit;
    transition: background 0.14s;
  }
  .tr-notif-item:last-child {
    border-bottom: 0;
  }
  .tr-notif-item:hover {
    background: var(--tr-crema, #f8fafc);
  }
  .tr-notif-item--unread {
    background: #fcfefd;
  }
  .tr-notif-ico {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--tr-acento-suave, #f0fdfa);
    color: var(--tr-oro-osc, #0f766e);
    display: grid;
    place-items: center;
    font-size: 1rem;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .tr-notif-body {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 2px;
  }
  .tr-notif-body strong {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--tr-ink, #0f172a);
    line-height: 1.3;
  }
  .tr-notif-body p {
    margin: 0;
    font-size: 0.82rem;
    color: var(--tr-muted, #64748b);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tr-notif-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    flex-shrink: 0;
    padding-top: 2px;
  }
  .tr-notif-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tr-oro, #0d9488);
  }
  .tr-notif-meta-top {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .tr-notif-read-one {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    border: 1px solid var(--tr-linea, #e2e8f0);
    background: #fff;
    color: var(--tr-oro-osc, #0f766e);
    display: inline-grid;
    place-items: center;
    cursor: pointer;
    font-size: 0.78rem;
    padding: 0;
  }
  .tr-notif-read-one:hover {
    background: var(--tr-acento-suave, #f0fdfa);
    border-color: var(--tr-oro, #0d9488);
  }
  .tr-notif-time {
    font-size: 0.75rem;
    color: var(--tr-muted, #64748b);
    white-space: nowrap;
  }
  .tr-notif-empty {
    padding: 36px 20px;
    text-align: center;
    color: var(--tr-muted, #64748b);
    font-size: 0.88rem;
  }
  .tr-notif-foot {
    border-top: 1px solid var(--tr-linea, #e2e8f0);
    padding: 11px 20px;
    text-align: center;
    background: var(--tr-crema, #f8fafc);
  }
  .tr-notif-foot a {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--tr-oro-osc, #0f766e);
    text-decoration: none;
  }
  .tr-notif-foot a:hover {
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .tr-notif-modal {
      inset: 0;
      margin: auto;
      width: calc(100vw - 24px);
      max-height: calc(100dvh - 32px);
    }
  }
</style>

<script>
  import { api, esc, aviso } from "../funciones/comun";
  import { iconoNotificacion, enlaceNotificacion } from "../funciones/avisos";

  const btn = document.getElementById("trNotifBtn") as HTMLButtonElement | null;
  const badge = document.getElementById("trNotifBadge") as HTMLElement | null;
  const modal = document.getElementById("trNotifModal") as HTMLDialogElement | null;
  const list = document.getElementById("trNotifList") as HTMLElement | null;
  const tabCount = document.getElementById("trNotifTabCount") as HTMLElement | null;
  const btnMarkAll = document.getElementById("trNotifMarkAll") as HTMLButtonElement | null;
  const btnClose = document.getElementById("trNotifClose") as HTMLButtonElement | null;

  if (btn && badge && modal && list && tabCount && btnMarkAll && btnClose) {
    let tabActual: "todas" | "noleidas" = "todas";
    let notificaciones: any[] = [];
    let noLeidas = 0;

    function tiempoRelativo(iso: string): string {
      const f = new Date(iso);
      if (Number.isNaN(f.getTime())) return "";
      const diffSeg = Math.max(0, Math.floor((Date.now() - f.getTime()) / 1000));
      if (diffSeg < 60) return "Ahora";
      const mins = Math.floor(diffSeg / 60);
      if (mins < 60) return `Hace ${mins} min`;
      const horas = Math.floor(mins / 60);
      if (horas < 24) return `Hace ${horas} h`;
      const dias = Math.floor(horas / 24);
      if (dias === 1) return "Ayer";
      if (dias < 7) return `Hace ${dias} d`;
      return f.toLocaleDateString("es-CO", { day: "numeric", month: "short" });
    }

    function actualizarBadge(cantidad: number) {
      noLeidas = cantidad;
      badge.hidden = cantidad <= 0;
      badge.textContent = cantidad > 99 ? "99+" : String(cantidad);
      tabCount.textContent = `(${cantidad})`;
      btnMarkAll.disabled = cantidad <= 0;
    }

    function renderLista() {
      const visibles = tabActual === "noleidas"
        ? notificaciones.filter((n) => !n.leida)
        : notificaciones;

      if (!visibles.length) {
        list.innerHTML = `<div class="tr-notif-empty">${
          tabActual === "noleidas"
            ? "No tienes notificaciones sin leer."
            : "Aún no tienes notificaciones."
        }</div>`;
        return;
      }

      list.innerHTML = visibles.map((n) => `
        <div class="tr-notif-item ${n.leida ? "" : "tr-notif-item--unread"}" role="button" tabindex="0" data-id="${Number(n.notificacionID)}" data-tipo="${esc(n.tipoNotificacion)}" data-leida="${n.leida ? "1" : "0"}">
          <span class="tr-notif-ico"><i class="bi ${iconoNotificacion(n.tipoNotificacion)}" aria-hidden="true"></i></span>
          <span class="tr-notif-body">
            <strong>${esc(n.titulo)}</strong>
            <p>${esc(n.mensaje)}</p>
          </span>
          <span class="tr-notif-meta">
            <span class="tr-notif-meta-top">
              ${n.leida ? "" : `<button type="button" class="tr-notif-read-one" data-mark-read="${Number(n.notificacionID)}" title="Marcar como leída" aria-label="Marcar como leída"><i class="bi bi-check2" aria-hidden="true"></i></button><span class="tr-notif-dot" aria-label="Sin leer"></span>`}
            </span>
            <span class="tr-notif-time">${esc(tiempoRelativo(n.fechaCreacion))}</span>
          </span>
        </div>
      `).join("");
    }

    async function cargarNotificaciones() {
      try {
        const d = await api("/notificaciones");
        notificaciones = d.notificaciones ?? [];
        actualizarBadge(Number(d.noLeidas ?? 0));
        renderLista();
      } catch (e) {
        list.innerHTML = `<div class="tr-notif-empty">${esc((e as Error).message)}</div>`;
      }
    }

    btn.addEventListener("click", () => {
      cargarNotificaciones();
      modal.showModal();
    });

    btnClose.addEventListener("click", () => modal.close());

    modal.addEventListener("click", (ev) => {
      if (ev.target === modal) modal.close();
    });

    modal.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((tabBtn) => {
      tabBtn.addEventListener("click", () => {
        tabActual = tabBtn.dataset.tab === "noleidas" ? "noleidas" : "todas";
        modal.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((t) => {
          const activo = t === tabBtn;
          t.classList.toggle("is-active", activo);
          t.setAttribute("aria-selected", activo ? "true" : "false");
        });
        renderLista();
      });
    });

    btnMarkAll.addEventListener("click", async () => {
      try {
        await api("/notificaciones/leer-todas", "POST");
        notificaciones = notificaciones.map((n) => ({ ...n, leida: true }));
        actualizarBadge(0);
        renderLista();
        aviso("Notificaciones marcadas como leídas");
      } catch (e) {
        aviso((e as Error).message, "error");
      }
    });

    list.addEventListener("click", async (ev) => {
      const btnRead = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-mark-read]");
      if (btnRead) {
        ev.stopPropagation();
        const id = Number(btnRead.dataset.markRead);
        btnRead.disabled = true;
        try {
          await api(`/notificaciones/${id}/leida`, "PATCH");
          notificaciones = notificaciones.map((n) => (Number(n.notificacionID) === id ? { ...n, leida: true } : n));
          actualizarBadge(Math.max(0, noLeidas - 1));
          renderLista();
          document.dispatchEvent(new CustomEvent("avisos:actualizados", { detail: { noLeidas } }));
        } catch (e) {
          aviso((e as Error).message, "error");
          btnRead.disabled = false;
        }
        return;
      }
      const item = (ev.target as HTMLElement).closest<HTMLElement>("[data-id]");
      if (!item) return;
      const id = Number(item.dataset.id);
      const tipo = item.dataset.tipo ?? "";
      if (item.dataset.leida === "0") {
        api(`/notificaciones/${id}/leida`, "PATCH").catch(() => {});
        notificaciones = notificaciones.map((n) => (Number(n.notificacionID) === id ? { ...n, leida: true } : n));
        actualizarBadge(Math.max(0, noLeidas - 1));
        renderLista();
      }
      const destino = enlaceNotificacion(tipo, "Trabajador");
      if (destino && destino !== location.pathname) {
        modal.close();
        location.href = destino;
      }
    });

    document.addEventListener("avisos:actualizados", (ev) => {
      const detalle = (ev as CustomEvent<{ noLeidas?: number }>).detail;
      if (typeof detalle?.noLeidas === "number") {
        actualizarBadge(detalle.noLeidas);
      }
      if (modal.open) cargarNotificaciones();
    });

    // Carga inicial del contador
    api("/notificaciones?soloNoLeidas=1")
      .then((d) => actualizarBadge(Number(d.noLeidas ?? 0)))
      .catch(() => {});
  }
</script>
