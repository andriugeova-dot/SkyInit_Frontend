---
/** Botón de campana y modal de notificaciones para las vistas del trabajador (excepto notificaciones y perfil). */
---

<button
  type="button"
  class="tr-notif-btn"
  id="trNotifBtn"
  aria-label="Abrir notificaciones"
  aria-haspopup="dialog"
  title="Notificaciones"
>
  <i class="bi bi-bell" aria-hidden="true"></i>
  <span class="tr-notif-badge" id="trNotifBadge" hidden>
    0
  </span>
</button>

<dialog
  class="tr-notif-modal"
  id="trNotifModal"
  aria-labelledby="trNotifModalTitulo"
>
  <div class="tr-notif-head">
    <h2 id="trNotifModalTitulo">Notificaciones</h2>
    <div class="tr-notif-head-acc">
      <button type="button" class="tr-notif-markall" id="trNotifMarkAll">
        Marcar todas como leídas
      </button>
      <button
        type="button"
        class="tr-notif-close"
        id="trNotifClose"
        aria-label="Cerrar notificaciones"
      >
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </button>
    </div>
  </div>

  <div class="tr-notif-tabs" role="tablist" aria-label="Filtrar notificaciones">
    <button
      type="button"
      class="tr-notif-tab is-active"
      role="tab"
      aria-selected="true"
      data-tab="todas"
    >
      Todas
    </button>
    <button
      type="button"
      class="tr-notif-tab"
      role="tab"
      aria-selected="false"
      data-tab="noleidas"
    >
      Sin leer <span id="trNotifTabCount">(0)</span>
    </button>
  </div>

  <div class="tr-notif-list" id="trNotifList">
    <div class="tr-notif-empty">Cargando notificaciones…</div>
  </div>

  <div class="tr-notif-foot" id="trNotifFoot" hidden>
    <button type="button" class="tr-notif-permiso" id="trNotifPermiso">
      <i class="bi bi-bell" aria-hidden="true"></i> Activar avisos del navegador
    </button>
  </div>
</dialog>

<style is:global>
  .tr-notif-btn {
    position: relative;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    border: 1px solid var(--tr-linea-strong, #c5d2dd);
    background: var(--tr-surface, #fcfefd);
    color: var(--tr-ink, #0e1726);
    display: inline-grid;
    place-items: center;
    font-size: 1.05rem;
    cursor: pointer;
    touch-action: manipulation;
    transition:
      background 0.16s ease,
      border-color 0.16s ease,
      transform 0.12s cubic-bezier(0.22, 1, 0.36, 1);
    flex-shrink: 0;
  }
  .tr-notif-btn:hover {
    background: var(--tr-surface-subtle, #edf3f6);
    border-color: var(--tr-ink-2, #324358);
  }
  .tr-notif-btn:active {
    transform: scale(0.96);
  }
  .tr-notif-btn:focus-visible {
    outline: 2px solid var(--tr-oro, #0f766e);
    outline-offset: 2px;
  }
  .tr-notif-badge {
    position: absolute;
    top: -6px;
    right: -6px;
    min-width: 19px;
    height: 19px;
    padding: 0 5px;
    border-radius: 99px;
    background: var(--tr-danger, #b91c1c);
    color: #fff;
    border: 2px solid var(--tr-bg, #f6f9fb);
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 15px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  /* Slide-over sheet lateral con física suave */
  .tr-notif-modal {
    position: fixed;
    top: 0;
    right: 0;
    left: auto;
    bottom: 0;
    margin: 0;
    width: min(440px, 100vw);
    height: 100dvh;
    max-height: 100dvh;
    border: 0;
    border-left: 1px solid var(--tr-linea-strong, #c5d2dd);
    border-radius: 0;
    padding: 0;
    background: var(--tr-surface, #fcfefd);
    color: var(--tr-ink, #0e1726);
    box-shadow: -12px 0 36px rgba(14, 23, 38, 0.14);
    overflow: hidden;
    overscroll-behavior: contain;
    display: none;
    flex-direction: column;
  }
  .tr-notif-modal[open] {
    display: flex;
    animation: trNotifSheetIn 0.24s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .tr-notif-modal::backdrop {
    background: rgba(14, 23, 38, 0.44);
    backdrop-filter: blur(2px);
  }
  @keyframes trNotifSheetIn {
    from {
      opacity: 0.4;
      transform: translateX(32px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .tr-notif-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 20px 20px 14px;
  }
  .tr-notif-head h2 {
    margin: 0;
    font-size: 1.12rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--tr-ink, #0e1726);
  }
  .tr-notif-head-acc {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tr-notif-markall {
    border: 0;
    background: none;
    padding: 5px 8px;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--tr-oro, #0f766e);
    cursor: pointer;
    touch-action: manipulation;
    border-radius: 6px;
  }
  .tr-notif-markall:hover {
    background: var(--tr-acento-suave, #eefbf9);
    text-decoration: underline;
  }
  .tr-notif-markall:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .tr-notif-close {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid var(--tr-linea, #dce5ec);
    background: var(--tr-surface, #fcfefd);
    color: var(--tr-muted, #586c84);
    display: grid;
    place-items: center;
    cursor: pointer;
    touch-action: manipulation;
    font-size: 0.88rem;
  }
  .tr-notif-close:hover {
    background: var(--tr-surface-subtle, #edf3f6);
    color: var(--tr-ink, #0e1726);
  }
  .tr-notif-close:focus-visible,
  .tr-notif-markall:focus-visible,
  .tr-notif-tab:focus-visible,
  .tr-notif-read-one:focus-visible {
    outline: 2px solid var(--tr-oro, #0f766e);
    outline-offset: 2px;
  }

  .tr-notif-tabs {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 0 20px;
    border-bottom: 1px solid var(--tr-linea, #dce5ec);
  }
  .tr-notif-tab {
    border: 0;
    background: none;
    padding: 10px 2px;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--tr-muted, #586c84);
    cursor: pointer;
    touch-action: manipulation;
    position: relative;
    transition: color 0.15s ease;
  }
  .tr-notif-tab:hover,
  .tr-notif-tab.is-active {
    color: var(--tr-ink, #0e1726);
  }
  .tr-notif-tab.is-active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--tr-oro, #0f766e);
    border-radius: 2px;
  }

  .tr-notif-list {
    overflow-y: auto;
    overscroll-behavior: contain;
    flex: 1;
    min-height: 160px;
  }
  .tr-notif-item {
    width: 100%;
    border: 0;
    border-bottom: 1px solid var(--tr-linea, #dce5ec);
    background: var(--tr-surface, #fcfefd);
    padding: 14px 20px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    text-align: left;
    cursor: pointer;
    touch-action: manipulation;
    font: inherit;
    color: inherit;
    transition: background 0.14s ease;
  }
  .tr-notif-item:last-child {
    border-bottom: 0;
  }
  .tr-notif-item:hover {
    background: var(--tr-bg, #f6f9fb);
  }
  .tr-notif-item--unread {
    background: var(--tr-acento-suave, #eefbf9);
  }
  .tr-notif-ico {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--tr-surface-subtle, #edf3f6);
    color: var(--tr-oro, #0f766e);
    display: grid;
    place-items: center;
    font-size: 0.96rem;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .tr-notif-item--unread .tr-notif-ico {
    background: var(--tr-surface, #fcfefd);
    border: 1px solid var(--tr-acento-borde, #99e2d8);
  }
  .tr-notif-body {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 2px;
  }
  .tr-notif-body strong {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--tr-ink, #0e1726);
    line-height: 1.3;
  }
  .tr-notif-body p {
    margin: 0;
    font-size: 0.82rem;
    color: var(--tr-muted, #586c84);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tr-notif-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    flex-shrink: 0;
    padding-top: 2px;
  }
  .tr-notif-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tr-oro, #0f766e);
  }
  .tr-notif-meta-top {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .tr-notif-read-one {
    width: 26px;
    height: 26px;
    border-radius: 6px;
    border: 1px solid var(--tr-linea-strong, #c5d2dd);
    background: var(--tr-surface, #fcfefd);
    color: var(--tr-oro, #0f766e);
    display: inline-grid;
    place-items: center;
    cursor: pointer;
    touch-action: manipulation;
    font-size: 0.8rem;
    padding: 0;
  }
  .tr-notif-read-one:hover {
    background: var(--tr-acento-suave, #eefbf9);
    border-color: var(--tr-oro, #0f766e);
  }
  .tr-notif-time {
    font-size: 0.74rem;
    color: var(--tr-muted, #586c84);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .tr-notif-empty {
    padding: 40px 20px;
    text-align: center;
    color: var(--tr-muted, #586c84);
    font-size: 0.88rem;
  }
  .tr-notif-foot {
    border-top: 1px solid var(--tr-linea, #dce5ec);
    padding: 14px 20px;
    text-align: center;
    background: var(--tr-bg, #f6f9fb);
  }
  .tr-notif-foot[hidden] {
    display: none;
  }
  .tr-notif-permiso {
    border: 1px solid var(--tr-linea-strong, #c5d2dd);
    background: var(--tr-surface, #fcfefd);
    color: var(--tr-ink, #0e1726);
    border-radius: 8px;
    height: 36px;
    padding: 0 14px;
    font: inherit;
    font-size: 0.84rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    touch-action: manipulation;
  }
  .tr-notif-permiso:hover {
    background: var(--tr-surface-subtle, #edf3f6);
    border-color: var(--tr-ink-2, #324358);
  }
  .tr-notif-permiso:focus-visible {
    outline: 2px solid var(--tr-oro, #0f766e);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .tr-notif-btn,
    .tr-notif-modal[open] {
      animation: none;
      transition: none;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .tr-notif-modal::backdrop {
      background: rgba(14, 23, 38, 0.65);
      backdrop-filter: none;
    }
  }
</style>

<script>
  import { api, esc, aviso } from "../funciones/comun";
  import { iconoNotificacion, enlaceNotificacion } from "../funciones/avisos";

  const btn = document.getElementById("trNotifBtn") as HTMLButtonElement | null;
  const badge = document.getElementById("trNotifBadge") as HTMLElement | null;
  const modal = document.getElementById(
    "trNotifModal",
  ) as HTMLDialogElement | null;
  const list = document.getElementById("trNotifList") as HTMLElement | null;
  const tabCount = document.getElementById(
    "trNotifTabCount",
  ) as HTMLElement | null;
  const btnMarkAll = document.getElementById(
    "trNotifMarkAll",
  ) as HTMLButtonElement | null;
  const btnClose = document.getElementById(
    "trNotifClose",
  ) as HTMLButtonElement | null;
  const footPerm = document.getElementById("trNotifFoot") as HTMLElement | null;
  const btnPermiso = document.getElementById(
    "trNotifPermiso",
  ) as HTMLButtonElement | null;

  if (btn && badge && modal && list && tabCount && btnMarkAll && btnClose) {
    let tabActual: "todas" | "noleidas" = "todas";
    let notificaciones: any[] = [];
    let noLeidas = 0;

    function abrirModal() {
      cargarNotificaciones();
      if (!modal!.open) modal!.showModal();
    }

    function tiempoRelativo(iso: string): string {
      const f = new Date(iso);
      if (Number.isNaN(f.getTime())) return "";
      const diffSeg = Math.max(
        0,
        Math.floor((Date.now() - f.getTime()) / 1000),
      );
      if (diffSeg < 60) return "Ahora";
      const mins = Math.floor(diffSeg / 60);
      if (mins < 60) return `Hace ${mins} min`;
      const horas = Math.floor(mins / 60);
      if (horas < 24) return `Hace ${horas} h`;
      const dias = Math.floor(horas / 24);
      if (dias === 1) return "Ayer";
      if (dias < 7) return `Hace ${dias} d`;
      return f.toLocaleDateString("es-CO", { day: "numeric", month: "short" });
    }

    function actualizarBadge(cantidad: number) {
      noLeidas = cantidad;
      badge.hidden = cantidad <= 0;
      badge.textContent = cantidad > 99 ? "99+" : String(cantidad);
      tabCount.textContent = `(${cantidad})`;
      btnMarkAll.disabled = cantidad <= 0;
      const navBadge = document.getElementById("navNotifBadge");
      if (navBadge) {
        navBadge.hidden = cantidad <= 0;
        navBadge.textContent = cantidad > 99 ? "99+" : String(cantidad);
      }
    }

    function renderLista() {
      const visibles =
        tabActual === "noleidas"
          ? notificaciones.filter((n) => !n.leida)
          : notificaciones;

      if (!visibles.length) {
        list.innerHTML = `<div class="tr-notif-empty">${
          tabActual === "noleidas"
            ? "No tienes notificaciones sin leer."
            : "Aún no tienes notificaciones."
        }</div>`;
        return;
      }

      list.innerHTML = visibles
        .map(
          (n) => `
        <div class="tr-notif-item ${n.leida ? "" : "tr-notif-item--unread"}" role="button" tabindex="0" data-id="${Number(n.notificacionID)}" data-tipo="${esc(n.tipoNotificacion)}" data-leida="${n.leida ? "1" : "0"}">
          <span class="tr-notif-ico"><i class="bi ${iconoNotificacion(n.tipoNotificacion)}" aria-hidden="true"></i></span>
          <span class="tr-notif-body">
            <strong>${esc(n.titulo)}</strong>
            <p>${esc(n.mensaje)}</p>
          </span>
          <span class="tr-notif-meta">
            <span class="tr-notif-meta-top">
              ${n.leida ? "" : `<button type="button" class="tr-notif-read-one" data-mark-read="${Number(n.notificacionID)}" title="Marcar como leída" aria-label="Marcar como leída"><i class="bi bi-check2" aria-hidden="true"></i></button><span class="tr-notif-dot" aria-label="Sin leer"></span>`}
            </span>
            <span class="tr-notif-time">${esc(tiempoRelativo(n.fechaCreacion))}</span>
          </span>
        </div>
      `,
        )
        .join("");
    }

    async function cargarNotificaciones() {
      try {
        const d = await api("/notificaciones");
        notificaciones = d.notificaciones ?? [];
        actualizarBadge(Number(d.noLeidas ?? 0));
        renderLista();
      } catch (e) {
        list.innerHTML = `<div class="tr-notif-empty">${esc((e as Error).message)}</div>`;
      }
    }

    btn.addEventListener("click", abrirModal);

    document.addEventListener("click", (ev) => {
      const link = (ev.target as HTMLElement).closest<HTMLAnchorElement>(
        'a[href="/notificaciones"], a[href="/notificaciones/"]',
      );
      if (!link) return;
      const rol = document.querySelector<HTMLElement>(".sidebar")?.dataset.rol;
      if (rol !== "Trabajador") return;
      ev.preventDefault();
      abrirModal();
    });

    btnClose.addEventListener("click", () => modal.close());

    modal.addEventListener("click", (ev) => {
      if (ev.target === modal) modal.close();
    });

    modal
      .querySelectorAll<HTMLButtonElement>("[data-tab]")
      .forEach((tabBtn) => {
        tabBtn.addEventListener("click", () => {
          tabActual = tabBtn.dataset.tab === "noleidas" ? "noleidas" : "todas";
          modal
            .querySelectorAll<HTMLButtonElement>("[data-tab]")
            .forEach((t) => {
              const activo = t === tabBtn;
              t.classList.toggle("is-active", activo);
              t.setAttribute("aria-selected", activo ? "true" : "false");
            });
          renderLista();
        });
      });

    btnMarkAll.addEventListener("click", async () => {
      try {
        await api("/notificaciones/leer-todas", "POST");
        notificaciones = notificaciones.map((n) => ({ ...n, leida: true }));
        actualizarBadge(0);
        renderLista();
        aviso("Notificaciones marcadas como leídas");
      } catch (e) {
        aviso((e as Error).message, "error");
      }
    });

    list.addEventListener("click", async (ev) => {
      const btnRead = (ev.target as HTMLElement).closest<HTMLButtonElement>(
        "[data-mark-read]",
      );
      if (btnRead) {
        ev.stopPropagation();
        const id = Number(btnRead.dataset.markRead);
        btnRead.disabled = true;
        try {
          await api(`/notificaciones/${id}/leida`, "PATCH");
          notificaciones = notificaciones.map((n) =>
            Number(n.notificacionID) === id ? { ...n, leida: true } : n,
          );
          actualizarBadge(Math.max(0, noLeidas - 1));
          renderLista();
          document.dispatchEvent(
            new CustomEvent("avisos:actualizados", { detail: { noLeidas } }),
          );
        } catch (e) {
          aviso((e as Error).message, "error");
          btnRead.disabled = false;
        }
        return;
      }
      const item = (ev.target as HTMLElement).closest<HTMLElement>("[data-id]");
      if (!item) return;
      const id = Number(item.dataset.id);
      const tipo = item.dataset.tipo ?? "";
      if (item.dataset.leida === "0") {
        api(`/notificaciones/${id}/leida`, "PATCH").catch(() => {});
        notificaciones = notificaciones.map((n) =>
          Number(n.notificacionID) === id ? { ...n, leida: true } : n,
        );
        actualizarBadge(Math.max(0, noLeidas - 1));
        renderLista();
      }
      const destino = enlaceNotificacion(tipo, "Trabajador");
      if (destino && destino !== "/notificaciones" && destino !== location.pathname) {
        modal.close();
        location.href = destino;
      }
    });

    document.addEventListener("avisos:actualizados", (ev) => {
      const detalle = (ev as CustomEvent<{ noLeidas?: number }>).detail;
      if (typeof detalle?.noLeidas === "number") {
        actualizarBadge(detalle.noLeidas);
      }
      if (modal.open) cargarNotificaciones();
    });

    if (footPerm && btnPermiso && "Notification" in window && Notification.permission === "default") {
      footPerm.hidden = false;
      btnPermiso.addEventListener("click", async () => {
        const r = await Notification.requestPermission();
        footPerm.hidden = true;
        aviso(
          r === "granted"
            ? "Avisos del navegador activados"
            : "No se activaron los avisos del navegador",
          r === "granted" ? "ok" : "error",
        );
      });
    }

    if (new URLSearchParams(location.search).get("notificaciones") === "1") {
      const params = new URLSearchParams(location.search);
      params.delete("notificaciones");
      const query = params.toString();
      history.replaceState(null, "", location.pathname + (query ? `?${query}` : "") + location.hash);
      abrirModal();
    }

    // Carga inicial del contador
    api("/notificaciones?soloNoLeidas=1")
      .then((d) => actualizarBadge(Number(d.noLeidas ?? 0)))
      .catch(() => {});
  }
</script>
