---
import "../funciones/funciones.css";
import "../funciones/panelUnificado.css";
import NotifModalPanel from "../funciones/NotifModalPanel.astro";
---

<div class="pl-page pl-theme-usuario">
  <header class="pl-hero">
    <div class="pl-hero-info">
      <div class="pl-hero-tags">
        <span class="pl-hero-tag"><i class="bi bi-heart-fill" aria-hidden="true"></i> Propiedades guardadas</span>
      </div>
      <h1>Mis Propiedades Favoritas</h1>
      <p>Filtra, compara lado a lado y gestiona las propiedades que guardaste.</p>
    </div>
    <div class="pl-hero-acc">
      <a href="/propiedades" class="pl-hero-btn"><i class="bi bi-search" aria-hidden="true"></i> Explorar propiedades</a>
      <a href="/usuario" class="pl-hero-btn pl-hero-btn--sec"><i class="bi bi-arrow-left" aria-hidden="true"></i> Volver al inicio</a>
      <NotifModalPanel />
    </div>
  </header>

  <section class="pl-kpis" aria-label="Resumen de favoritos">
    <div class="pl-kpi pl-kpi--destacado">
      <div class="pl-kpi-top"><span class="pl-kpi-lbl">Total favoritas</span><span class="pl-kpi-ico"><i class="bi bi-heart-fill" aria-hidden="true"></i></span></div>
      <b class="pl-kpi-val" id="favStatTotal">—</b>
    </div>
    <div class="pl-kpi">
      <div class="pl-kpi-top"><span class="pl-kpi-lbl">Ciudades</span><span class="pl-kpi-ico"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i></span></div>
      <b class="pl-kpi-val" id="favStatCiudades">—</b>
    </div>
    <div class="pl-kpi pl-kpi--ok">
      <div class="pl-kpi-top"><span class="pl-kpi-lbl">Tipos de inmueble</span><span class="pl-kpi-ico"><i class="bi bi-houses-fill" aria-hidden="true"></i></span></div>
      <b class="pl-kpi-val" id="favStatTipos">—</b>
    </div>
  </section>

  <!-- Buscador y filtros -->
  <section class="pl-card fav-filtros" role="search" aria-label="Filtrar favoritos">
    <div class="fav-buscar">
      <i class="bi bi-search" aria-hidden="true"></i>
      <input type="search" id="favBuscar" placeholder="Buscar por título, ciudad o dirección…" aria-label="Buscar favoritos" />
    </div>
    <select id="favFiltroCiudad" aria-label="Filtrar por ciudad">
      <option value="">Todas las ciudades</option>
    </select>
    <select id="favFiltroTipo" aria-label="Filtrar por tipo">
      <option value="">Todos los tipos</option>
    </select>
    <select id="favFiltroPrecio" aria-label="Filtrar por precio máximo">
      <option value="">Cualquier precio</option>
      <option value="200000000">Hasta $200M</option>
      <option value="500000000">Hasta $500M</option>
      <option value="1000000000">Hasta $1.000M</option>
    </select>
    <button type="button" class="fn-btn fn-btn--sec fn-btn--mini" id="favLimpiar">Limpiar</button>
  </section>

  <!-- Barra de comparación -->
  <div class="fav-compare-bar" id="favCompareBar" hidden>
    <div class="fav-compare-info">
      <i class="bi bi-columns-gap" aria-hidden="true"></i>
      <span id="favCompareTexto">0 seleccionadas (elige 2 o 3 para comparar)</span>
    </div>
    <div class="fn-acciones">
      <button type="button" class="fn-btn fn-btn--sec fn-btn--mini" id="favCompareClear">Limpiar selección</button>
      <button type="button" class="fn-btn fn-btn--mini" id="favCompareOpen" disabled>Comparar</button>
    </div>
  </div>

  <div id="estadoCarga" class="estado-carga">
    <div class="spinner"></div>
    <span>Cargando favoritos...</span>
  </div>

  <p id="sinFavoritos" class="sin-favoritos" style="display:none;">
    Todavía no has guardado ninguna propiedad como favorita.
  </p>

  <section id="listaFavoritos" class="favoritos-grid"></section>

  <dialog class="fn-modal fav-compare-modal" id="dlgComparar" aria-labelledby="dlgCompararTitulo">
    <div class="fn-modal-cuerpo">
      <div>
        <h2 id="dlgCompararTitulo">Comparador de propiedades favoritas</h2>
        <small>Compara precio, ubicación, habitaciones y tipo lado a lado.</small>
      </div>
      <div id="compararContenido" class="fav-compare-wrap"></div>
      <div class="fn-modal-pie">
        <button type="button" class="fn-btn fn-btn--sec" id="btnCerrarComparar">Cerrar</button>
      </div>
    </div>
  </dialog>
</div>

<style is:global>
.fav-filtros {
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(145px, 1fr)) auto;
  gap: 10px;
  padding: 14px 16px;
  align-items: center;
}
.fav-buscar { position: relative; }
.fav-buscar i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #64748b; pointer-events: none; }
.fav-filtros input, .fav-filtros select {
  width: 100%; height: 40px; border: 1px solid var(--pl-linea, #d9eadf); border-radius: 10px;
  background: #f8fafc; padding: 0 12px; font: inherit; font-size: 0.88rem; color: #14532d;
}
.fav-buscar input { padding-left: 34px; }
.fav-filtros input:focus, .fav-filtros select:focus { outline: 2px solid #4ade80; background: #fff; }

.fav-compare-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  padding: 12px 16px;
  border-radius: 12px;
  background: #14532d;
  color: #f0fdf4;
  box-shadow: 0 8px 22px rgba(20, 83, 45, 0.2);
}
.fav-compare-bar[hidden] { display: none !important; }
.fav-compare-info { display: flex; align-items: center; gap: 8px; font-size: 0.88rem; font-weight: 600; }
.fav-compare-bar .fn-btn--sec { color: #f0fdf4; border-color: rgba(255,255,255,.3); }
.fav-compare-bar .fn-btn--sec:hover { background: rgba(255,255,255,.12); color: #fff; }
.fav-compare-bar .fn-btn:not(.fn-btn--sec) { background: #4ade80; border-color: #4ade80; color: #052e16; }

.favoritos-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}
.fav-card {
  background: white;
  border: 1px solid var(--pl-linea, #d9eadf);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 2px 10px rgba(20, 83, 45, 0.05);
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.2s;
  display: flex;
  flex-direction: column;
  position: relative;
}
.fav-card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(20, 83, 45, 0.11); }
.fav-card--comp { border-color: #15803d; box-shadow: 0 0 0 2px rgba(74, 222, 128, 0.45); }

.fav-image { position: relative; width: 100%; height: 220px; overflow: hidden; background: #e8f0ea; }
.fav-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
.fav-card:hover .fav-image img { transform: scale(1.05); }
.fav-image .img-placeholder {
  width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
  font-size: 3.5rem; color: #15803d; background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
}
.fav-badge {
  position: absolute; top: 12px; left: 12px; background: rgba(20, 83, 45, 0.88); color: #fff;
  font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
  padding: 4px 10px; border-radius: 99px;
}
.fav-comp-btn {
  position: absolute; top: 12px; right: 12px; border: 1px solid rgba(255,255,255,.35);
  background: rgba(255, 255, 255, 0.92); color: #14532d; border-radius: 99px;
  padding: 4px 10px; font-size: 0.74rem; font-weight: 700; cursor: pointer;
  display: inline-flex; align-items: center; gap: 5px;
}
.fav-comp-btn.is-active { background: #14532d; color: #4ade80; border-color: #4ade80; }

.fav-info { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 7px; flex: 1; }
.fav-info h4 { margin: 0; font-size: 1.05rem; color: #14532d; font-weight: 700; line-height: 1.3; }
.fav-ciudad { margin: 0; color: #15803d; font-size: 0.85rem; font-weight: 600; display: flex; align-items: center; gap: 5px; }
.fav-precio { margin: 2px 0 0; font-size: 1.18rem; font-weight: 800; color: #14532d; }
.fav-meta-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 2px; }
.fav-chip { font-size: 0.75rem; font-weight: 600; padding: 2px 8px; border-radius: 8px; background: #f0fdf4; color: #166534; }
.fav-acciones { display: flex; gap: 8px; flex-wrap: wrap; margin-top: auto; padding-top: 10px; }
.btn-quitar {
  border: 1px solid #fecaca; background: #fff; color: #dc2626; padding: 6px 12px; border-radius: 9px;
  cursor: pointer; font-weight: 600; font-size: 0.8rem; display: inline-flex; align-items: center; gap: 5px;
}
.btn-quitar:hover { background: #dc2626; color: #fff; border-color: #dc2626; }

.fav-compare-modal { width: min(860px, calc(100vw - 24px)); }
.fav-compare-wrap { overflow-x: auto; }
.fav-compare-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
.fav-compare-table th, .fav-compare-table td { padding: 10px 12px; border-bottom: 1px solid #e2e8f0; text-align: left; vertical-align: top; }
.fav-compare-table th { width: 140px; color: #64748b; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; background: #f8fafc; }
.fav-compare-img { width: 100%; max-width: 190px; aspect-ratio: 16/10; object-fit: cover; border-radius: 10px; display: block; margin-bottom: 6px; }

.estado-carga { display: flex; align-items: center; justify-content: center; gap: 12px; padding: 3rem; color: #64748b; font-size: 0.9rem; }
.spinner { width: 22px; height: 22px; border: 2.5px solid #e5e7eb; border-top-color: #15803d; border-radius: 50%; animation: spin 0.7s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.sin-favoritos { color: #64748b; text-align: center; background: white; padding: 36px 20px; border-radius: 14px; border: 1px dashed var(--pl-linea, #d9eadf); }

@media (max-width: 1050px) {
  .fav-filtros { grid-template-columns: 1fr 1fr; }
  .fav-buscar { grid-column: 1 / -1; }
  .favoritos-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 680px) {
  .fav-filtros { grid-template-columns: 1fr; }
  .favoritos-grid { grid-template-columns: 1fr; }
}
</style>

<script>
import { aviso } from "../funciones/comun";

const FAV_API = "/api/usuario/favoritos";
const BACKEND = "/backend";
function esc(v: unknown): string { return String(v ?? "").replace(/[&<>"']/g, (c) => (({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}) as Record<string, string>)[c]); }

function formatPrecio(precio: string | number): string {
  const n = Number(precio);
  if (isNaN(n)) return String(precio);
  return new Intl.NumberFormat("es-CO", { style: "currency", currency: "COP", maximumFractionDigits: 0 }).format(n);
}

function resolverImg(img: string | null | undefined): string | null {
  if (!img) return null;
  if (img.startsWith("http") || img.startsWith("data:")) return img;
  return `${BACKEND}${img.startsWith("/") ? img : "/" + img}`;
}

let favoritosActuales: any[] = [];
const seleccionados = new Set<string>();

const inputBuscar = document.getElementById("favBuscar") as HTMLInputElement;
const selCiudad = document.getElementById("favFiltroCiudad") as HTMLSelectElement;
const selTipo = document.getElementById("favFiltroTipo") as HTMLSelectElement;
const selPrecio = document.getElementById("favFiltroPrecio") as HTMLSelectElement;
const compareBar = document.getElementById("favCompareBar")!;
const compareTexto = document.getElementById("favCompareTexto")!;
const btnCompareOpen = document.getElementById("favCompareOpen") as HTMLButtonElement;
const dlgComparar = document.getElementById("dlgComparar") as HTMLDialogElement;

function poblarFiltros(lista: any[]) {
  const ciudades = [...new Set(lista.map((f) => (f.propiedad ?? f).ciudad).filter(Boolean))].sort();
  const tipos = [...new Set(lista.map((f) => { const p = f.propiedad ?? f; return p.tipo ?? p.tipoPropiedad ?? p.tipoOperacion; }).filter(Boolean))].sort();
  selCiudad.innerHTML = `<option value="">Todas las ciudades</option>` + ciudades.map((c) => `<option value="${esc(c)}">${esc(c)}</option>`).join("");
  selTipo.innerHTML = `<option value="">Todos los tipos</option>` + tipos.map((t) => `<option value="${esc(t)}">${esc(t)}</option>`).join("");
}

function actualizarStats(lista: any[]) {
  const ciudades = new Set(lista.map((f) => (f.propiedad ?? f).ciudad).filter(Boolean));
  const tipos = new Set(lista.map((f) => { const p = f.propiedad ?? f; return p.tipo ?? p.tipoPropiedad ?? p.tipoOperacion; }).filter(Boolean));
  document.getElementById("favStatTotal")!.textContent = String(lista.length);
  document.getElementById("favStatCiudades")!.textContent = String(ciudades.size);
  document.getElementById("favStatTipos")!.textContent = String(tipos.size);
}

function actualizarBarraComparar() {
  const n = seleccionados.size;
  compareBar.hidden = n === 0;
  compareTexto.textContent = n === 1
    ? "1 seleccionada · elige 1 o 2 más para comparar"
    : `${n} propiedades seleccionadas para comparar`;
  btnCompareOpen.disabled = n < 2;
  btnCompareOpen.textContent = n >= 2 ? `Comparar (${n})` : "Comparar";
}

function aplicarFiltros() {
  const q = inputBuscar.value.trim().toLowerCase();
  const ciudad = selCiudad.value;
  const tipo = selTipo.value;
  const maxPrecio = selPrecio.value ? Number(selPrecio.value) : 0;

  const filtrados = favoritosActuales.filter((f) => {
    const p = f.propiedad ?? f;
    const texto = [p.titulo, p.ciudad, p.direccion].filter(Boolean).join(" ").toLowerCase();
    if (q && !texto.includes(q)) return false;
    if (ciudad && p.ciudad !== ciudad) return false;
    const pTipo = p.tipo ?? p.tipoPropiedad ?? p.tipoOperacion ?? "";
    if (tipo && pTipo !== tipo) return false;
    if (maxPrecio && Number(p.precio ?? 0) > maxPrecio) return false;
    return true;
  });

  renderTarjetas(filtrados);
}

function renderTarjetas(lista: any[]) {
  const sinFav = document.getElementById("sinFavoritos")!;
  const contenedor = document.getElementById("listaFavoritos")!;

  if (!lista.length) {
    contenedor.innerHTML = "";
    sinFav.textContent = favoritosActuales.length
      ? "No hay propiedades favoritas que coincidan con los filtros seleccionados."
      : "Todavía no has guardado ninguna propiedad como favorita.";
    sinFav.style.display = "block";
    return;
  }
  sinFav.style.display = "none";

  contenedor.innerHTML = lista.map((f) => {
    const p = f.propiedad ?? f;
    const id = String(p.propiedadID);
    const comp = seleccionados.has(id);
    const imgSrc = resolverImg(p.imagen ?? p.imagenes?.[0] ?? p.imagenPrincipal ?? null);
    const imgHtml = imgSrc
      ? `<img src="${esc(imgSrc)}" alt="${esc(p.titulo ?? "")}" loading="lazy" />`
      : `<div class="img-placeholder"><i class="bi bi-house-door-fill" aria-hidden="true"></i></div>`;
    const tipo = p.tipo ?? p.tipoPropiedad ?? p.tipoOperacion ?? null;
    return `
      <article class="fav-card ${comp ? "fav-card--comp" : ""}">
        <div class="fav-image">
          ${imgHtml}
          ${tipo ? `<span class="fav-badge">${esc(tipo)}</span>` : ""}
          <button type="button" class="fav-comp-btn ${comp ? "is-active" : ""}" data-comp="${esc(id)}">
            <i class="bi ${comp ? "bi-check-square-fill" : "bi-columns-gap"}" aria-hidden="true"></i>
            ${comp ? "En comparador" : "Comparar"}
          </button>
        </div>
        <div class="fav-info">
          <h4>${esc(p.titulo ?? "Sin título")}</h4>
          <p class="fav-ciudad"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> ${esc(p.ciudad ?? p.direccion ?? "Sin ciudad")}</p>
          <p class="fav-precio">${esc(formatPrecio(p.precio ?? 0))}</p>
          <div class="fav-meta-chips">
            ${p.habitaciones != null ? `<span class="fav-chip"><i class="bi bi-door-open" aria-hidden="true"></i> ${Number(p.habitaciones)} hab.</span>` : ""}
            ${p.estado ? `<span class="fav-chip">${esc(p.estado)}</span>` : ""}
          </div>
          <div class="fav-acciones">
            <a class="fn-btn fn-btn--sec fn-btn--mini" href="/propiedades?query=${encodeURIComponent(p.titulo ?? "")}"><i class="bi bi-eye" aria-hidden="true"></i> Ver ficha</a>
            <button type="button" class="btn-quitar" data-prop="${esc(id)}"><i class="bi bi-x-lg" aria-hidden="true"></i> Quitar</button>
          </div>
        </div>
      </article>`;
  }).join("");
}

function abrirComparador() {
  const props = favoritosActuales
    .map((f) => f.propiedad ?? f)
    .filter((p) => seleccionados.has(String(p.propiedadID)));
  if (props.length < 2) return;

  const cols = props.map((p) => {
    const imgSrc = resolverImg(p.imagen ?? p.imagenes?.[0] ?? p.imagenPrincipal ?? null);
    return `<td>
      ${imgSrc ? `<img class="fav-compare-img" src="${esc(imgSrc)}" alt="${esc(p.titulo ?? "")}" />` : ""}
      <strong>${esc(p.titulo ?? "Sin título")}</strong>
    </td>`;
  }).join("");

  const fila = (lbl: string, fn: (p: any) => string) =>
    `<tr><th>${lbl}</th>${props.map((p) => `<td>${fn(p)}</td>`).join("")}</tr>`;

  document.getElementById("compararContenido")!.innerHTML = `
    <table class="fav-compare-table">
      <tbody>
        <tr><th>Propiedad</th>${cols}</tr>
        ${fila("Precio", (p) => `<strong>${esc(formatPrecio(p.precio ?? 0))}</strong>`)}
        ${fila("Ciudad", (p) => esc(p.ciudad ?? "—"))}
        ${fila("Dirección", (p) => esc(p.direccion ?? "—"))}
        ${fila("Habitaciones", (p) => p.habitaciones != null ? `${Number(p.habitaciones)} hab.` : "—")}
        ${fila("Tipo", (p) => esc(p.tipo ?? p.tipoPropiedad ?? p.tipoOperacion ?? "—"))}
        ${fila("Estado", (p) => esc(p.estado ?? "—"))}
        ${fila("Acción", (p) => `<a class="fn-btn fn-btn--mini" href="/usuario/agenda?propiedad=${Number(p.propiedadID)}"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Agendar visita</a>`)}
      </tbody>
    </table>`;
  dlgComparar.showModal();
}

document.getElementById("listaFavoritos")!.addEventListener("click", async (ev) => {
  const btnComp = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-comp]");
  if (btnComp?.dataset.comp) {
    const id = btnComp.dataset.comp;
    if (seleccionados.has(id)) {
      seleccionados.delete(id);
    } else {
      if (seleccionados.size >= 3) return aviso("Puedes comparar hasta 3 propiedades a la vez", "error");
      seleccionados.add(id);
    }
    actualizarBarraComparar();
    aplicarFiltros();
    return;
  }

  const btnQuitar = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-prop]");
  if (btnQuitar?.dataset.prop) {
    const propID = btnQuitar.dataset.prop;
    const res = await fetch(`${FAV_API}/${propID}`, { method: "DELETE", credentials: "same-origin" }).catch(() => null);
    if (res?.ok) {
      favoritosActuales = favoritosActuales.filter((f) => String((f.propiedad ?? f).propiedadID) !== propID);
      seleccionados.delete(propID);
      actualizarStats(favoritosActuales);
      poblarFiltros(favoritosActuales);
      actualizarBarraComparar();
      aplicarFiltros();
      aviso("Propiedad eliminada de favoritos");
    }
  }
});

[inputBuscar, selCiudad, selTipo, selPrecio].forEach((el) => el.addEventListener("input", aplicarFiltros));
document.getElementById("favLimpiar")!.addEventListener("click", () => {
  inputBuscar.value = ""; selCiudad.value = ""; selTipo.value = ""; selPrecio.value = "";
  aplicarFiltros();
});
document.getElementById("favCompareClear")!.addEventListener("click", () => {
  seleccionados.clear(); actualizarBarraComparar(); aplicarFiltros();
});
btnCompareOpen.addEventListener("click", abrirComparador);
document.getElementById("btnCerrarComparar")!.addEventListener("click", () => dlgComparar.close());

async function cargarFavoritos() {
  try {
    const res = await fetch(FAV_API, { credentials: "same-origin" });
    const data = await res.json();
    favoritosActuales = data.favoritos ?? data.data ?? [];
    actualizarStats(favoritosActuales);
    poblarFiltros(favoritosActuales);
    aplicarFiltros();
  } catch {
    favoritosActuales = [];
    actualizarStats([]);
    aplicarFiltros();
  } finally {
    document.getElementById("estadoCarga")!.style.display = "none";
  }
}

cargarFavoritos();
</script>
