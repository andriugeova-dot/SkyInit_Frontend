---
import "../funciones/funciones.css";
import "../funciones/panelUnificado.css";
import NotifModalPanel from "../funciones/NotifModalPanel.astro";
---

<div class="solicitudes-page pl-page pl-theme-usuario">
    <header class="pl-hero">
        <div class="pl-hero-info">
            <div class="pl-hero-tags">
                <span class="pl-hero-tag"><i class="bi bi-tools" aria-hidden="true"></i> Servicios y mantenimiento</span>
            </div>
            <h1>Mis Solicitudes</h1>
            <p>Solicitudes de mantenimiento e interacciones con propiedades.</p>
        </div>
        <div class="pl-hero-acc">
            <a href="/servicios" class="pl-hero-btn"><i class="bi bi-plus-circle-fill" aria-hidden="true"></i> Nueva solicitud</a>
            <a href="/usuario" class="pl-hero-btn pl-hero-btn--sec"><i class="bi bi-arrow-left" aria-hidden="true"></i> Volver al inicio</a>
            <NotifModalPanel />
        </div>
    </header>

    <section class="pl-kpis" aria-label="Resumen de solicitudes">
        <div class="pl-kpi pl-kpi--destacado">
            <div class="pl-kpi-top"><span class="pl-kpi-lbl">Total solicitudes</span><span class="pl-kpi-ico"><i class="bi bi-file-earmark-text-fill" aria-hidden="true"></i></span></div>
            <b class="pl-kpi-val" id="solStatTotal">—</b>
        </div>
        <div class="pl-kpi pl-kpi--alerta">
            <div class="pl-kpi-top"><span class="pl-kpi-lbl">Pendientes</span><span class="pl-kpi-ico"><i class="bi bi-hourglass-split" aria-hidden="true"></i></span></div>
            <b class="pl-kpi-val" id="solStatPend">—</b>
        </div>
        <div class="pl-kpi pl-kpi--prog">
            <div class="pl-kpi-top"><span class="pl-kpi-lbl">En proceso</span><span class="pl-kpi-ico"><i class="bi bi-gear-fill" aria-hidden="true"></i></span></div>
            <b class="pl-kpi-val" id="solStatProc">—</b>
        </div>
        <div class="pl-kpi pl-kpi--ok">
            <div class="pl-kpi-top"><span class="pl-kpi-lbl">Finalizadas</span><span class="pl-kpi-ico"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span></div>
            <b class="pl-kpi-val" id="solStatFin">—</b>
        </div>
    </section>

    <section class="pl-card sol-filtros" role="search" aria-label="Filtrar solicitudes">
        <div class="sol-buscar">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" id="solBuscar" placeholder="Buscar por servicio, inmobiliaria o notas…" aria-label="Buscar solicitudes" />
        </div>
        <select id="solFiltroEstado" aria-label="Filtrar por estado">
            <option value="">Todos los estados</option>
            <option value="pendiente">Pendiente</option>
            <option value="aceptada">Aceptada</option>
            <option value="proceso">En proceso</option>
            <option value="finalizada">Finalizada</option>
            <option value="cancelada">Cancelada</option>
        </select>
        <button type="button" class="fn-btn fn-btn--sec fn-btn--mini" id="solLimpiar">Limpiar</button>
    </section>

    <div id="estadoCarga" class="estado-carga">
        <div class="spinner"></div>
        <span>Cargando solicitudes...</span>
    </div>

    <div id="sinSolicitudes" class="sin-resultados" style="display:none;">
        <i class="bi bi-file-earmark-x"></i>
        <p>No tienes solicitudes registradas aún.</p>
        <a href="/servicios" class="btn-ir-servicios">
            <i class="bi bi-tools"></i> Ver servicios disponibles
        </a>
    </div>

    <div id="listaSolicitudes" class="sol-grid"></div>
</div>

<style is:global>
.solicitudes-page { display: flex; flex-direction: column; gap: 1.5rem; }
.sol-filtros {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(180px, 1fr) auto;
    gap: 10px;
    padding: 14px 16px;
    align-items: center;
}
.sol-buscar { position: relative; }
.sol-buscar i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #64748b; pointer-events: none; }
.sol-filtros input, .sol-filtros select {
    width: 100%; height: 40px; border: 1px solid var(--pl-linea, #d9eadf); border-radius: 10px;
    background: #f8fafc; padding: 0 12px; font: inherit; font-size: 0.88rem; color: #14532d;
}
.sol-buscar input { padding-left: 34px; }
.sol-filtros input:focus, .sol-filtros select:focus { outline: 2px solid #4ade80; background: #fff; }
@media (max-width: 720px) { .sol-filtros { grid-template-columns: 1fr; } }

/* Línea de tiempo de etapas */
.sol-timeline {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 4px;
    padding: 8px 0 4px;
}
.sol-step {
    display: grid;
    justify-items: center;
    gap: 4px;
    text-align: center;
    position: relative;
}
.sol-step::before {
    content: "";
    position: absolute;
    top: 9px;
    left: -50%;
    right: 50%;
    height: 2px;
    background: #e2e8f0;
    z-index: 0;
}
.sol-step:first-child::before { display: none; }
.sol-step-dot {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #e2e8f0;
    color: #94a3b8;
    font-size: 0.65rem;
    display: grid;
    place-items: center;
    position: relative;
    z-index: 1;
}
.sol-step span { font-size: 0.66rem; color: #94a3b8; font-weight: 600; line-height: 1.1; }
.sol-step--done::before { background: #15803d; }
.sol-step--done .sol-step-dot { background: #15803d; color: #fff; }
.sol-step--done span { color: #14532d; }
.sol-step--active::before { background: #4ade80; }
.sol-step--active .sol-step-dot { background: #4ade80; color: #052e16; box-shadow: 0 0 0 3px rgba(74, 222, 128, 0.35); }
.sol-step--active span { color: #14532d; font-weight: 700; }
.sol-timeline-cancel {
    display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; border-radius: 8px;
    background: #fef2f2; color: #b91c1c; font-size: 0.76rem; font-weight: 600;
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
}
.page-titulo {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1f2937;
    margin: 0 0 4px;
    display: flex;
    align-items: center;
    gap: 10px;
}
.page-titulo i { color: #f59e0b; }
.page-desc { margin: 0; font-size: 0.85rem; color: #6b7280; }

.btn-nueva-solicitud {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1a2e3b;
    color: #fff;
    text-decoration: none;
    padding: 9px 18px;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    transition: background 0.2s;
}
.btn-nueva-solicitud:hover { background: #0f4c6b; color: #fff; }

/* ── GRID 3 columnas ── */
.sol-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

/* ── TARJETA ── */
.sol-card {
    background: #fff;
    border-radius: 18px;
    border: 1.5px solid #e5e7eb;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s, transform 0.2s;
    position: relative;
}
.sol-card:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,0.09);
    transform: translateY(-4px);
}

/* Franja de color superior según estado */
.sol-card-top {
    height: 6px;
    width: 100%;
}
.sol-card-top.top-pendiente  { background: #fcd34d; }
.sol-card-top.top-en-proceso { background: #60a5fa; }
.sol-card-top.top-completado { background: #34d399; }
.sol-card-top.top-cancelado  { background: #f87171; }
.sol-card-top.top-default    { background: #d1d5db; }

.sol-card-body {
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
}

/* Cabecera con icono y estado */
.sol-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
}

.sol-icono {
    width: 100%;
    height: 160px;
    border-radius: 0;
    background: #f3f4f6;
    color: #f59e0b;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    flex-shrink: 0;
    overflow: hidden;
}
.sol-icono-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
}

.sol-estado {
    display: inline-flex;
    padding: 4px 13px;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    white-space: nowrap;
}
.estado-pendiente  { background: #fffbeb; color: #d97706; border: 1px solid #fcd34d; }
.estado-en-proceso { background: #eff6ff; color: #3b82f6; border: 1px solid #bfdbfe; }
.estado-completado { background: #ecfdf5; color: #10b981; border: 1px solid #a7f3d0; }
.estado-cancelado  { background: #fef2f2; color: #ef4444; border: 1px solid #fca5a5; }
.estado-default    { background: #f3f4f6; color: #6b7280; border: 1px solid #e5e7eb; }

/* Contenido */
.sol-servicio {
    font-size: 1rem;
    font-weight: 700;
    color: #1f2937;
    margin: 0;
    line-height: 1.35;
}

.sol-inmobiliaria {
    font-size: 0.82rem;
    color: #6b7280;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 5px;
}
.sol-inmobiliaria i { color: #9ca3af; }

.sol-notas {
    font-size: 0.8rem;
    color: #9ca3af;
    margin: 0;
    font-style: italic;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.45;
}

/* Pie */
.sol-card-footer {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid #f3f4f6;
    display: flex;
    align-items: center;
    gap: 6px;
}
.sol-fecha {
    font-size: 0.75rem;
    color: #9ca3af;
    display: flex;
    align-items: center;
    gap: 4px;
}

/* ESTADOS DE CARGA */
.estado-carga {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 3rem;
    color: #6b7280;
    font-size: 0.9rem;
}
.spinner {
    width: 22px;
    height: 22px;
    border: 2.5px solid #e5e7eb;
    border-top-color: #f59e0b;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.sin-resultados {
    text-align: center;
    padding: 3rem;
    color: #6b7280;
    background: #fff;
    border-radius: 14px;
    border: 1.5px dashed #d1d5db;
}
.sin-resultados i { font-size: 3rem; color: #fcd34d; display: block; margin-bottom: 1rem; }
.sin-resultados p { margin: 0 0 1.25rem; }
.btn-ir-servicios {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1a2e3b;
    color: #fff;
    text-decoration: none;
    padding: 9px 20px;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 500;
    transition: background 0.2s;
}
.btn-ir-servicios:hover { background: #0f4c6b; color: #fff; }

/* RESPONSIVE */
@media (max-width: 1100px) {
    .sol-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
    .sol-grid { grid-template-columns: 1fr; }
}
</style>

<script>
const SOL_API = "/api/usuario/solicitudes";
function esc(v: unknown): string { return String(v ?? "").replace(/[&<>"']/g, (c) => (({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}) as Record<string, string>)[c]); }

function formatFecha(fecha: string): string {
    if (!fecha) return "";
    return new Date(fecha).toLocaleDateString("es-CO", { day: "numeric", month: "short", year: "numeric" });
}

function estadoClass(estado: string): string {
    const e = (estado ?? "").toLowerCase();
    if (e.includes("pendiente"))   return "estado-pendiente";
    if (e.includes("proceso") || e.includes("progreso")) return "estado-en-proceso";
    if (e.includes("complet") || e.includes("finaliz"))  return "estado-completado";
    if (e.includes("cancel"))      return "estado-cancelado";
    return "estado-default";
}

function topClass(estado: string): string {
    return estadoClass(estado).replace("estado-", "top-");
}

let todasSolicitudes: any[] = [];
const solBuscar = document.getElementById("solBuscar") as HTMLInputElement;
const solFiltroEstado = document.getElementById("solFiltroEstado") as HTMLSelectElement;

function pasoActual(estado: string): number {
    const e = (estado ?? "").toLowerCase();
    if (e.includes("cancel")) return -1;
    if (e.includes("complet") || e.includes("finaliz")) return 4;
    if (e.includes("proceso") || e.includes("progreso")) return 3;
    if (e.includes("acept") && !e.includes("no")) return 2;
    return 1;
}

function renderTimeline(estado: string): string {
    const paso = pasoActual(estado);
    if (paso === -1) {
        return `<div class="sol-timeline-cancel"><i class="bi bi-x-circle-fill" aria-hidden="true"></i> Solicitud cancelada</div>`;
    }
    const etiquetas = ["Solicitada", "Aceptada", "En proceso", "Finalizada"];
    return `<div class="sol-timeline" aria-label="Progreso de la solicitud">${etiquetas.map((lbl, idx) => {
        const n = idx + 1;
        const cls = n < paso || paso === 4 ? "sol-step--done" : n === paso ? "sol-step--active" : "";
        const ico = n < paso || paso === 4 ? "bi-check-lg" : String(n);
        return `<div class="sol-step ${cls}"><div class="sol-step-dot">${ico.startsWith("bi-") ? `<i class="bi ${ico}" aria-hidden="true"></i>` : ico}</div><span>${lbl}</span></div>`;
    }).join("")}</div>`;
}

function coincideFiltroEstado(estado: string, filtro: string): boolean {
    if (!filtro) return true;
    const e = (estado ?? "").toLowerCase();
    if (filtro === "pendiente") return e.includes("pendiente") || e.includes("no acept");
    if (filtro === "aceptada") return e.includes("acept") && !e.includes("no");
    if (filtro === "proceso") return e.includes("proceso") || e.includes("progreso");
    if (filtro === "finalizada") return e.includes("complet") || e.includes("finaliz");
    if (filtro === "cancelada") return e.includes("cancel");
    return true;
}

async function cargarSolicitudes() {
    try {
        const res = await fetch(SOL_API, { credentials: "same-origin" });
        const data = await res.json();
        todasSolicitudes = data.solicitudes ?? [];
        actualizarKpisSolicitudes(todasSolicitudes);
        aplicarFiltrosSolicitudes();
    } catch {
        todasSolicitudes = [];
        actualizarKpisSolicitudes([]);
        aplicarFiltrosSolicitudes();
    } finally {
        document.getElementById("estadoCarga")!.style.display = "none";
    }
}

function actualizarKpisSolicitudes(lista: any[]) {
    const pend = lista.filter((s) => estadoClass(s.estadoReparacion ?? s.estado ?? "Pendiente") === "estado-pendiente").length;
    const proc = lista.filter((s) => estadoClass(s.estadoReparacion ?? s.estado ?? "Pendiente") === "estado-en-proceso").length;
    const fin  = lista.filter((s) => estadoClass(s.estadoReparacion ?? s.estado ?? "Pendiente") === "estado-completado").length;
    const elTotal = document.getElementById("solStatTotal");
    const elPend  = document.getElementById("solStatPend");
    const elProc  = document.getElementById("solStatProc");
    const elFin   = document.getElementById("solStatFin");
    if (elTotal) elTotal.textContent = String(lista.length);
    if (elPend)  elPend.textContent  = String(pend);
    if (elProc)  elProc.textContent  = String(proc);
    if (elFin)   elFin.textContent   = String(fin);
}

function aplicarFiltrosSolicitudes() {
    const q = solBuscar.value.trim().toLowerCase();
    const est = solFiltroEstado.value;
    const visibles = todasSolicitudes.filter((s) => {
        const estado = s.estadoReparacion ?? s.estado ?? "Pendiente";
        if (!coincideFiltroEstado(estado, est)) return false;
        if (!q) return true;
        const txt = [s.nombreServicio, s.servicio, s.inmobiliaria, s.nombreInmobiliaria, s.notas, estado].filter(Boolean).join(" ").toLowerCase();
        return txt.includes(q);
    });
    renderSolicitudes(visibles);
}

function renderSolicitudes(lista: any[]) {
    const sinEl = document.getElementById("sinSolicitudes")!;
    const contenedor = document.getElementById("listaSolicitudes")!;
    if (!lista.length) {
        contenedor.innerHTML = "";
        sinEl.style.display = "block";
        return;
    }
    sinEl.style.display = "none";
    contenedor.innerHTML = lista.map(s => {
        const estado = s.estadoReparacion ?? s.estado ?? "Pendiente";
        const fecha = formatFecha(s.fechaSolicitud ?? "");
        return `
    <div class="sol-card">
    <div class="sol-card-top ${topClass(estado)}"></div>
    <div class="sol-icono">
        ${s.imagenServicio
            ? `<img src="${esc(s.imagenServicio)}" alt="${esc(s.nombreServicio ?? '')}" class="sol-icono-img" />`
            : `<i class="bi bi-tools"></i>`
        }
    </div>
    <div class="sol-card-body">
        <div class="sol-card-head">
            <span class="sol-estado ${estadoClass(estado)}">${esc(estado)}</span>
        </div>
        <p class="sol-servicio">${esc(s.nombreServicio ?? s.servicio ?? "Servicio de mantenimiento")}</p>
        <p class="sol-inmobiliaria">
            <i class="bi bi-building"></i>
            ${esc(s.inmobiliaria ?? s.nombreInmobiliaria ?? "Inmobiliaria")}
        </p>
        ${renderTimeline(estado)}
        ${s.notas ? `<p class="sol-notas">"${esc(s.notas)}"</p>` : ""}
        ${fecha ? `
        <div class="sol-card-footer">
            <span class="sol-fecha">
                <i class="bi bi-calendar3" aria-hidden="true"></i>
                ${esc(fecha)}
            </span>
        </div>` : ""}
    </div>
</div>`
    }).join("");
}

solBuscar.addEventListener("input", aplicarFiltrosSolicitudes);
solFiltroEstado.addEventListener("change", aplicarFiltrosSolicitudes);
document.getElementById("solLimpiar")!.addEventListener("click", () => {
    solBuscar.value = ""; solFiltroEstado.value = ""; aplicarFiltrosSolicitudes();
});

cargarSolicitudes();
</script>