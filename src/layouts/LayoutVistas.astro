---
import "bootstrap/dist/css/bootstrap.min.css";
import "bootstrap-icons/font/bootstrap-icons.min.css";
import SideBar from "../components/SideBar.astro";
import BusquedaRapidaPanel from "../components/funciones/BusquedaRapidaPanel.astro";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>SkyInit — Panel</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
	</head>
	<body>
		<a class="tr-skip-link" href="#panelMain">Saltar al contenido principal</a>
		<SideBar />
			<main class="panel-main" id="panelMain">
				<slot />
			</main>
		<BusquedaRapidaPanel />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	.tr-skip-link {
		position: fixed;
		top: -64px;
		left: 16px;
		z-index: 2000;
		padding: 8px 16px;
		border-radius: 8px;
		background: #0e1726;
		color: #f8fcfb;
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
	}

	.tr-skip-link:focus-visible {
		top: 16px;
		outline: 2px solid #0f766e;
		outline-offset: 2px;
	}

    .panel-main {
    margin-left: 250px;
    min-height: 100vh;
    padding: 1.75rem 2rem;
    box-sizing: border-box;
    background: #F8F6F0;
    }

    @media (max-width: 768px) {
        .panel-main {
        margin-left: 75px; /* sidebar colapsado en tu CSS */
        padding: 1rem;
        }
    }
</style>
