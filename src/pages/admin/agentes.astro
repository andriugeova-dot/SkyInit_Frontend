---
import Layout from "../../layouts/LayoutVistas.astro";
import "../../components/funciones/funciones.css";
---
<Layout>
  <section class="fn">
    <div class="fn-head">
      <div><h1>Agentes</h1><p>Cuentas de agente de tu inmobiliaria. Solo tú las puedes crear, editar o desactivar.</p></div>
      <button class="fn-btn" id="btnNuevoAgente" type="button"><i class="bi bi-person-plus" aria-hidden="true"></i> Nuevo agente</button>
    </div>
    <div class="fn-stats" id="agtStats"></div>
    <div id="agtLista"></div>
  </section>
  <dialog class="fn-modal" id="dlgAgente">
    <form class="fn-modal-cuerpo fn-form" id="formAgente" autocomplete="off">
      <h2 id="agtTitulo">Nuevo agente</h2>
      <label>Nombre completo <input id="agtNombre" maxlength="100" required /></label>
      <div class="fn-fila">
        <label>Correo <input type="email" id="agtCorreo" maxlength="100" required /></label>
        <label>Teléfono de contacto <input id="agtTelefono" maxlength="20" /></label>
      </div>
      <label><span id="agtPassLabel">Contraseña</span>
        <input type="password" id="agtPassword" autocomplete="new-password" />
        <small class="fn-muted" style="font-weight:400">Mínimo 8 caracteres, con mayúscula, minúscula, número y símbolo.</small>
      </label>
      <div class="fn-modal-pie">
        <button class="fn-btn fn-btn--sec" type="button" id="btnCerrarAgente">Cancelar</button>
        <button class="fn-btn" type="submit">Guardar</button>
      </div>
    </form>
  </dialog>
</Layout>

<script>
  import { api, esc, aviso, fechaCorta } from "../../components/funciones/comun";
  const lista = document.getElementById("agtLista")!;
  const dlg = document.getElementById("dlgAgente") as HTMLDialogElement;
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  let agentes: any[] = [];
  let editando: any = null;

  async function cargar() {
    try {
      agentes = (await api("/admin/agentes")).agentes;
      const activos = agentes.filter((a) => a.estadoCuenta === "Activa").length;
      document.getElementById("agtStats")!.innerHTML = `
        <div class="fn-stat"><b>${agentes.length}</b><span>Agentes</span></div>
        <div class="fn-stat"><b>${activos}</b><span>Activos</span></div>
        <div class="fn-stat"><b>${agentes.reduce((n, a) => n + a.propiedades, 0)}</b><span>Propiedades asignadas</span></div>
        <div class="fn-stat"><b>${agentes.reduce((n, a) => n + a.citasPendientes, 0)}</b><span>Citas por confirmar</span></div>`;
      if (!agentes.length) { lista.innerHTML = `<div class="fn-vacio"><i class="bi bi-people" aria-hidden="true"></i>Tu inmobiliaria aún no tiene agentes. Crea el primero con “Nuevo agente”.</div>`; return; }
      lista.innerHTML = `<div class="fn-tabla-wrap"><table class="fn-tabla"><thead><tr><th>Nombre</th><th>Correo</th><th>Teléfono</th><th>Propiedades</th><th>Alta</th><th>Estado</th><th></th></tr></thead><tbody>` +
        agentes.map((a) => {
          const activa = a.estadoCuenta === "Activa", id = Number(a.usuarioID);
          return `<tr><td><strong>${esc(a.nombre)}</strong></td><td>${esc(a.correo)}</td><td>${esc(a.telefono ?? "—")}</td><td>${Number(a.propiedades)}</td>
            <td>${esc(fechaCorta(a.fechaRegistro))}</td><td><span class="fn-chip ${activa ? "fn-chip--ok" : "fn-chip--mal"}">${esc(a.estadoCuenta)}</span></td>
            <td><div class="fn-acciones">
              <button class="fn-btn fn-btn--sec fn-btn--mini" data-editar="${id}" type="button"><i class="bi bi-pencil" aria-hidden="true"></i> Editar</button>
              <button class="fn-btn ${activa ? "fn-btn--mal" : "fn-btn--sec"} fn-btn--mini" data-estado="${activa ? "Inactiva" : "Activa"}" data-id="${id}" type="button">
                <i class="bi ${activa ? "bi-person-slash" : "bi-person-check"}" aria-hidden="true"></i> ${activa ? "Desactivar" : "Activar"}</button></div></td></tr>`;
        }).join("") + "</tbody></table></div>";
    } catch (e) { lista.innerHTML = `<div class="fn-vacio">${esc((e as Error).message)}</div>`; }
  }
  function abrir(a: any | null) {
    editando = a;
    (document.getElementById("formAgente") as HTMLFormElement).reset();
    document.getElementById("agtTitulo")!.textContent = a ? "Editar agente" : "Nuevo agente";
    document.getElementById("agtPassLabel")!.textContent = a ? "Nueva contraseña (déjala vacía para no cambiarla)" : "Contraseña";
    $("agtPassword").required = !a;
    if (a) { $("agtNombre").value = a.nombre; $("agtCorreo").value = a.correo; $("agtTelefono").value = a.telefono ?? ""; }
    dlg.showModal();
  }
  lista.addEventListener("click", async (ev) => {
    const t = ev.target as HTMLElement;
    const ed = t.closest<HTMLElement>("[data-editar]");
    if (ed) return abrir(agentes.find((a) => Number(a.usuarioID) === Number(ed.dataset.editar)));
    const es = t.closest<HTMLElement>("[data-estado]");
    if (es) {
      try { const r = await api(`/admin/agentes/${es.dataset.id}/estado`, "PATCH", { estadoCuenta: es.dataset.estado }); aviso(r.mensaje); cargar(); }
      catch (e) { aviso((e as Error).message, "error"); }
    }
  });
  document.getElementById("btnNuevoAgente")!.addEventListener("click", () => abrir(null));
  document.getElementById("btnCerrarAgente")!.addEventListener("click", () => dlg.close());
  document.getElementById("formAgente")!.addEventListener("submit", async (ev) => {
    ev.preventDefault();
    const cuerpo: any = { nombre: $("agtNombre").value.trim(), correo: $("agtCorreo").value.trim(), telefono: $("agtTelefono").value.trim() || null };
    if ($("agtPassword").value) cuerpo.password = $("agtPassword").value;
    try {
      const r = editando ? await api(`/admin/agentes/${editando.usuarioID}`, "PUT", cuerpo) : await api("/admin/agentes", "POST", cuerpo);
      dlg.close(); aviso(r.mensaje); cargar();
    } catch (e) { aviso((e as Error).message, "error"); }
  });
  cargar();
</script>
