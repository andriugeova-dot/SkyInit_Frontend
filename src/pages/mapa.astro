---
import Navbar from "../components/menu/Navbar.astro";
import FooterMenu from "../components/menu/FooterMenu.astro";
import "bootstrap/dist/css/bootstrap.min.css";
import "bootstrap-icons/font/bootstrap-icons.min.css";
import "../components/menu/menu.css";
import "../components/funciones/funciones.css";
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mapa | SkyInit</title>
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <Navbar soloNav />
    <main class="fn fn-publica" id="mapaRoot" data-editar="0">
      <div class="fn-head">
        <div>
          <h1>Mapa de propiedades y proyectos</h1>
          <p id="mapaResumen">Cargando ubicaciones…</p>
        </div>
        <div class="fn-acciones">
          <button class="fn-btn" id="btnCerca" type="button"><i class="bi bi-crosshair" aria-hidden="true"></i> Cerca de mí</button>
        </div>
      </div>
      <div class="mapa-layout">
        <div id="mapa" role="application" aria-label="Mapa"></div>
        <aside class="mapa-lista" id="mapaLista" aria-live="polite"></aside>
      </div>
    </main>
    <FooterMenu />
  </body>
</html>

<style is:global>
  body { margin:0; background:#F8F6F0; }
  .mapa-layout { display:grid; grid-template-columns:minmax(0,1fr) 320px; gap:16px; }
  #mapa { height:560px; border-radius:12px; border:1px solid #e2ddd0; z-index:0; }
  .mapa-lista { max-height:560px; overflow:auto; display:grid; gap:8px; align-content:start; }
  .mapa-item { background:#fff; border:1px solid #e2ddd0; border-radius:10px; padding:10px 12px; text-align:left; cursor:pointer; font:inherit; color:inherit; display:grid; gap:2px; width:100%; }
  .mapa-item:hover, .mapa-item--activo { border-color:#c8ad72; background:#fffdf6; }
  .mapa-item small { color:#6b7268; }
  .mapa-pin { width:26px; height:26px; border-radius:50% 50% 50% 0; transform:rotate(-45deg); border:2px solid #fff; box-shadow:0 2px 6px rgba(0,0,0,.4); }
  .mapa-pin--propiedad { background:#2f5d46; } .mapa-pin--proyecto { background:#c8ad72; } .mapa-pin--yo { background:#1f5fa8; border-radius:50%; }
  @media (max-width:900px){ .mapa-layout { grid-template-columns:1fr; } #mapa { height:420px; } .mapa-lista { max-height:none; } }
</style>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";
  import { api, esc, aviso } from "../components/funciones/comun";

  type Punto = { tipo: "propiedad" | "proyecto"; id: number; titulo: string; detalle: string; latitud: number | null; longitud: number | null; distancia?: number };
  const editar = document.getElementById("mapaRoot")!.dataset.editar === "1";
  const lista = document.getElementById("mapaLista")!;
  const resumen = document.getElementById("mapaResumen")!;
  const DUITAMA: [number, number] = [5.8268, -73.0331];

  const mapa = L.map("mapa").setView(DUITAMA, 13);
  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19, attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
  }).addTo(mapa);
  const icono = (clase: string) => L.divIcon({ className: "", html: `<div class="mapa-pin mapa-pin--${clase}"></div>`, iconSize: [26, 26], iconAnchor: [13, 26], popupAnchor: [0, -24] });
  const marcadores = new Map<string, L.Marker>();
  let puntos: Punto[] = [];
  let seleccionado: Punto | null = null;
  const clave = (p: Punto) => `${p.tipo}-${p.id}`;
  const pesos = (v: unknown) => new Intl.NumberFormat("es-CO", { style: "currency", currency: "COP", maximumFractionDigits: 0 }).format(Number(v) || 0);

  function normalizar(d: any): Punto[] {
    return [
      ...d.propiedades.map((p: any) => ({ tipo: "propiedad" as const, id: p.id, titulo: p.titulo,
        detalle: [p.direccion, p.ciudad].filter(Boolean).join(", ") + (p.precio ? ` · ${pesos(p.precio)}` : ""), latitud: p.latitud, longitud: p.longitud })),
      ...d.proyectos.map((p: any) => ({ tipo: "proyecto" as const, id: p.id, titulo: p.titulo,
        detalle: (p.ubicacion ?? p.direccion ?? "Proyecto") + (p.avance != null ? ` · ${Number(p.avance).toFixed(0)} % de avance` : ""), latitud: p.latitud, longitud: p.longitud })),
    ];
  }

  function pintarMarcador(p: Punto) {
    marcadores.get(clave(p))?.remove();
    if (p.latitud == null || p.longitud == null) return;
    const m = L.marker([p.latitud, p.longitud], { icon: icono(p.tipo) }).addTo(mapa)
      .bindPopup(`<strong>${esc(p.titulo)}</strong><br>${esc(p.detalle)}<br><a href="#" data-detalle="${p.tipo}:${Number(p.id)}">Ver detalle</a>`);
    marcadores.set(clave(p), m);
  }

  function pintarLista() {
    if (!puntos.length) {
      lista.innerHTML = `<div class="fn-vacio"><i class="bi bi-geo-alt"></i>${editar ? "No tienes propiedades ni proyectos para ubicar." : "Aún no hay propiedades ni proyectos con ubicación."}</div>`;
      return;
    }
    lista.innerHTML = puntos.map((p) => `
      <button class="mapa-item ${seleccionado && clave(seleccionado) === clave(p) ? "mapa-item--activo" : ""}" data-clave="${clave(p)}" type="button">
        <strong>${esc(p.titulo)}</strong>
        <small>${p.tipo === "proyecto" ? "Proyecto" : "Propiedad"} · ${esc(p.detalle)}</small>
        ${p.distancia != null ? `<small><i class="bi bi-signpost"></i> a ${p.distancia < 1 ? Math.round(p.distancia * 1000) + " m" : p.distancia.toFixed(1) + " km"}</small>` : ""}
        ${editar ? `<span class="fn-chip ${p.latitud != null ? "fn-chip--ok" : "fn-chip--pend"}">${p.latitud != null ? "Con ubicación" : "Sin ubicación"}</span>` : ""}
      </button>`).join("");
  }

  lista.addEventListener("click", (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLElement>("[data-clave]");
    if (!b) return;
    seleccionado = puntos.find((p) => clave(p) === b.dataset.clave) ?? null;
    pintarLista();
    if (seleccionado?.latitud != null) { mapa.setView([seleccionado.latitud, seleccionado.longitud!], 16); marcadores.get(clave(seleccionado))?.openPopup(); }
    else if (editar) aviso("Ahora haz clic en el mapa para ubicar “" + seleccionado!.titulo + "”");
  });

  if (editar) {
    mapa.on("click", async (ev: L.LeafletMouseEvent) => {
      if (!seleccionado) return aviso("Primero elige un elemento de la lista", "error");
      const p = seleccionado;
      try {
        await api(`/geo/${p.tipo === "propiedad" ? "propiedades" : "proyectos"}/${p.id}`, "PUT", { latitud: ev.latlng.lat, longitud: ev.latlng.lng });
        p.latitud = ev.latlng.lat; p.longitud = ev.latlng.lng;
        pintarMarcador(p); pintarLista(); aviso("Ubicación guardada");
      } catch (e) { aviso((e as Error).message, "error"); }
    });
  } else {
    // Geolocalizacion del navegador: ordena por cercania
    const km = (a: [number, number], b: [number, number]) => {
      const R = 6371, r = (g: number) => (g * Math.PI) / 180;
      const dLat = r(b[0] - a[0]), dLng = r(b[1] - a[1]);
      const h = Math.sin(dLat / 2) ** 2 + Math.cos(r(a[0])) * Math.cos(r(b[0])) * Math.sin(dLng / 2) ** 2;
      return 2 * R * Math.asin(Math.sqrt(h));
    };
    document.getElementById("btnCerca")?.addEventListener("click", () => {
      if (!navigator.geolocation) return aviso("Tu navegador no permite obtener la ubicación", "error");
      navigator.geolocation.getCurrentPosition((pos) => {
        const yo: [number, number] = [pos.coords.latitude, pos.coords.longitude];
        L.marker(yo, { icon: icono("yo") }).addTo(mapa).bindPopup("Estás aquí").openPopup();
        puntos.forEach((p) => { p.distancia = km(yo, [p.latitud!, p.longitud!]); });
        puntos.sort((a, b) => a.distancia! - b.distancia!);
        pintarLista();
        const cercanos = puntos.slice(0, 5).map((p) => [p.latitud!, p.longitud!] as [number, number]);
        mapa.fitBounds(L.latLngBounds([yo, ...cercanos]).pad(0.2));
        resumen.textContent = puntos.length ? `Ordenado por cercanía. El más cercano: ${puntos[0].titulo}.` : "No hay ubicaciones para comparar.";
      }, () => aviso("No pudimos obtener tu ubicación. Revisa el permiso del navegador.", "error"), { enableHighAccuracy: true, timeout: 10000 });
    });
  }

  (async () => {
    try {
      puntos = normalizar(await api(editar ? "/geo/editables" : "/geo/puntos"));
      puntos.forEach(pintarMarcador);
      pintarLista();
      const conCoord = puntos.filter((p) => p.latitud != null);
      if (conCoord.length) mapa.fitBounds(L.latLngBounds(conCoord.map((p) => [p.latitud!, p.longitud!] as [number, number])).pad(0.25), { maxZoom: 15 });
      if (!editar) resumen.textContent = `${conCoord.length} ubicaciones en el mapa. Verde: propiedades. Dorado: proyectos.`;
      else resumen.textContent = `${conCoord.length} de ${puntos.length} con ubicación. Elige un elemento y haz clic en el mapa para fijarla o moverla.`;
    } catch (e) { resumen.textContent = (e as Error).message; }
  })();
</script>
