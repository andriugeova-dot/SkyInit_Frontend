---
import Layout from "../../layouts/LayoutVistas.astro";
import CalendarioMantenimiento from "../../components/funciones/CalendarioMantenimiento.astro";
import NotifModalTrabajador from "../../components/trabajador/NotifModalTrabajador.astro";
import "../../components/trabajador/trabajador.css";
---
<Layout>
  <div class="tr-page">
    <header class="tr-hero">
      <div class="tr-hero-info">
        <span class="tr-page-date">Agenda de mantenimiento</span>
        <h1>Agenda de citas</h1>
        <p>Consulta tus citas programadas por semana, fecha y hora.</p>
      </div>
      <div class="tr-hero-acc">
        <a class="tr-btn" href="/trabajador"><i class="bi bi-arrow-left" aria-hidden="true"></i> Volver a hoy</a>
        <NotifModalTrabajador />
      </div>
    </header>
    <CalendarioMantenimiento mostrarCabecera={false} />
  </div>
</Layout>
