---
import Layout from "../../layouts/LayoutVistas.astro";
import CalendarioMantenimiento from "../../components/funciones/CalendarioMantenimiento.astro";
import "../../components/trabajador/trabajador.css";
---
<Layout>
  <div class="tr-page">
    <header class="tr-hero">
      <div class="tr-hero-info">
        <div class="tr-hero-tags">
          <span class="tr-hero-tag"><i class="bi bi-calendar3" aria-hidden="true"></i> Agenda de mantenimiento</span>
        </div>
        <h1>Calendario de citas</h1>
        <p>Consulta todas tus citas de mantenimiento programadas por fecha y hora.</p>
      </div>
      <div class="tr-hero-acc">
        <a class="tr-hero-btn tr-hero-btn--sec" href="/trabajador"><i class="bi bi-arrow-left" aria-hidden="true"></i> Volver al panel</a>
      </div>
    </header>
    <CalendarioMantenimiento mostrarCabecera={false} />
  </div>
</Layout>
