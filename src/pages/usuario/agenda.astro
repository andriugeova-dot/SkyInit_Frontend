---
import Layout from "../../layouts/LayoutVistas.astro";
import Agenda from "../../components/funciones/Agenda.astro";
import DetalleModal from "../../components/funciones/DetalleModal.astro";
import NotifModalPanel from "../../components/funciones/NotifModalPanel.astro";
import "../../components/funciones/funciones.css";
import "../../components/funciones/panelUnificado.css";
---
<Layout>
  <div class="pl-page pl-theme-usuario">
    <header class="pl-hero">
      <div class="pl-hero-info">
        <div class="pl-hero-tags">
          <span class="pl-hero-tag"><i class="bi bi-calendar-check-fill" aria-hidden="true"></i> Agenda de visitas</span>
        </div>
        <h1>Mis visitas</h1>
        <p>Agenda una visita a una propiedad y sigue su estado.</p>
      </div>
      <div class="pl-hero-acc">
        <button class="pl-hero-btn" id="btnNuevaVisita" type="button"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Agendar visita</button>
        <a class="pl-hero-btn pl-hero-btn--sec" href="/usuario"><i class="bi bi-arrow-left" aria-hidden="true"></i> Volver al inicio</a>
        <NotifModalPanel />
      </div>
    </header>

    <Agenda modo="usuario" mostrarCabecera={false} />
    <DetalleModal />
  </div>
</Layout>
